---
/*
  FOOTER COMPONENT.

  Black background, matching the nav bar (PM request, 2026-08-19) —
  was the site's warm off-white paper color before. Link columns are
  deliberately curated rather than a full mirror of the nav (PM
  choice) — a shorter, easier-to-scan set rather than every nav item
  repeated. Bigger link type than before, also per PM request.
*/
const year = new Date().getFullYear();

import Logo from "./Logo.astro";
import footer from "../content/settings/footer.json";

// Footer link columns (2026-08-20): now fully CMS-editable —
// titles, links, and the order of both columns and the links inside
// them — via the "columns" field in footer.json, rather than the
// hardcoded array that used to live here. Falls back to an empty
// array if the field is ever missing, so an out-of-date footer.json
// (e.g. mid-handoff, before this field exists) just shows no columns
// instead of crashing the build.
const columns = (footer as any).columns || [];

const address = (footer as any).address || "";
const privacyLabel = (footer as any).privacy_link_label || "";
const privacyUrl = (footer as any).privacy_link_url || "";
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-logo-wrap">
        <Logo size="nav" />
      </div>
      {address && <p class="footer-address">{address}</p>}
      {privacyLabel && privacyUrl && (
        <p class="footer-privacy">
          <a href={privacyUrl} target="_blank" rel="noopener">{privacyLabel}</a>
        </p>
      )}
    </div>

    <div class="footer-cols">
      {columns.map((col: any) => (
        <div class="footer-col">
          <h4>{col.title}</h4>
          <ul>
            {(col.links || []).map((link: any) => (
              <li><a href={link.url} {...((link as any).external ? { target: "_blank", rel: "noopener" } : {})}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} Peninsula Youth Theatre &middot; {footer.copyright_extra}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    background: var(--nav-bg-dark);
    border-top: none;
    padding-top: var(--space-xl);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .footer-logo-wrap {
    margin-bottom: 0.8rem;
  }

  .footer-address {
    font-size: 0.95rem;
    color: var(--nav-text-muted);
    max-width: 34ch;
    line-height: 1.5;
    /* Preserves real line breaks typed into the CMS's address field
       (a multi-line "text" widget) — by default HTML collapses
       newlines to a single space, which is why editing the field
       alone never visibly moved anything before this fix. */
    white-space: pre-line;
  }

  .footer-privacy {
    margin-top: 0.5rem;
    font-size: 0.95rem;
  }

  .footer-privacy a {
    color: var(--accent);
    text-decoration: underline;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .footer-col h4 {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nav-text-muted);
    margin-bottom: 0.9rem;
  }

  .footer-col ul {
    list-style: none;
  }

  .footer-col li {
    margin-bottom: 0.65rem;
  }

  .footer-col a {
    font-size: 1.05rem;
    color: var(--nav-text);
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    margin-top: var(--space-lg);
    padding-block: var(--space-md);
    border-top: 1px solid rgba(245, 243, 239, 0.15);
  }

  .footer-bottom p {
    font-size: 0.88rem;
    color: var(--nav-text-muted);
  }

  @media (min-width: 720px) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
    }
    .footer-cols {
      grid-template-columns: repeat(3, auto);
      gap: var(--space-2xl);
    }
  }
</style>
