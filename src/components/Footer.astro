---
/*
  FOOTER COMPONENT.

  Black background, matching the nav bar (PM request, 2026-08-19) —
  was the site's warm off-white paper color before. Link columns are
  deliberately curated rather than a full mirror of the nav (PM
  choice) — a shorter, easier-to-scan set rather than every nav item
  repeated. Bigger link type than before, also per PM request.
*/
const year = new Date().getFullYear();

import Logo from "./Logo.astro";
import footer from "../content/settings/footer.json";

// Footer link columns (2026-08-20): now fully CMS-editable —
// titles, links, and the order of both columns and the links inside
// them — via the "columns" field in footer.json, rather than the
// hardcoded array that used to live here. Falls back to an empty
// array if the field is ever missing, so an out-of-date footer.json
// (e.g. mid-handoff, before this field exists) just shows no columns
// instead of crashing the build.
const columns = (footer as any).columns || [];

// Social links (2026-08-20). Icons only, footer only — the PM tried them
// on the contact page too and preferred them not to appear there.
// Each is optional: blank one and only the other shows; blank both and
// the whole row disappears rather than leaving an empty gap.
const instagramUrl = ((footer as any).instagram_url || "").trim();
const facebookUrl = ((footer as any).facebook_url || "").trim();
const hasSocial = Boolean(instagramUrl || facebookUrl);

const address = (footer as any).address || "";
const privacyLabel = (footer as any).privacy_link_label || "";
const privacyUrl = (footer as any).privacy_link_url || "";
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-logo-wrap">
        <Logo size="nav" />
      </div>
      {address && <p class="footer-address">{address}</p>}
      {privacyLabel && privacyUrl && (
        <p class="footer-privacy">
          <a href={privacyUrl} target="_blank" rel="noopener">{privacyLabel}</a>
        </p>
      )}

      {hasSocial && (
        <ul class="footer-social">
          {instagramUrl && (
            <li>
              <a href={instagramUrl} target="_blank" rel="noopener" class="footer-social-link">
                {/* aria-label, not visible text: the icons are unlabelled
                    shapes, so without this a screen reader announces only
                    "link". aria-hidden on the SVG stops it being read twice. */}
                <span class="sr-only">Peninsula Youth Theatre on Instagram</span>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="22" height="22">
                  <path fill="currentColor" d="M12 2c2.72 0 3.06.01 4.12.06 1.07.05 1.79.22 2.43.46.66.26 1.22.6 1.77 1.16.56.55.9 1.11 1.16 1.77.25.64.41 1.36.46 2.43.05 1.07.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.07-.22 1.79-.46 2.43a4.9 4.9 0 0 1-1.16 1.77c-.55.56-1.11.9-1.77 1.16-.64.25-1.36.41-2.43.46-1.07.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.07-.05-1.79-.22-2.43-.46a4.9 4.9 0 0 1-1.77-1.16 4.9 4.9 0 0 1-1.16-1.77c-.25-.64-.41-1.36-.46-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.07.22-1.79.46-2.43.26-.66.6-1.22 1.16-1.77.55-.56 1.11-.9 1.77-1.16.64-.25 1.36-.41 2.43-.46C8.94 2.01 9.28 2 12 2Zm0 1.8c-2.67 0-2.99.01-4.04.06-.98.04-1.5.2-1.86.34-.47.18-.8.4-1.15.75-.35.35-.57.68-.75 1.15-.14.36-.3.88-.34 1.86-.05 1.05-.06 1.37-.06 4.04s.01 2.99.06 4.04c.4.98.2 1.5.34 1.86.18.47.4.8.75 1.15.35.35.68.57 1.15.75.36.14.88.3 1.86.34 1.05.05 1.37.06 4.04.06s2.99-.01 4.04-.06c.98-.04 1.5-.2 1.86-.34.47-.18.8-.4 1.15-.75.35-.35.57-.68.75-1.15.14-.36.3-.88.34-1.86.05-1.05.06-1.37.06-4.04s-.01-2.99-.06-4.04c-.04-.98-.2-1.5-.34-1.86a3.1 3.1 0 0 0-.75-1.15 3.1 3.1 0 0 0-1.15-.75c-.36-.14-.88-.3-1.86-.34-1.05-.05-1.37-.06-4.04-.06Zm0 3.06a5.14 5.14 0 1 1 0 10.28 5.14 5.14 0 0 1 0-10.28Zm0 1.8a3.34 3.34 0 1 0 0 6.68 3.34 3.34 0 0 0 0-6.68Zm5.34-3.2a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z"/>
                </svg>
              </a>
            </li>
          )}
          {facebookUrl && (
            <li>
              <a href={facebookUrl} target="_blank" rel="noopener" class="footer-social-link">
                <span class="sr-only">Peninsula Youth Theatre on Facebook</span>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="22" height="22">
                  <path fill="currentColor" d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.77-3.89 1.1 0 2.24.19 2.24.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12Z"/>
                </svg>
              </a>
            </li>
          )}
        </ul>
      )}
    </div>

    <div class="footer-cols">
      {columns.map((col: any) => (
        <div class="footer-col">
          <h4>{col.title}</h4>
          <ul>
            {(col.links || []).map((link: any) => (
              <li><a href={link.url} {...((link as any).external ? { target: "_blank", rel: "noopener" } : {})}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} Peninsula Youth Theatre &middot; {footer.copyright_extra}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    background: var(--nav-bg-dark);
    border-top: none;
    padding-top: var(--space-xl);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .footer-logo-wrap {
    margin-bottom: 0.8rem;
  }

  .footer-address {
    font-size: 0.95rem;
    color: var(--nav-text-muted);
    max-width: 34ch;
    line-height: 1.5;
    /* Preserves real line breaks typed into the CMS's address field
       (a multi-line "text" widget) — by default HTML collapses
       newlines to a single space, which is why editing the field
       alone never visibly moved anything before this fix. */
    white-space: pre-line;
  }

  .footer-privacy {
    margin-top: 0.5rem;
    font-size: 0.95rem;
  }

  .footer-privacy a {
    color: var(--accent);
    text-decoration: underline;
  }

  /* ---- Social icons (2026-08-20) ---- */
  .footer-social {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    display: flex;
    gap: 0.9rem;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Comfortably past the 44px minimum tap target, since these are
       small shapes sitting close together on a phone. */
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--nav-text);
    transition: color 0.18s ease, background 0.18s ease;
  }

  .footer-social-link:hover,
  .footer-social-link:focus-visible {
    color: var(--accent);
    background: rgba(255, 255, 255, 0.08);
  }

  /* The icons are the only content, so the negative margin pulls the
     row back into line with the text above it rather than looking
     indented by the tap-target padding. */
  .footer-social {
    margin-left: -11px;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .footer-col h4 {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nav-text-muted);
    margin-bottom: 0.9rem;
  }

  .footer-col ul {
    list-style: none;
  }

  .footer-col li {
    margin-bottom: 0.65rem;
  }

  .footer-col a {
    font-size: 1.05rem;
    color: var(--nav-text);
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    margin-top: var(--space-lg);
    padding-block: var(--space-md);
    border-top: 1px solid rgba(245, 243, 239, 0.15);
  }

  .footer-bottom p {
    font-size: 0.88rem;
    color: var(--nav-text-muted);
  }

  @media (min-width: 720px) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
    }
    .footer-cols {
      grid-template-columns: repeat(3, auto);
      gap: var(--space-2xl);
    }
  }
</style>
