---
/*
  FOOTER COMPONENT.

  Black background, matching the nav bar (PM request, 2026-08-19) —
  was the site's warm off-white paper color before. Link columns are
  deliberately curated rather than a full mirror of the nav (PM
  choice) — a shorter, easier-to-scan set rather than every nav item
  repeated. Bigger link type than before, also per PM request.
*/
const year = new Date().getFullYear();

import Logo from "./Logo.astro";
import footer from "../content/settings/footer.json";

const columns = [
  {
    title: "Explore",
    links: [
      { label: "Shows", href: "/shows" },
      { label: "Classes & Camps", href: "/programs" },
      { label: "Shop", href: "/shop" },
    ],
  },
  {
    title: "Community",
    links: [
      { label: "Rentals", href: "/rentals" },
      { label: "Newsletter signup", href: "/subscribe" },
    ],
  },
  {
    title: "About",
    links: [
      { label: "About PYT", href: "/about" },
      { label: "Support PYT", href: "/ways-to-support" },
      { label: "Contact", href: "/about#contact" },
    ],
  },
];

const address = (footer as any).address || "";
const privacyLabel = (footer as any).privacy_link_label || "";
const privacyUrl = (footer as any).privacy_link_url || "";
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-logo-wrap">
        <Logo size="nav" />
      </div>
      {(address || (privacyLabel && privacyUrl)) && (
        <p class="footer-address">
          {address}{address && (privacyLabel && privacyUrl) && " "}
          {privacyLabel && privacyUrl && (
            <a href={privacyUrl} target="_blank" rel="noopener">{privacyLabel}</a>
          )}
        </p>
      )}
    </div>

    <div class="footer-cols">
      {columns.map((col) => (
        <div class="footer-col">
          <h4>{col.title}</h4>
          <ul>
            {col.links.map((link) => (
              <li><a href={link.href} {...((link as any).external ? { target: "_blank", rel: "noopener" } : {})}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} Peninsula Youth Theatre &middot; {footer.copyright_extra}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    background: var(--nav-bg-dark);
    border-top: none;
    padding-top: var(--space-xl);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .footer-logo-wrap {
    margin-bottom: 0.8rem;
  }

  .footer-address {
    font-size: 0.95rem;
    color: var(--nav-text-muted);
    max-width: 34ch;
    line-height: 1.5;
  }

  .footer-address a {
    color: var(--accent);
    text-decoration: underline;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .footer-col h4 {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nav-text-muted);
    margin-bottom: 0.9rem;
  }

  .footer-col ul {
    list-style: none;
  }

  .footer-col li {
    margin-bottom: 0.65rem;
  }

  .footer-col a {
    font-size: 1.05rem;
    color: var(--nav-text);
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    margin-top: var(--space-lg);
    padding-block: var(--space-md);
    border-top: 1px solid rgba(245, 243, 239, 0.15);
  }

  .footer-bottom p {
    font-size: 0.88rem;
    color: var(--nav-text-muted);
  }

  @media (min-width: 720px) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
    }
    .footer-cols {
      grid-template-columns: repeat(3, auto);
      gap: var(--space-2xl);
    }
  }
</style>
