---
/*
  FOOTER COMPONENT.

  Black background, matching the nav bar (PM request, 2026-08-19) —
  was the site's warm off-white paper color before. Link columns are
  deliberately curated rather than a full mirror of the nav (PM
  choice) — a shorter, easier-to-scan set rather than every nav item
  repeated. Bigger link type than before, also per PM request.
*/
const year = new Date().getFullYear();

import Logo from "./Logo.astro";
import footer from "../content/settings/footer.json";
// Site address, used by the EN/ES translate toggle below to build the
// link back to the untranslated site. Same CMS field the header used
// when the toggle lived up there (Site Settings -> Navigation Labels).
import navLabels from "../content/settings/nav-labels.json";

// Footer link columns (2026-08-20): now fully CMS-editable —
// titles, links, and the order of both columns and the links inside
// them — via the "columns" field in footer.json, rather than the
// hardcoded array that used to live here. Falls back to an empty
// array if the field is ever missing, so an out-of-date footer.json
// (e.g. mid-handoff, before this field exists) just shows no columns
// instead of crashing the build.
const columns = (footer as any).columns || [];

// Social links (2026-08-20). Icons only, footer only — the PM tried them
// on the contact page too and preferred them not to appear there.
// Each is optional: blank one and only the other shows; blank both and
// the whole row disappears rather than leaving an empty gap.
const instagramUrl = ((footer as any).instagram_url || "").trim();
const facebookUrl = ((footer as any).facebook_url || "").trim();
const hasSocial = Boolean(instagramUrl || facebookUrl);

const address = (footer as any).address || "";
const privacyLabel = (footer as any).privacy_link_label || "";
const privacyUrl = (footer as any).privacy_link_url || "";
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-logo-wrap">
        <Logo size="nav" />
      </div>
      {address && <p class="footer-address">{address}</p>}
      {privacyLabel && privacyUrl && (
        <p class="footer-privacy">
          <a href={privacyUrl} target="_blank" rel="noopener">{privacyLabel}</a>
        </p>
      )}

      {hasSocial && (
        <ul class="footer-social">
          {instagramUrl && (
            <li>
              <a href={instagramUrl} target="_blank" rel="noopener" class="footer-social-link">
                {/* aria-label, not visible text: the icons are unlabelled
                    shapes, so without this a screen reader announces only
                    "link". aria-hidden on the SVG stops it being read twice. */}
                <span class="sr-only">Peninsula Youth Theatre on Instagram</span>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="22" height="22">
                  <path fill="currentColor" d="M12 2c2.72 0 3.06.01 4.12.06 1.07.05 1.79.22 2.43.46.66.26 1.22.6 1.77 1.16.56.55.9 1.11 1.16 1.77.25.64.41 1.36.46 2.43.05 1.07.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.07-.22 1.79-.46 2.43a4.9 4.9 0 0 1-1.16 1.77c-.55.56-1.11.9-1.77 1.16-.64.25-1.36.41-2.43.46-1.07.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.07-.05-1.79-.22-2.43-.46a4.9 4.9 0 0 1-1.77-1.16 4.9 4.9 0 0 1-1.16-1.77c-.25-.64-.41-1.36-.46-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.07.22-1.79.46-2.43.26-.66.6-1.22 1.16-1.77.55-.56 1.11-.9 1.77-1.16.64-.25 1.36-.41 2.43-.46C8.94 2.01 9.28 2 12 2Zm0 1.8c-2.67 0-2.99.01-4.04.06-.98.04-1.5.2-1.86.34-.47.18-.8.4-1.15.75-.35.35-.57.68-.75 1.15-.14.36-.3.88-.34 1.86-.05 1.05-.06 1.37-.06 4.04s.01 2.99.06 4.04c.4.98.2 1.5.34 1.86.18.47.4.8.75 1.15.35.35.68.57 1.15.75.36.14.88.3 1.86.34 1.05.05 1.37.06 4.04.06s2.99-.01 4.04-.06c.98-.04 1.5-.2 1.86-.34.47-.18.8-.4 1.15-.75.35-.35.57-.68.75-1.15.14-.36.3-.88.34-1.86.05-1.05.06-1.37.06-4.04s-.01-2.99-.06-4.04c-.04-.98-.2-1.5-.34-1.86a3.1 3.1 0 0 0-.75-1.15 3.1 3.1 0 0 0-1.15-.75c-.36-.14-.88-.3-1.86-.34-1.05-.05-1.37-.06-4.04-.06Zm0 3.06a5.14 5.14 0 1 1 0 10.28 5.14 5.14 0 0 1 0-10.28Zm0 1.8a3.34 3.34 0 1 0 0 6.68 3.34 3.34 0 0 0 0-6.68Zm5.34-3.2a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z"/>
                </svg>
              </a>
            </li>
          )}
          {facebookUrl && (
            <li>
              <a href={facebookUrl} target="_blank" rel="noopener" class="footer-social-link">
                <span class="sr-only">Peninsula Youth Theatre on Facebook</span>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="22" height="22">
                  <path fill="currentColor" d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.77-3.89 1.1 0 2.24.19 2.24.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12Z"/>
                </svg>
              </a>
            </li>
          )}
        </ul>
      )}
    </div>

    <div class="footer-cols">
      {columns.map((col: any) => (
        <div class="footer-col">
          <h4>{col.title}</h4>
          <ul>
            {(col.links || []).map((link: any) => (
              <li><a href={link.url} {...((link as any).external ? { target: "_blank", rel: "noopener" } : {})}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- EN/ES translate toggle. MOVED HERE from the nav bar on
       2026-08-23: it was the only item in that bar that wasn't
       navigation or a call to action, and the row had stopped fitting
       on one line. The PM asked for it to be prominent here rather
       than tucked away, hence its own full-width band with a label
       and a proper-sized button, above the copyright line — not a
       small link lost among the footer columns.

       Not a real bilingual site (that's a much bigger project — see
       BUILD_LOG.md); this routes the CURRENT page through Google's
       free translate.goog proxy, which needs no sign-up and no script
       embed. The label and behaviour swap client-side depending on
       whether the visitor is already on the translated version. -->
  <div class="lang-band">
    <div class="container lang-band-inner">
      <p class="lang-band-text" id="lang-band-text">Read this site in Spanish</p>
      <a
        href="#"
        id="lang-toggle"
        class="lang-btn"
        data-site-origin={(navLabels as any).site_origin || "https://pyt-website.pages.dev"}
        aria-label="Translate this site"
      >Español</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} Peninsula Youth Theatre &middot; {footer.copyright_extra}</p>
  </div>
</footer>

<style>
  /* ---- EN/ES language band (2026-08-23) ---- */
  /* Given its own full-width band, a label, and a real button so it
     reads as an offer rather than as fine print — the toggle used to
     sit in the nav bar and must not become less findable by moving.
     Sits directly above the copyright line, so it's the last thing
     before the very bottom of every page. */
  .lang-band {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    margin-top: var(--space-lg);
    padding-block: var(--space-md);
  }

  .lang-band-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    text-align: center;
  }

  .lang-band-text {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--nav-text);
  }

  /* Deliberately NOT .btn: this needs to read clearly on the dark
     footer, and the shared button styles are tuned for light
     backgrounds. Sized like a real button rather than the small
     40px-wide "ES" pill it was in the nav. */
  .lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.5rem;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--nav-bg-dark);
    background: var(--nav-text);
    border-radius: var(--radius-btn);
    border: 1.5px solid var(--nav-text);
    transition: background 0.16s ease, color 0.16s ease;
  }

  .lang-btn:hover,
  .lang-btn:focus-visible {
    background: transparent;
    color: var(--nav-text);
  }

  .site-footer {
    margin-top: var(--space-2xl);
    background: var(--nav-bg-dark);
    border-top: none;
    padding-top: var(--space-xl);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .footer-logo-wrap {
    margin-bottom: 0.8rem;
  }

  .footer-address {
    font-size: 0.95rem;
    color: var(--nav-text-muted);
    max-width: 34ch;
    line-height: 1.5;
    /* Preserves real line breaks typed into the CMS's address field
       (a multi-line "text" widget) — by default HTML collapses
       newlines to a single space, which is why editing the field
       alone never visibly moved anything before this fix. */
    white-space: pre-line;
  }

  .footer-privacy {
    margin-top: 0.5rem;
    font-size: 0.95rem;
  }

  .footer-privacy a {
    color: var(--accent);
    text-decoration: underline;
  }

  /* ---- Social icons (2026-08-20) ---- */
  .footer-social {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    display: flex;
    gap: 0.9rem;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Comfortably past the 44px minimum tap target, since these are
       small shapes sitting close together on a phone. */
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--nav-text);
    transition: color 0.18s ease, background 0.18s ease;
  }

  .footer-social-link:hover,
  .footer-social-link:focus-visible {
    color: var(--accent);
    background: rgba(255, 255, 255, 0.08);
  }

  /* The icons are the only content, so the negative margin pulls the
     row back into line with the text above it rather than looking
     indented by the tap-target padding. */
  .footer-social {
    margin-left: -11px;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .footer-col h4 {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nav-text-muted);
    margin-bottom: 0.9rem;
  }

  .footer-col ul {
    list-style: none;
  }

  .footer-col li {
    margin-bottom: 0.65rem;
  }

  .footer-col a {
    font-size: 1.05rem;
    color: var(--nav-text);
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    margin-top: var(--space-lg);
    padding-block: var(--space-md);
    border-top: 1px solid rgba(245, 243, 239, 0.15);
  }

  .footer-bottom p {
    font-size: 0.88rem;
    color: var(--nav-text-muted);
  }

  @media (min-width: 720px) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
    }
    .footer-cols {
      grid-template-columns: repeat(3, auto);
      gap: var(--space-2xl);
    }
  }
</style>

<script>
  // EN/ES translate toggle. Routes the current page through Google's
  // free translate.goog domain-proxy (no sign-up, no script embed
  // needed) — e.g. example.com/shows becomes
  // example-com.translate.goog/shows with a couple of query params
  // telling Google which languages to use. If the visitor is ALREADY
  // on the translated version, the button instead links back to the
  // real site, built from the "site address" set in the CMS (Site
  // Settings → Navigation Labels) rather than trying to reverse the
  // proxy's URL — reversing it is ambiguous whenever the real domain
  // itself contains a dash (true of the current pyt-website.pages.dev
  // address), so a known, CMS-set origin is used instead.
  // Encode a real hostname into its translate.goog form.
  //
  // BUG FIX 2026-08-20 — this is why the ES button did nothing.
  // Google's scheme is NOT simply "dots become dashes". Any dash that
  // is already IN the hostname has to be DOUBLED first, otherwise
  // Google decodes it back as a dot and fetches a different site.
  // Our domain contains a dash, so it was hit by exactly this:
  //
  //   pyt-website.pages.dev
  //     old code -> pyt-website-pages-dev.translate.goog
  //                 which Google reads back as pyt.website.pages.dev
  //                 — a site that doesn't exist, so nothing translated
  //     correct  -> pyt--website-pages-dev.translate.goog
  //                 which Google reads back as pyt-website.pages.dev
  //
  // Order matters: double the dashes BEFORE turning dots into dashes,
  // or the new dashes get doubled too. Verified against the test table
  // in Google's own docs (search "ad-network-and-translation"):
  //   example.com     -> example-com
  //   foo.example.com -> foo-example-com
  //   foo-example.com -> foo--example-com
  const toTranslateHost = (hostname: string) =>
    hostname.replace(/-/g, "--").replace(/\./g, "-") + ".translate.goog";

  const langBtn = document.getElementById("lang-toggle") as HTMLAnchorElement | null;
  if (langBtn) {
    const onTranslatedPage = window.location.hostname.endsWith(".translate.goog");
    // Full words, not the old two-letter "ES"/"EN" codes: in the nav
    // bar the button had to be tiny, but in the footer band it has
    // room to say what it actually does (2026-08-23).
    const bandText = document.getElementById("lang-band-text");
    if (onTranslatedPage) {
      langBtn.textContent = "English";
      if (bandText) bandText.textContent = "Ver este sitio en ingl\u00e9s";
      langBtn.setAttribute("aria-label", "View this site in English");
      const origin = langBtn.dataset.siteOrigin || "";
      langBtn.href = origin + window.location.pathname + window.location.hash;
    } else {
      langBtn.textContent = "Espa\u00f1ol";
      if (bandText) bandText.textContent = "Read this site in Spanish";
      langBtn.setAttribute("aria-label", "Ver este sitio en espa\u00f1ol");
      // Build the real href up front rather than only on click, so the
      // button behaves like a normal link — right-click, middle-click,
      // open-in-new-tab and "copy link" all work, and it still does
      // something if the click handler never runs.
      const sep = window.location.search ? "&" : "?";
      langBtn.href =
        `https://${toTranslateHost(window.location.hostname)}` +
        `${window.location.pathname}${window.location.search}${sep}` +
        `_x_tr_sl=en&_x_tr_tl=es&_x_tr_hl=en${window.location.hash}`;
    }
  }
</script>
