---
/*
  PAGE HERO IMAGE — the optional wide photo near the top of a page.

  WHY THIS IS A LOOKUP RATHER THAN A PER-PAGE FIELD:
  Every page's hero image lives in ONE CMS record (Site Settings →
  Page Hero Images), as a list of "which page / which photo" rows.
  This component matches the current URL against that list.

  The alternative — a hero_image field on each page's own settings
  record — would have meant editing ~20 page files and adding ~20
  separate CMS fields (and creating settings records from scratch for
  Shop and Subscribe, which don't have one at all). One list keeps it
  to a single place to edit, in the CMS and in the code.

  EMPTY BY DESIGN: if a page has no row, or its row has no photo, this
  renders NOTHING AT ALL — no empty box, no gap. A page without a hero
  image looks exactly as it does today.

  SIZING: a wide letterbox strip, 21:6 at every screen size. It used to
  open out to 24:5 on wider screens, but that crop was severe enough to
  cause real problems — a 24:5 frame keeps only ~31% of a typical
  landscape photo's height, which sliced faces in half. 21:6 keeps
  noticeably more of each photo while still reading as a banner, and
  it's now consistent across screen sizes rather than changing shape at
  720px (which meant a photo could look right on a phone and wrong on a
  laptop).

  FOCUS: each row can set which part of the photo to keep when it's
  cropped (see ../lib/imageFocus.ts). Defaults to the middle, which is
  exactly how this behaved before the field existed.
*/
import heroes from "../content/settings/page-heroes.json";
import { objectPosition } from "../lib/imageFocus";

// Normalize so "/about", "/about/" and "" all compare equal — Astro can
// emit either form depending on the trailing-slash config, and a staff
// member typing a path into the CMS may or may not include one.
function normalizePath(p: string): string {
  const trimmed = (p || "").trim().toLowerCase();
  const noTrailing = trimmed.replace(/\/+$/, "");
  return noTrailing === "" ? "/" : noTrailing;
}

const currentPath = normalizePath(Astro.url.pathname);

const rows = ((heroes as any).items || []).filter(
  (r: any) => r?.page?.trim() && r?.image?.trim()
);

// EXACT MATCH ONLY (changed 2026-08-21).
//
// This used to fall back to a parent section: a row for /stories-on-stage
// also gave a hero to /stories-on-stage/creepy-carrots and every other
// production page. That sounded convenient but was wrong in practice —
// those pages already open with the production's own poster and details,
// so a second wide banner above it looked bad, and there was no way to
// switch it off for the children without also losing it on the section
// page the PM did want it on.
//
// Now a page gets a hero only if it has its own row. To give one
// individual production page a hero, add a row for its exact address.
const match = rows.find((r: any) => normalizePath(r.page) === currentPath);
const image = match?.image?.trim() || "";
// Alt text is optional. Left blank the image is treated as decorative,
// which is the correct accessibility behaviour for a mood/banner photo
// that doesn't convey information the page text doesn't already give.
const alt = match?.alt?.trim() || "";
// Which part of the photo survives the crop. Defaults to the middle.
const focus = objectPosition(match?.focus);
---

{image && (
  <section class="page-hero-image">
    <div class="container">
      <img
        src={image}
        alt={alt}
        class="page-hero-img"
        loading="lazy"
        decoding="async"
        style={`object-position: ${focus};`}
      />
    </div>
  </section>
)}

<style>
  .page-hero-image {
    margin-bottom: var(--space-lg);
  }

  .page-hero-img {
    width: 100%;
    /* One shape at every width (2026-08-20). The previous 24:5 desktop
       variant cropped away ~69% of a landscape photo's height, which is
       what cut the face off the Auditions hero. object-position is set
       inline per-photo from the CMS focus field. */
    aspect-ratio: 21 / 6;
    object-fit: cover;
    border-radius: var(--radius);
    display: block;
    box-shadow: var(--shadow-soft);
  }
</style>
