---
/*
  PAGE HERO — reusable top-of-page block.

  Pattern: small eyebrow text, big heading, optional lede paragraph,
  then an optional wide hero photo. Used by Shows, Programs, Donate,
  About, Casting, etc., so they all open with a consistent rhythm.

  The hero photo isn't a prop — PageHeroImage looks it up by URL from
  a single CMS record (see that component). That's what lets every
  page gain an optional hero image without editing every page file.
*/
import PageHeroImage from "./PageHeroImage.astro";

interface Props {
  title: string;
  /** Plain-text intro. Use this unless the intro needs a link. */
  lede?: string;
  /**
   * Pre-rendered HTML intro, for pages whose intro is a CMS "markdown"
   * field and can therefore contain links (2026-08-20). Pass the output
   * of renderMarkdown(). Takes precedence over `lede` when both are set.
   *
   * Kept as a SEPARATE prop rather than making `lede` accept HTML,
   * because ~18 pages pass plain strings to `lede` and rendering those
   * as HTML would stop characters like & and < being escaped properly.
   */
  ledeHtml?: string;
}

const { title, lede, ledeHtml } = Astro.props;
const hasHtmlLede = Boolean(ledeHtml && ledeHtml.trim());
---

<section class="page-hero">
  <div class="container">
    <h1>{title}</h1>
    {hasHtmlLede ? (
      <div class="page-hero-lede page-hero-lede-rich" set:html={ledeHtml} />
    ) : (
      lede && <p class="page-hero-lede">{lede}</p>
    )}
    {/* Optional button row (2026-08-22), used by the Sponsorship /
        Scholarships links. Deliberately INSIDE this container and
        ABOVE <PageHeroImage />, so the buttons sit directly under the
        heading on every page whether or not that page has a hero
        photo. Placing them after <PageHero /> in the page instead
        would drop them below the photo on the pages that have one and
        under the heading on the pages that don't — inconsistent.
        Renders nothing at all when no page passes slot="actions". */}
    <slot name="actions" />
  </div>
</section>

<PageHeroImage />

<style>
  .page-hero {
    padding-block: var(--space-xl) var(--space-lg);
  }
  .page-hero h1 {
    margin-block: 0.6rem 0;
  }
  .page-hero-lede {
    font-size: 1.08rem;
    max-width: 58ch;
    margin-top: var(--space-md);
  }

  /* The rich version is a <div> of rendered Markdown, so its paragraphs
     need the spacing a bare <p> got for free. */
  .page-hero-lede-rich :global(p) {
    margin: 0;
  }

  .page-hero-lede-rich :global(p + p) {
    margin-top: 0.7rem;
  }

  /* Links inside the intro: pink and underlined, so they read as links
     rather than as emphasised text. :global() is required because this
     HTML is injected with set:html and therefore doesn't carry Astro's
     scoping attributes. */
  .page-hero-lede-rich :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .page-hero-lede-rich :global(a:hover) {
    color: var(--accent-deep);
  }
  @media (min-width: 720px) {
    .page-hero {
      padding-block: var(--space-2xl) var(--space-lg);
    }
  }
</style>
