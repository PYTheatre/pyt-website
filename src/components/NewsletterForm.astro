---
/*
  NEWSLETTER SIGNUP FORM (component)

  Extracted from src/pages/subscribe.astro on 2026-09-23 so the same
  MailChimp form can appear on BOTH /subscribe and the new /contact page
  without two copies to keep in step. Everything MailChimp-specific —
  the form action, field names, the honeypot, the validation scripts —
  is unchanged from the original page. See the notes below.

  Embeds PYT's MailChimp form natively — styled with site tokens,
  not MailChimp's default purple branding.

  Form fields (from the MailChimp embed code):
  - Email (required)
  - First Name
  - Last Name
  - 7 interest-group checkboxes (group ID 222749)

  Phone number was intentionally omitted per client decision.

  MailChimp's validation and success/error messaging is handled
  by their mc-validate.js script (loaded at the bottom via is:inline
  script — it loads only on pages that render this component).

  jQuery is loaded slimly here because mc-validate.js depends on it.
  It is ONLY loaded where this form appears — not on every page — to
  keep the rest of the site jQuery-free.

  IMPORTANT: Do not touch the form `action` URL, field `name`
  attributes, or the hidden honeypot input — these are tied to
  PYT's real MailChimp audience and will break signup if changed.

  Render ONCE per page: the form's ids (mc-embedded-subscribe-form,
  mce-EMAIL, …) are what MailChimp's script looks for.

  Props:
    flush — true removes the card's own border/background/padding so the
            form can sit inside another box (the Contact page's card).
*/
import settings from "../content/settings/newsletter-form.json";

interface Props {
  flush?: boolean;
}
const { flush = false } = Astro.props;

/* CMS-EDITABLE WORDING (2026-09-23, PM request). The MailChimp wiring
   stays in code; the words around it come from
   Settings → Site-wide → Newsletter Signup Form:
   - the interests heading + hint, the button text, the note under it;
   - each checkbox's LABEL, and whether it's SHOWN.
   Each checkbox is matched to its MailChimp group by a fixed KEY (below),
   never by its label, so relabelling can't break the audience mapping.
   A checkbox whose key isn't listed here (or has no MailChimp group) is
   not rendered. Adding a NEW topic = new group in MailChimp → new id
   here → new row in the CMS list; that's the one thing staff can't do
   alone. */
const GROUP_IDS: Record<string, string> = {
  auditions: "group[222749][1]",
  classes: "group[222749][2]",
  performances: "group[222749][4]",
  field_trips: "group[222749][8]",
  alumni: "group[222749][16]",
  giving: "group[222749][32]",
  schools: "group[222749][64]",
};
const sx = settings as any;
const interests = ((sx.interests || []) as any[])
  .filter((i) => i && GROUP_IDS[i.key] && i.show !== false && String(i.label || "").trim())
  .map((i) => ({ name: GROUP_IDS[i.key], label: String(i.label).trim() }));
const interestsHeading = sx.interests_heading?.trim() || "What do you want to hear about?";
const interestsHint = sx.interests_hint?.trim() || "";
const submitLabel = sx.submit_label?.trim() || "Subscribe";
const submitNote = sx.submit_note?.trim() || "";
---

<div class={`form-card ${flush ? "form-card--flush" : ""}`}>

  <form
    action="https://pytnet.us18.list-manage.com/subscribe/post?u=a27714c10f41c3197b314b73e&amp;id=af5873e6cb&amp;f_id=001eade6f0"
    method="post"
    id="mc-embedded-subscribe-form"
    name="mc-embedded-subscribe-form"
    class="validate"
    target="_blank"
    novalidate
  >
    <div id="mc_embed_signup_scroll">

      {/* ---- Contact fields ---- */}
      <div class="field-group required">
        <label for="mce-EMAIL">Email address <span class="required-mark" aria-label="required">*</span></label>
        <input
          type="email"
          name="EMAIL"
          class="required email"
          id="mce-EMAIL"
          autocomplete="email"
          required
        />
      </div>

      <div class="field-row">
        <div class="field-group">
          <label for="mce-FNAME">First name</label>
          <input
            type="text"
            name="FNAME"
            id="mce-FNAME"
            autocomplete="given-name"
          />
        </div>
        <div class="field-group">
          <label for="mce-LNAME">Last name</label>
          <input
            type="text"
            name="LNAME"
            id="mce-LNAME"
            autocomplete="family-name"
          />
        </div>
      </div>

      {/* ---- Interest checkboxes (labels/visibility from the CMS; group
             names from GROUP_IDS above) ---- */}
      {interests.length > 0 && (
        <fieldset class="interests-group">
          <legend>{interestsHeading}</legend>
          {interestsHint && <p class="interests-hint">{interestsHint}</p>}

          <ul class="interests-list">
            {interests.map((i) => (
              <li>
                <label class="checkbox-label">
                  <input type="checkbox" name={i.name} value="" />
                  <span>{i.label}</span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
      )}

      {/* ---- MailChimp response containers (shown/hidden by mc-validate.js) ---- */}
      <div id="mce-responses" class="mce-responses">
        <div class="response" id="mce-error-response" style="display:none"></div>
        <div class="response" id="mce-success-response" style="display:none"></div>
      </div>

      {/* ---- Anti-bot honeypot (do not remove) ---- */}
      <div aria-hidden="true" style="position:absolute;left:-5000px;">
        <input type="text" name="b_a27714c10f41c3197b314b73e_af5873e6cb" tabindex="-1" value="" />
      </div>

      <div class="submit-row">
        <button type="submit" name="subscribe" id="mc-embedded-subscribe" class="btn btn-primary">
          {submitLabel}
        </button>
        {submitNote && <p class="submit-note">{submitNote}</p>}
      </div>

    </div>
  </form>

</div>

{/* ---- MailChimp validation scripts (scoped to this page only) ---- */}
{/* jQuery is required by mc-validate.js */}
<script is:inline src="//ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script is:inline src="//s3.amazonaws.com/downloads.mailchimp.com/js/mc-validate.js"></script>
<script is:inline>
  (function($) {
    window.fnames = new Array();
    window.ftypes = new Array();
    fnames[0] = 'EMAIL'; ftypes[0] = 'email';
    fnames[1] = 'FNAME'; ftypes[1] = 'text';
    fnames[2] = 'LNAME'; ftypes[2] = 'text';
  }(jQuery));
  var $mcj = jQuery.noConflict(true);
</script>


<style>
  /* ---- Form card wrapper ---- */
  /* Left-aligned under the title and intro (2026-09-21) — was centred. */
  .form-card {
    max-width: 600px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-lg);
    box-shadow: var(--shadow-soft);
  }

  /* ---- Text inputs ---- */
  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: var(--space-md);
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
  }

  .required-mark {
    color: var(--accent);
    margin-left: 0.15em;
  }

  input[type="email"],
  input[type="text"] {
    width: 100%;
    padding: 0.65rem 0.9rem;
    border: 1.5px solid var(--line);
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink);
    background: var(--paper);
    transition: border-color 0.15s ease;
    -webkit-appearance: none;
    appearance: none;
  }

  input[type="email"]:focus,
  input[type="text"]:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  /* ---- Interests fieldset ---- */
  fieldset.interests-group {
    border: none;
    padding: 0;
    margin: 0 0 var(--space-md);
  }

  fieldset.interests-group legend {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.35rem;
  }

  .interests-hint {
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-bottom: var(--space-sm);
  }

  .interests-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--ink-soft);
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    transition: background 0.12s ease;
  }

  .checkbox-label:hover {
    background: var(--accent-soft);
    color: var(--ink);
  }

  .checkbox-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--line);
    border-radius: 4px;
    accent-color: var(--accent);
    flex-shrink: 0;
    cursor: pointer;
  }

  /* ---- Submit row ---- */
  .submit-row {
    margin-top: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .submit-note {
    font-size: 0.82rem;
    color: var(--ink-muted);
  }

  /* ---- MailChimp success/error messages ---- */
  .mce-responses {
    margin-bottom: var(--space-sm);
  }

  .response {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.92rem;
  }

  #mce-error-response {
    background: #fff0f3;
    color: #c43d6f;
    border: 1px solid #f5c6d3;
  }

  #mce-success-response {
    background: #f0faf4;
    color: #1a7a3f;
    border: 1px solid #a8d9b8;
  }

  /* ---- Responsive: stack field-row on narrow phones ---- */
  @media (max-width: 480px) {
    .field-row {
      grid-template-columns: 1fr;
    }

    .form-card {
      padding: var(--space-md);
    }
  }

  @media (min-width: 600px) {
    .interests-list {
      grid-template-columns: 1fr 1fr;
    }

    .submit-row {
      flex-direction: row;
      align-items: center;
    }
  }
  /* Inside another card (Contact page): no chrome of its own. */
  .form-card--flush {
    max-width: none;
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
  }
</style>
