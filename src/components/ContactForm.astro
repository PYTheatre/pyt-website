---
/*
  CONTACT FORM — the site-wide replacement for published email addresses.

  WHY THIS EXISTS (2026-08-20):
  Email addresses used to be printed on the page as mailto: links, which
  exposes staff inboxes to scrapers and spam. Every one of those has been
  replaced with this form.

  ROUTING — the important part:
  Different enquiries used to reach different people. A Formspree
  endpoint delivers to whoever owns it, so a single shared endpoint
  would have silently funnelled school bookings and corporate giving
  into the wrong inbox. Instead each form names a ROUTE, and the routes
  map to separate Formspree endpoints in the CMS
  (Site Settings → Contact Form Endpoints):

    general      — was info@pytnet.org
    education    — was caitlyn@ / school bookings
    development  — was lhatten@ / sponsorship & corporate giving

  Adding a route means adding it in one place (contact-forms.json plus
  its CMS field), not editing every page.

  IF AN ENDPOINT ISN'T SET YET:
  The form is replaced by a short, plain note. It deliberately does NOT
  fall back to showing an email address — that would reintroduce exactly
  what this component removes. The note tells the visitor how else to
  reach PYT without publishing an inbox.
*/
import endpoints from "../content/settings/contact-forms.json";

interface Props {
  /** Which inbox this form should reach. */
  route?: "general" | "education" | "development";
  /** Prefills the Subject box, e.g. a show name. Visitors can edit it. */
  subject?: string;
  /** Appears in PYT's inbox so staff can tell which page it came from. */
  source?: string;
  /** Optional short line above the form. */
  intro?: string;
  submitLabel?: string;
}

const {
  route = "general",
  subject = "",
  source = "",
  intro = "",
  submitLabel = "Send message",
} = Astro.props;

const endpoint = ((endpoints as any)[route] || (endpoints as any).general || "").trim();
const fallbackNote = ((endpoints as any).unavailable_note || "").trim() ||
  "Our contact form is being set up. Please try again shortly, or reach us by phone during office hours.";

// IDs must be unique: several pages could render more than one of these,
// and duplicate ids would break the label/input pairing for screen
// readers and make clicking a label focus the wrong box.
const uid = Math.random().toString(36).slice(2, 8);
---

<div class="contact-form-card">
  {intro && <p class="contact-form-intro">{intro}</p>}

  {endpoint ? (
    <form action={endpoint} method="POST" class="contact-form">
      <div class="field-group">
        <label for={`cf-name-${uid}`}>Your name <span class="required-mark" aria-label="required">*</span></label>
        <input type="text" name="name" id={`cf-name-${uid}`} autocomplete="name" required />
      </div>

      <div class="field-group">
        <label for={`cf-email-${uid}`}>Email address <span class="required-mark" aria-label="required">*</span></label>
        <input type="email" name="email" id={`cf-email-${uid}`} autocomplete="email" required />
      </div>

      <div class="field-group">
        <label for={`cf-org-${uid}`}>Organization (optional)</label>
        <input type="text" name="organization" id={`cf-org-${uid}`} autocomplete="organization" />
      </div>

      {/* Subject sits ABOVE the message (PM request 2026-08-20): the two
          swapped places compared with the rentals form they were modelled on. */}
      <div class="field-group">
        <label for={`cf-subject-${uid}`}>Subject <span class="required-mark" aria-label="required">*</span></label>
        <input type="text" name="subject" id={`cf-subject-${uid}`} value={subject} required
          placeholder="What is your message about?" />
      </div>

      <div class="field-group">
        <label for={`cf-message-${uid}`}>Your message <span class="required-mark" aria-label="required">*</span></label>
        <textarea name="message" id={`cf-message-${uid}`} rows="5" required
          placeholder="How can we help?"></textarea>
      </div>

      {/* Tells staff which page the enquiry came from, since several
          pages share one inbox. */}
      {source && <input type="hidden" name="sent_from" value={source} />}

      {/* Honeypot: hidden from real users, filled in by bots, which
          Formspree then discards. */}
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off"
        style="position:absolute;left:-5000px;" aria-hidden="true" />

      <div class="submit-row">
        <button type="submit" class="btn btn-primary">{submitLabel}</button>
        <p class="submit-note">We typically reply within a few business days.</p>
      </div>
    </form>
  ) : (
    <p class="contact-form-unavailable">{fallbackNote}</p>
  )}
</div>

<style>
  .contact-form-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-lg);
    box-shadow: var(--shadow-soft);
    max-width: 640px;
  }

  .contact-form-intro {
    margin: 0 0 var(--space-md);
    color: var(--ink-soft);
  }

  .field-group {
    margin-bottom: var(--space-md);
  }

  .field-group label {
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 600;
    color: var(--ink);
  }

  .required-mark {
    color: var(--accent);
  }

  .field-group input,
  .field-group textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-btn);
    font: inherit;
    color: var(--ink);
    background: var(--paper);
  }

  .field-group input:focus,
  .field-group textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  .field-group textarea {
    resize: vertical;
  }

  .submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
  }

  .submit-note {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .contact-form-unavailable {
    margin: 0;
    color: var(--ink-soft);
  }
</style>
