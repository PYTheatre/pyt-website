---
/*
  HEADER COMPONENT — sticky top bar.
 
  Contains: logo, main navigation (grouped), a Donate button,
  and a hamburger menu for phones.
 
  NAVIGATION STRUCTURE:
  The top bar has a small number of top-level items. Some are
  plain links; some are "parents" that hold a few related links
  in a dropdown. Parents are themselves clickable (they go to a
  sensible landing page) AND reveal their children on hover or
  keyboard focus — so a parent is never a dead label.
 
  Edit `navGroups` below to change the menu. Each entry is either:
    { label, href }                         → a plain top-level link
    { label, href, children: [ {label,href} ] } → a parent with a dropdown
 
  MOBILE-FIRST: on phones everything collapses into the hamburger
  menu, which lists each group as a labelled section with its
  items beneath (no hover needed — all tappable). On wide screens
  the grouped bar shows and the hamburger disappears.
 
  The EN/ES language toggle will be added in the Spanish
  phase (Phase 4). It's intentionally left out for now.
*/
import Logo from "./Logo.astro";
import navLabels from "../content/settings/nav-labels.json";
import navMenu from "../content/settings/nav-menu.json";
import { getCollection } from "astro:content";

// On the homepage, the logo has moved down into the hero (next to the
// new playful headline treatment) instead of sitting in the nav bar.
// Every other page keeps the small logo in the nav as before.
const isHomepage = Astro.url.pathname === "/";

// --- Full nav menu, CMS-driven (2026-08-20) ---
// EVERY top-level item and its dropdown children now come from
// src/content/settings/nav-menu.json — including the ORDER (the CMS
// list widget is drag-reorderable), replacing the old setup where
// only Tickets was CMS-editable and everything else (Auditions,
// Classes & Camps, Educators, Shop, About) was hardcoded here.
// Each item's `style` field ("none" | "tickets" | "calendar") is
// still what drives the special blue/green button shapes — it's a
// CMS select field so it can't be mistyped into something the code
// doesn't recognize. Empty-array-safe: an item with zero children
// renders as a plain link, checked with `.length > 0` rather than
// bare truthiness (an empty array is still truthy in JS — see
// BUILD_LOG.md, this bit a previous session).
// --- Staff-created pages that opted into the nav (2026-08-21) ---
// A page made in the CMS can tick "Add to the navigation menu" and
// choose which dropdown it belongs under. Drafts are excluded, matching
// the page route itself, so an unfinished page never appears in the nav.
const cmsPages = (await getCollection("pages"))
  .filter((pg) => !pg.data.draft && pg.data.show_in_nav)
  .map((pg) => ({
    label: (pg.data.nav_label?.trim() || pg.data.title || "").trim(),
    href: `/${pg.id}`,
    parent: (pg.data.nav_parent || "").trim(),
  }))
  .filter((pg) => pg.label && pg.href !== "/");

const navGroups = ((navMenu as any).items || [])
  .filter((g: any) => g?.label?.trim() && g?.url?.trim())
  .map((g: any) => {
    const children = (g.children || [])
      .filter((i: any) => i?.label?.trim() && i?.url?.trim())
      .map((i: any) => ({ label: i.label, href: i.url }));

    // Append any CMS page that named THIS menu as its parent. Matched on
    // the menu's label, case-insensitively, since that's what staff pick
    // from the dropdown.
    const added = cmsPages.filter(
      (pg) => pg.parent.toLowerCase() === String(g.label).trim().toLowerCase()
    );

    // Skip anything already listed by hand in Navigation → Full Menu, so
    // a page that's been placed manually (for precise ordering) doesn't
    // also get appended and appear twice.
    const existing = new Set(children.map((i: any) => String(i.href).replace(/\/+$/, "")));
    const newOnes = added
      .filter((pg) => !existing.has(pg.href.replace(/\/+$/, "")))
      .map((pg) => ({ label: pg.label, href: pg.href }));

    return {
      label: g.label,
      href: g.url,
      special: g.style && g.style !== "none" ? g.style : undefined,
      children: [...children, ...newOnes],
    };
  });

// Maps a navGroup's `special` flag to its CSS class (desktop pill
// vs. mobile pill use different class names for the same visual
// treatment). Centralized here so adding a third "special" nav item
// later doesn't mean hunting down every ternary across four render
// branches (desktop dropdown-trigger, desktop plain-link, mobile
// dropdown-trigger, mobile plain-link).
function specialClass(group: any, variant: "desktop" | "mobile"): string {
  const map: Record<string, { desktop: string; mobile: string }> = {
    tickets: { desktop: "tickets-btn", mobile: "tickets-btn-mobile" },
    calendar: { desktop: "calendar-btn", mobile: "calendar-btn-mobile" },
  };
  return map[group.special]?.[variant] || "";
}
---
 
<header class="site-header">
  <div class="container header-inner">
    {!isHomepage && <Logo />}
 
    <!-- Desktop / wide-screen navigation -->
    <nav class="nav-wide" aria-label="Main navigation">
      {navGroups.map((group) => (
        group.children && group.children.length > 0 ? (
          <div class="nav-group">
            <a
              href={group.href}
              class={`pill nav-group-trigger ${specialClass(group, "desktop")}`}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {group.label}
              <svg class="caret" width="13" height="8" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <div class="nav-dropdown" role="menu">
              {group.children.map((child) => (
                <a href={child.href} class="nav-dropdown-link" role="menuitem">{child.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={group.href} class={`pill ${specialClass(group, "desktop")}`}>{group.label}</a>
        )
      ))}
    </nav>
 
    <div class="header-actions">
      <a href="https://campscui.active.com/orgs/PeninsulaYouthTheatre?orglink=camps-registration&e4q=ad16ecb8-2b37-477f-9cdc-8b959668e4df&e4p=22397909-9890-4b5f-8947-e4982093fc34&e4ts=1787101915&e4c=active&e4e=snlvcmpscui00001load&e4rt=Safetynet&e4h=b318cf7ff23b5f8ebd7b7077a038eb52" class="btn btn-primary register-btn" target="_blank" rel="noopener">Register</a>
      <a href="https://pyt.secure.nonprofitsoapbox.com/donate" class="btn btn-primary donate-btn" target="_blank" rel="noopener">Donate</a>

      <!-- The EN/ES translate toggle used to live here. Moved to the
           FOOTER on 2026-08-23. It was the only item in this bar that
           is neither navigation nor a call to action, and removing it
           was part of getting the row back onto one line — see the
           breakpoint note below. Its markup and its script now live
           together in Footer.astro; nothing here references it. -->
 
      <!-- Hamburger button (phones only) -->
      <button
        class="hamburger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="hamburger-btn"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
 
  <!-- Mobile dropdown menu (phones only) -->
  <!-- Accordion behavior (2026-08-20): a group with children now
       renders as a real <button> that toggles its own panel open/
       closed (aria-expanded + aria-controls, wired up in the script
       below) instead of showing every group's children all the time.
       Each group is independent — opening one doesn't close another.
       A group with no children (Calendar) stays a plain link, same
       as before. -->
  <nav class="nav-mobile" id="mobile-menu" aria-label="Mobile navigation" hidden>
    {navGroups.map((group, i) => (
      group.children && group.children.length > 0 ? (
        <div class="nav-mobile-group">
          <button
            type="button"
            class={`nav-mobile-pill nav-mobile-toggle ${specialClass(group, "mobile")}`}
            aria-expanded="false"
            aria-controls={`nav-mobile-panel-${i}`}
          >
            <span>{group.label}</span>
            <svg class="mobile-caret" width="14" height="9" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="nav-mobile-panel" id={`nav-mobile-panel-${i}`} hidden>
            {group.children.map((child) => (
              <a href={child.href} class="nav-mobile-sublink">{child.label}</a>
            ))}
          </div>
        </div>
      ) : (
        <a href={group.href} class={`nav-mobile-pill nav-mobile-pill-solo ${specialClass(group, "mobile")}`}>{group.label}</a>
      )
    ))}
  </nav>
</header>
 
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-bg-dark);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
 
  /* The header row is allowed to be WIDER than the site's body
     container (2026-08-22). This is deliberate and it is the fix for a
     horizontal-scroll bug, not a cosmetic tweak:

     .header-inner carries .container, which caps at --max-width
     (1140px) minus 2x2.5rem padding = 1060px of usable room. The wide
     nav needs, on a page that also shows the logo:
         logo 98 + nav 789 + actions 255 + two 16px gaps = 1174px
     ...which is 114px MORE than 1060. So the row never fitted the
     container at ANY viewport width. On big screens the excess simply
     spilled into the page's side margins and nobody noticed; once the
     viewport got small enough that those margins ran out, the spill
     turned into a horizontal scrollbar on every page of the site.

     Raising the cap here (and ONLY here — the body container is
     untouched) gives the row the room it always needed. The dark bar
     is full-bleed anyway, so its contents sitting slightly wider than
     the article column below reads as normal nav-bar behaviour.

     UPDATE 2026-08-23: the row now fits the SITE-STANDARD container
     again, so the widened cap has been removed and .header-inner is
     back on --max-width like every other container. That restores the
     nav's left edge to line up with the page content beneath it. */
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: 1.1rem;
    /* SAFETY NET. The nav is CMS-driven (Navigation -> Full Menu), so
       its width is not fixed by this code — adding a menu item makes it
       wider and could re-break the fit. With wrap, an over-long row
       drops onto a second line and the header just gets taller, which
       is untidy but harmless. Without it, the overflow becomes a
       site-wide horizontal scrollbar again. Do not remove this to
       "clean up" the layout. */
    flex-wrap: wrap;
    row-gap: 0.5rem;
  }
 
  /* Wide-screen nav is hidden on phones by default */
  .nav-wide {
    display: none;
    align-items: center;
    /* Tightened again 2026-08-23 (0.9 -> 0.6 -> 0.45rem). Six gaps
       between seven items. See the sizing note on the breakpoint
       below for why every one of these small savings was needed. */
    gap: 0.45rem;
    /* Wraps rather than overflowing if the CMS menu grows. min-width:0
       lets this flex item actually shrink to the space available;
       without it a flex item refuses to go below its content width and
       pushes the row wide instead of wrapping. */
    flex-wrap: wrap;
    min-width: 0;
    /* SPREAD ACROSS THE AVAILABLE SPACE (PM choice, 2026-08-23).
       .header-inner is justify-content: space-between, and it has THREE
       children on most pages (logo, nav, buttons) but only TWO on the
       homepage, where the logo moves down into the hero instead. With
       the logo absent nothing held the left-hand side, so the menu fell
       against the left edge and left ~151px of dead air before
       Register: the homepage nav looked bunched while every other page
       looked fine.

       Letting the nav grow (flex: 1) and distributing its own items
       (space-between) makes it fill whatever space it is handed, so the
       homepage and the rest of the site now agree. The `gap` above
       still acts as the MINIMUM spacing, so as the window narrows the
       items close up to that and no further rather than colliding. */
    flex: 1 1 auto;
    justify-content: space-between;
  }
 
  .nav-wide .pill {
    /* Tightened again 2026-08-23. Padding 1.05 -> 0.8 -> 0.65rem, and
       font-size 0.95 -> 0.88rem. Together across seven items these are
       worth ~120px, the largest single saving available. 0.88rem is
       about as small as Archivo Black can go here and still read
       comfortably on the dark bar — don't reduce it further. */
    padding: 0.55rem 0.65rem;
    font-size: 0.88rem;
    white-space: nowrap;
    font-family: var(--font-heading);
    font-weight: 400;
    background: transparent;
    color: var(--nav-text);
    transition: background 0.16s ease, color 0.16s ease;
  }
 
  .nav-wide .pill:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--nav-text);
  }
 
  /* ---- Dropdown groups (desktop) ---- */
  .nav-group {
    position: relative;
  }
 
  .nav-group-trigger {
    display: inline-flex;
    align-items: center;
    /* 0.4 -> 0.2rem (2026-08-23). Six dropdown groups, so the gap and
       the smaller caret below are worth ~43px between them. */
    gap: 0.2rem;
  }
 
  .caret {
    /* Rendered at 13x8 in the markup; scaled down here (2026-08-23)
       rather than in the SVG so the icon stays crisp and only one
       number has to change. Still clearly a dropdown affordance at
       this size — the arrow shouldn't be removed entirely. */
    width: 9px;
    height: 6px;
    transition: transform 0.18s ease;
  }
 
  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    padding: 0.4rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 0;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.16);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    /* Hidden until the group is hovered or focused */
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
    z-index: 60;
  }
 
  /* A small invisible bridge so the cursor can travel from the
     trigger to the dropdown without it closing. */
  .nav-dropdown::before {
    content: "";
    position: absolute;
    top: -8px;
    left: 0;
    right: 0;
    height: 8px;
  }
 
  .nav-group:hover .nav-dropdown,
  .nav-group:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(4px);
  }
 
  .nav-group:hover .caret,
  .nav-group:focus-within .caret {
    transform: rotate(180deg);
  }
 
  /* The dropdowns near the END of the bar open INWARD (right-aligned to
     their trigger) instead of rightward (2026-08-22).

     This is a real bug fix, not styling. A .nav-dropdown is hidden with
     opacity + visibility, NOT display:none — that's what allows it to
     animate open. But `visibility: hidden` elements still take part in
     layout and still count towards the document's scrollWidth. The
     last group sits near the right end of the bar, so its 200px-wide
     panel, anchored with `left: 0`, stuck out past the viewport edge
     and produced a horizontal scrollbar on every non-homepage — even
     though nothing was visible there. It cost ~85px.

     Anchoring the trailing two groups to `right: 0` puts the panel's
     right edge against its trigger's right edge, which is always
     inside the viewport. It's also better behaviour when open: a menu
     that would run off-screen now opens inward instead.

     nth-last-child rather than naming a group, because the menu order
     is CMS-driven (Navigation -> Full Menu) and whichever items happen
     to be last need this. If a future menu is much wider, widen the
     -n+2 to cover more trailing groups. */
  .nav-group:nth-last-child(-n + 2) .nav-dropdown {
    left: auto;
    right: 0;
  }

  .nav-dropdown-link {
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-btn);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--ink-soft);
    white-space: nowrap;
    transition: background 0.14s ease, color 0.14s ease;
  }
 
  .nav-dropdown-link:hover {
    background: var(--accent-soft);
    color: var(--accent-deep);
  }

  /* ---- Tickets button (2026-08-19) ---- */
  /* Blue (PYT logo blue), shaped like a ticket stub — two circular
     notches bitten out of the left/right edges. The notch trick:
     each ::before/::after is a small circle colored to match the
     bar it sits on (the dark nav background), so it visually "cuts
     into" the blue pill. This only works because the button always
     sits directly on that solid dark background — if this button is
     ever reused somewhere with a different/patterned background,
     the notches will need a different technique (e.g. an SVG mask).
     background/color use !important: Astro auto-adds its scoping
     attribute to EVERY class in a selector, so ".nav-wide .pill"
     actually compiles to MORE specificity points than a plain
     ".tickets-btn" (or even ".pill.tickets-btn") rule can match —
     that's what caused the bug the PM caught live, where this button
     silently rendered as a plain white pill like every other nav
     item. !important sidesteps needing to out-calculate Astro's
     auto-injected specificity. */
  .tickets-btn {
    position: relative;
    background: var(--brand-blue) !important;
    color: #0d2733 !important;
    font-weight: 600;
    padding-inline: 1.3rem;
    z-index: 1;
  }

  .tickets-btn:hover {
    background: var(--brand-blue) !important;
    filter: brightness(1.07);
    color: #0d2733 !important;
  }

  .tickets-btn::before,
  .tickets-btn::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 14px;
    height: 14px;
    background: var(--nav-bg-dark);
    border-radius: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }

  .tickets-btn::before {
    left: -7px;
  }

  .tickets-btn::after {
    right: -7px;
  }

  /* Mobile version: same notch idea, but the pill sits on the light
     mobile-menu panel background instead of the dark bar. */
  .tickets-btn-mobile {
    position: relative;
    background: var(--brand-blue) !important;
    color: #0d2733 !important;
    z-index: 1;
  }

  .tickets-btn-mobile::before,
  .tickets-btn-mobile::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 14px;
    height: 14px;
    background: var(--paper);
    border-radius: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }

  .tickets-btn-mobile::before {
    left: -7px;
  }

  .tickets-btn-mobile::after {
    right: -7px;
  }

  /* ---- Calendar button (2026-08-19) ---- */
  /* Green (site's brand-green), with two small "ring" tabs poking
     above the top edge — evokes a wall calendar's binder rings, the
     same general idea as the Tickets button's side notches but
     additive (small light tabs drawn ON TOP) rather than a "bite"
     needing to match the background color, so this one doesn't
     depend on what's behind it. Uses !important for the same reason
     as .tickets-btn: Astro auto-scopes every class in a selector, so
     the generic ".nav-wide .pill" rule ends up with more specificity
     than a plain ".calendar-btn" rule could ever win outright. */
  .calendar-btn {
    position: relative;
    background: var(--brand-green) !important;
    color: #ffffff !important;
    font-weight: 600;
    padding-inline: 1.2rem;
    /* NO vertical offset (2026-08-23). This used to be `margin-top: 6px`,
       which nudged Calendar down so the button PLUS its little hanging
       tabs read as optically centred. The side effect: Calendar sat 3px
       lower than every other item in the bar — and because Calendar and
       Tickets are the only two solid colour blocks, and sit side by
       side, the eye read TICKETS as floating too high rather than
       Calendar as sitting low. That is the bug the PM reported.

       Aligning the button bodies matters more than optically centring
       one item's tabs: all seven nav items now share a top edge. The
       tabs just extend a little further up into the bar's own padding
       (1.1rem, so there is ample room and nothing is clipped).

       If you reinstate an offset here, apply the SAME value to
       .tickets-btn or the two blocks will disagree again. */
    margin-top: 0;
  }

  .calendar-btn:hover {
    background: var(--brand-green) !important;
    filter: brightness(1.08);
    color: #ffffff !important;
  }

  .calendar-btn::before,
  .calendar-btn::after {
    content: "";
    position: absolute;
    top: -6px;
    width: 5px;
    height: 11px;
    background: #ffffff;
    border-radius: 2px;
  }

  .calendar-btn::before {
    left: 28%;
  }

  .calendar-btn::after {
    right: 28%;
  }

  .calendar-btn-mobile {
    position: relative;
    background: var(--brand-green) !important;
    color: #ffffff !important;
    margin-top: 6px;
  }

  .calendar-btn-mobile::before,
  .calendar-btn-mobile::after {
    content: "";
    position: absolute;
    top: -6px;
    width: 5px;
    height: 11px;
    background: #ffffff;
    border-radius: 2px;
  }

  .calendar-btn-mobile::before {
    left: 28%;
  }

  .calendar-btn-mobile::after {
    right: 28%;
  }

 
  /* Nav logo trimmed 54px -> 44px tall (2026-08-23), worth ~18px of
     width. Scoped to the header on purpose: Footer.astro renders the
     SAME <Logo size="nav" /> and should keep the larger size, so this
     must not be changed inside Logo.astro. :global() is required
     because the logo's own classes come from that component and don't
     carry this file's scoping attribute. */
  .header-inner :global(.logo-nav .logo-mark) {
    height: 44px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
 
  /* Donate keeps the bright highlight color. Register uses PYT's
     pink accent instead (PM request) — .btn-primary already gives
     it that pink by default, so register-btn just needs sizing,
     no color override. */
  .donate-btn {
    padding: 0.5rem 1.1rem;
    font-size: 0.9rem;
    background: var(--highlight);
    color: var(--highlight-text);
  }

  .register-btn {
    padding: 0.5rem 1.1rem;
    font-size: 0.9rem;
  }

  .donate-btn:hover {
    background: var(--highlight);
    filter: brightness(0.92);
  }
 
  /* Hamburger button */
  .hamburger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 0 9px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-btn);
    cursor: pointer;
  }
 
  .hamburger span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--nav-text);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
 
  /* Animate hamburger into an X when open */
  .hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
 
  /* ---- Mobile dropdown menu ---- */
  .nav-mobile {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    padding: 0.6rem;
    /* Cap the menu to the space below the top bar and let it scroll
       internally, so items past the bottom of the screen stay reachable.
       100dvh accounts for the mobile address bar; 100vh is the fallback.
       6rem ≈ the sticky header's own height. */
    max-height: calc(100vh - 6rem);
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
 
  .nav-mobile[hidden] {
    display: none;
  }
 
  /* Each top-level item (and its sub-rows) sits in a group block. */
  .nav-mobile-group {
    margin-bottom: 0.55rem;
  }

  /* Base pill shape shared by every top-level row — both the plain
     <a> (Calendar) and the accordion <button> (everything with
     children). Deliberately no color here: color is layered on next,
     split into "special" (Tickets/Calendar, still their own
     blue/green) vs. the plain black-and-white treatment everyone
     else now uses (2026-08-20 — replaces the old solid lilac fill on
     Auditions/Classes & Camps/Educators/Shop/About, per PM request:
     approved via a static mockup first, see option_a_accordion_bw.png). */
  .nav-mobile-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    width: 100%;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-btn);
    font-weight: 600;
    font-size: 0.95rem;
    font-family: var(--font-body);
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
  }

  /* The plain black-and-white treatment: white fill, black border,
     black text — anything that ISN'T Tickets or Calendar. Written as
     a :not() pair rather than a class so it can't silently stop
     applying if a future item's classes are built slightly
     differently — it's the true default, not an opt-in. */
  .nav-mobile-pill:not(.tickets-btn-mobile):not(.calendar-btn-mobile) {
    background: var(--paper);
    color: var(--ink);
    border: 2px solid var(--ink);
  }

  .nav-mobile-pill:not(.tickets-btn-mobile):not(.calendar-btn-mobile):hover,
  .nav-mobile-pill:not(.tickets-btn-mobile):not(.calendar-btn-mobile):focus-visible {
    background: var(--neutral-soft);
    color: var(--ink);
  }

  /* An open accordion row gets the same soft fill as hover, so the
     currently-expanded item stays visually identifiable even after
     the pointer/focus moves down into its own children. Tied to the
     real aria-expanded state rather than a separate JS-toggled class,
     so the visual state can never drift out of sync with the a11y state. */
  .nav-mobile-toggle[aria-expanded="true"]:not(.tickets-btn-mobile):not(.calendar-btn-mobile) {
    background: var(--neutral-soft);
  }

  /* Standalone pills (Calendar) — same pill, own spacing. */
  .nav-mobile-pill-solo {
    margin-bottom: 0.55rem;
    display: block;
  }

  /* Chevron on accordion toggles — rotates via the same real
     aria-expanded attribute the JS sets, open = pointing up. */
  .mobile-caret {
    flex-shrink: 0;
    transition: transform 0.18s ease;
  }

  .nav-mobile-toggle[aria-expanded="true"] .mobile-caret {
    transform: rotate(180deg);
  }

  /* Each accordion's children — hidden by default (native [hidden]),
     shown when its toggle is expanded. display rules set explicitly
     rather than relying on the bare [hidden] attribute alone, so this
     can't be silently overridden by a more specific rule elsewhere. */
  .nav-mobile-panel {
    display: flex;
    flex-direction: column;
    padding-top: 0.15rem;
  }

  .nav-mobile-panel[hidden] {
    display: none;
  }

  /* Quiet indented sub-rows beneath a pill. */
  .nav-mobile-sublink {
    display: block;
    padding: 0.5rem 0.85rem 0.5rem 1.4rem;
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .nav-mobile-sublink:hover,
  .nav-mobile-sublink:focus-visible {
    color: var(--accent-deep);
  }
  /* ---- Wide screens: show inline nav, hide hamburger ---- */
  /* 1000 -> 1240 -> 1100 (2026-08-23).

     IMPORTANT — why this moved twice. The 1240 value was measured in a
     browser where the Google Fonts stylesheet had not loaded, so the
     nav was being measured in a FALLBACK face. Archivo Black is
     substantially wider: the real nav is ~845px, not the ~759px that
     measurement suggested. The result was a header that wrapped onto
     two rows at every desktop width. If you ever re-measure this,
     confirm the webfont has actually loaded first
     (document.fonts.check('16px "Archivo Black"') is not enough on its
     own — it returns true for a fallback; check that
     [...document.fonts] actually contains a loaded Archivo face).

     Re-measured with the real font, the row needed 1249px of content
     against the 1160px available — it could never fit. Four changes
     brought it down to roughly 1000px:
       - the EN/ES toggle moved to the footer      ~48px
       - nav type 0.95 -> 0.88rem, less padding    ~120px
       - smaller dropdown carets and trigger gap   ~43px
       - nav logo 54px -> 44px tall                ~18px
     Re-measured after those changes the row needs 1021px of content,
     i.e. a 1101px viewport. 1120 is used rather than 1101 so there is
     ~19px of slack — enough to absorb a scrollbar or a slightly wider
     glyph without tipping back into two rows. Down from 1240, so
     laptops and tablets in landscape get the full menu again.

     If nav items are added in the CMS, re-check: load a page above
     1100px with the fonts loaded and confirm .header-inner stays on
     one row (~83px tall, not ~143px). */
  @media (min-width: 1120px) {
    .nav-wide {
      display: flex;
    }
    .hamburger {
      display: none;
    }
    .nav-mobile {
      display: none !important;
    }
    .donate-btn,
    .register-btn {
      /* 1.3 -> 1rem padding, 0.95 -> 0.88rem type (2026-08-23), to
         match the nav pills beside them and claw back ~40px. */
      padding: 0.5rem 1rem;
      font-size: 0.88rem;
    }
  }
</style>
 
<script>
  // Toggle the mobile menu open/closed.
  const btn = document.getElementById("hamburger-btn");
  const menu = document.getElementById("mobile-menu");
 
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isOpen));
      btn.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
      menu.hidden = isOpen;
    });
  }

  // Mobile nav accordion (2026-08-20). Each group with a dropdown
  // renders as a <button aria-controls="nav-mobile-panel-N">; this
  // just toggles that button's aria-expanded and its matching
  // panel's [hidden]. Groups are independent — opening one doesn't
  // close the others, so this is a plain per-button toggle rather
  // than tracking a single "currently open" group.
  document.querySelectorAll<HTMLButtonElement>(".nav-mobile-toggle").forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      const panelId = toggle.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : null;
      toggle.setAttribute("aria-expanded", String(!isOpen));
      if (panel) panel.hidden = isOpen;
    });
  });
</script>
