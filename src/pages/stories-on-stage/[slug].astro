---
/*
  STORIES ON STAGE — PER-PRODUCTION PAGE  ( /stories-on-stage/<slug> )

  REBUILT 2026-09-23 (PM request) to use the SAME LAYOUT AS THE CENTER
  STAGE MUSICALS show page (src/pages/shows/[slug].astro): poster on the
  left (sticky on wide screens), and on the right the title, a Dates /
  Venue / Runtime / Ages facts strip, the Buy Tickets + Sponsor buttons,
  the ticket-fee notice, then the synopsis. The old page (a page hero
  with the title, then a framed "Public performances" card) is gone.

  Differences from the musicals page, on purpose:
    - NO double-cast performance schedule (Stories on Stage is never
      double cast) and no auditions / cast-page buttons.
    - Back link goes to /stories-on-stage, not /shows.
    - NO school/group booking path of any kind (removed 2026-09-23):
      every ticket, including school matinees, is bought through the
      MVCPA box office site. Don't add a booking contact back here.

  The CSS below is copied from the musicals page (same class names,
  same values) so the two page types stay visually identical; if the
  musicals page's layout changes, change this one to match.
*/
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import donatePage from "../../content/settings/donate-page.json";
import showsPage from "../../content/settings/shows-page.json";
import SupportLinks from "../../components/SupportLinks.astro";

// Global ticket-fee notice (CMS-editable, Shows page settings, applies
// everywhere tickets are sold). Empty-safe: renders nothing when blank.
const ticketFeeNotice = (showsPage as any).ticket_fee_notice || "";

export async function getStaticPaths() {
  const productions = await getCollection("storiesOnStage");
  return productions.map((prod) => ({
    params: { slug: prod.id },
    props: { prod },
  }));
}

const { prod } = Astro.props;
const data = prod.data;

// Optional editable line above the buttons — empty by default.
const ticketsIntro = (data as any).tickets_intro || "";
---

<BaseLayout
  title={`${data.title} — Stories on Stage — Peninsula Youth Theatre`}
  description={data.synopsis?.split("\n")[0] || `${data.title} — a Stories on Stage production at Peninsula Youth Theatre.`}
  image={data.poster}
>
  <article class="show-detail">
    <div class="container show-grid">
      <!-- Poster column -->
      <div
        class="show-poster-large"
        style={data.poster ? `background-image: url(${data.poster}); background-size: cover; background-position: center;` : ""}
      >
        {!data.poster && (
          <span class="poster-placeholder-large">{data.title}</span>
        )}
      </div>

      <!-- Info column -->
      <div class="show-content">
        <h1>{data.title}</h1>

        <dl class="show-info-grid">
          <div>
            <dt>Dates</dt>
            <dd>{data.date_display}</dd>
          </div>
          <div>
            <dt>Venue</dt>
            <dd>{data.venue}</dd>
          </div>
          {data.runtime_minutes && (
            <div>
              <dt>Runtime</dt>
              <dd>About {data.runtime_minutes} minutes</dd>
            </div>
          )}
          {data.ages && (
            <div>
              <dt>Ages</dt>
              <dd>{data.ages}</dd>
            </div>
          )}
        </dl>

        {ticketsIntro && <p class="tickets-intro">{ticketsIntro}</p>}

        <div class="show-ctas">
          {data.public_ticketing_url ? (
            <a href={data.public_ticketing_url} class="btn btn-primary" target="_blank" rel="noopener">
              Buy Tickets
            </a>
          ) : (
            <span class="btn btn-outline btn-disabled" aria-disabled="true">
              Tickets coming soon
            </span>
          )}
          <SupportLinks sponsor context="show" />
        </div>

        {/* Ticket-fee notice sits at the bottom of the page, above the back
            link (2026-09-23, PM request) — same as the musicals page. */}

        {data.synopsis && (
          <div class="show-synopsis">
            {data.synopsis.split("\n\n").map((para: string) => (
              <p>{para}</p>
            ))}
          </div>
        )}

        {ticketFeeNotice && <p class="ticket-fee-notice">{ticketFeeNotice}</p>}

        <p class="back-link"><a href="/stories-on-stage">← Back to Stories on Stage</a></p>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* Copied from src/pages/shows/[slug].astro (2026-09-23) so the two
     show-page types match. Keep in step with that file. */
  .show-detail {
    /* VERTICAL RHYTHM (tokens.css): standard top, standard bottom. */
    padding-block: var(--page-top) var(--section-pad);
  }

  .show-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .show-poster-large {
    aspect-ratio: 3 / 4;
    width: 100%;
    background: linear-gradient(150deg, var(--accent) 0%, var(--accent-deep) 100%);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    padding: var(--space-lg);
    box-shadow: var(--shadow-lift);
  }

  .poster-placeholder-large {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 600;
    text-align: center;
    line-height: 1.05;
  }

  .show-content h1 {
    margin-block: 0.4rem var(--space-md);
  }

  .show-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    padding-block: var(--space-md);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .show-info-grid div {
    min-width: 0;
  }

  .show-info-grid dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.3rem;
  }

  .show-info-grid dd {
    font-size: 1rem;
    color: var(--ink);
    margin: 0;
  }

  .tickets-intro {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0 0 var(--space-sm);
  }

  /* Footnote at the bottom of the page (2026-09-23): hairline above,
     then the back link. */
  .ticket-fee-notice {
    font-size: 0.85rem;
    color: var(--ink-muted);
    line-height: 1.5;
    max-width: 60ch;
    margin: var(--space-xl) 0 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--line);
  }

  .show-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-bottom: var(--space-lg);
  }

  .btn-disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .show-synopsis p {
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  .back-link {
    margin-top: var(--space-xl);
    font-size: 0.95rem;
  }

  .back-link a {
    color: var(--accent-deep);
  }

  /* Wider screens: poster beside content */
  @media (min-width: 920px) {
    .show-grid {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-2xl);
    }
    .show-poster-large {
      flex: 1;
      position: sticky;
      top: 80px;
      max-width: 380px;
    }
    .show-content {
      flex: 1.4;
    }
  }
</style>
