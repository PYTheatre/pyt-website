---
/*
  STORIES ON STAGE — PER-PRODUCTION PAGE  ( /stories-on-stage/<slug> )

  One page per Stories on Stage production. ONE booking path (2026-09-23):
    - Public performances → "Tickets" button to the outside ticketing site
      (or "coming soon" when no link is set yet). An optional, editable
      intro line sits above it — empty by default, and renders nothing
      (no gap) when empty.

  The "Schools and groups" card with its enquiry form was REMOVED on
  2026-09-23 at the PM's request: PYT no longer takes school or group
  bookings itself — every ticket, including school matinees, is bought
  through the MVCPA box office site. Don't add a booking contact back
  here. (The "education" Formspree route still exists for School Play in
  a Box and Classes & Camps.)

  Per-production content comes from the storiesOnStage collection;
  the ticket-fee notice from the Shows page settings.
*/
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import settings from "../../content/settings/stories-on-stage-page.json";
import showsPage from "../../content/settings/shows-page.json";
import SupportLinks from "../../components/SupportLinks.astro";

const ticketFeeNotice = (showsPage as any).ticket_fee_notice || "";

export async function getStaticPaths() {
  const productions = await getCollection("storiesOnStage");
  return productions.map((prod) => ({
    params: { slug: prod.id },
    props: { prod },
  }));
}

const { prod } = Astro.props;
const data = prod.data;

// Optional editable line above the Tickets button — empty by default.
const ticketsIntro = (data as any).tickets_intro || "";
---

<BaseLayout
  title={`${data.title} — Stories on Stage — Peninsula Youth Theatre`}
  description={`${data.title} — a Stories on Stage production at Peninsula Youth Theatre. Dates, tickets and details.`}
>
  <PageHero eyebrow="Stories on Stage" title={data.title} />

  <section class="section prod-section">
    <div class="container prod-grid">
      <div class="prod-poster-col">
        <div
          class="prod-poster"
          style={data.poster ? `background-image: url(${data.poster}); background-size: cover; background-position: center;` : ""}
        >
          {!data.poster && <span class="poster-placeholder">{data.title}</span>}
        </div>
      </div>

      <div class="prod-detail-col">
        <p class="prod-meta">{data.date_display} · {data.venue}</p>

        {data.synopsis && (
          <div class="prod-synopsis">
            {data.synopsis.split("\n\n").map((para: string) => (
              <p>{para}</p>
            ))}
          </div>
        )}

        {/* ---- Public performances ---- */}
        <div class="booking-card">
          <h2>Public performances</h2>
          {ticketsIntro && <p class="booking-intro">{ticketsIntro}</p>}
          {/* Tickets and Sponsor share one row (PM request, 2026-08-22)
              so the sponsor button reads as a peer of Tickets rather
              than as a stray afterthought below the card. The row
              wrapper is always present even when SupportLinks renders
              nothing (blank CMS label), which is harmless: an empty
              flex row collapses to the height of its one child. */}
          <div class="booking-actions">
            {data.public_ticketing_url ? (
              <a href={data.public_ticketing_url} class="btn btn-primary" target="_blank" rel="noopener">
                Tickets
              </a>
            ) : (
              <span class="btn btn-outline btn-disabled" aria-disabled="true">
                Tickets coming soon
              </span>
            )}
            <SupportLinks sponsor context="show" />
          </div>
          {ticketFeeNotice && <p class="ticket-fee-notice">{ticketFeeNotice}</p>}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prod-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .prod-poster {
    aspect-ratio: 3 / 4;
    background: linear-gradient(150deg, var(--accent) 0%, var(--accent-deep) 100%);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    padding: var(--space-md);
    box-shadow: var(--shadow-soft);
    max-width: 360px;
  }

  .poster-placeholder {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 600;
    text-align: center;
    line-height: 1.15;
  }

  .prod-meta {
    font-size: 1rem;
    color: var(--ink-soft);
    font-weight: 500;
    margin: 0 0 var(--space-md);
  }

  .prod-synopsis {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .prod-synopsis p {
    margin: 0 0 var(--space-sm);
  }

  /* Button row inside the Public performances card. Wraps on narrow
     screens so Tickets and Sponsor stack rather than overflowing the
     card. Same 0.7rem gap as .show-ctas on the musical show pages, so
     the two page types match. */
  .booking-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  /* The last card needs no margin under it: that 24px sat on top of the
     section padding and pushed these pages further from the footer than
     the rest of the site (VERTICAL RHYTHM, tokens.css). */
  .booking-card:last-child {
    margin-bottom: 0;
  }

  .booking-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-md);
    margin-bottom: var(--space-md);
    background: var(--paper);
  }

  .booking-card h2 {
    font-size: 1.2rem;
    margin: 0 0 0.4rem;
  }

  .booking-intro {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0 0 var(--space-sm);
  }

  .ticket-fee-notice {
    font-size: 0.85rem;
    color: var(--ink-muted);
    line-height: 1.5;
    margin: var(--space-md) 0 0;
  }

  @media (min-width: 720px) {
    .prod-grid {
      grid-template-columns: 320px 1fr;
      gap: var(--space-xl);
      align-items: start;
    }
  }
</style>
