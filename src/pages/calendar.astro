---
/*
  CALENDAR PAGE  ( /calendar )

  Embeds a public Google Calendar — every PYT show, audition, class,
  and event in one place, managed directly in Google Calendar (not
  through this site's CMS). Only the page's own copy (title, intro)
  and WHICH calendar to embed are CMS-editable, via Site Settings →
  Calendar Page.

  IMPORTANT: the calendar being embedded must be set to public in
  Google Calendar (Settings and sharing → "Access permissions for
  events" → "Make available to public"), or this page shows blank to
  anyone who isn't logged into that specific Google account. This
  isn't something code can check or fix — it's a setting on the
  calendar itself.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import page from "../content/settings/calendar-page.json";

const calendarId = (page as any).calendar_id?.trim() || "";

// Standard Google Calendar embed URL, built from just the calendar ID
// so the CMS field can stay a simple one-line value (an email-like
// ID) rather than staff needing to paste a whole iframe snippet.
// Params chosen: hide the built-in title bar (this page has its own
// heading), hide the "other calendars" list and timezone dropdown
// (there's only one calendar here), hide the print icon, keep the
// Month/Week/Agenda view tabs since those are genuinely useful.
const embedSrc = calendarId
  ? `https://calendar.google.com/calendar/embed?src=${encodeURIComponent(calendarId)}&ctz=America%2FLos_Angeles&mode=MONTH&showTitle=0&showCalendars=0&showTz=0&showPrint=0&showTabs=1&wkst=1`
  : "";
---

<BaseLayout
  title={`${page.title} — Peninsula Youth Theatre`}
  description="Every Peninsula Youth Theatre show, audition, class, and event in one calendar."
>
  <PageHero eyebrow={page.eyebrow} title={page.title} lede={page.intro} />

  <section class="section calendar-section">
    <div class="container">
      {embedSrc ? (
        <div class="calendar-embed-wrap">
          <iframe
            src={embedSrc}
            title="Peninsula Youth Theatre calendar"
            loading="lazy"
          ></iframe>
        </div>
      ) : (
        <p class="calendar-missing">
          The calendar isn't connected yet — add a Calendar ID under Site Settings → Calendar Page in the CMS.
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .calendar-section {
    padding-top: 0;
  }

  .calendar-embed-wrap {
    border: 1px solid var(--line);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }

  .calendar-embed-wrap iframe {
    display: block;
    width: 100%;
    height: 650px;
    border: 0;
  }

  .calendar-missing {
    color: var(--ink-soft);
    max-width: 50ch;
  }

  @media (max-width: 640px) {
    .calendar-embed-wrap iframe {
      height: 520px;
    }
  }
</style>
