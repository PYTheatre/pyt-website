---
/*
  NEWSLETTER SIGNUP PAGE  ( /subscribe )

  The form itself lives in src/components/NewsletterForm.astro
  (extracted 2026-09-23 so the Contact page can show the same form).
  All the MailChimp notes are in that file.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
---

<BaseLayout
  title="Newsletter Signup — Peninsula Youth Theatre"
  description="Sign up for PYT news: auditions, shows, camps, classes, and more."
>
  <PageHero
    eyebrow="Stay in the loop"
    title="Newsletter signup"
    lede="Get PYT news delivered to your inbox — auditions, upcoming shows, class announcements, and more. Choose only the topics you care about."
  />

  <section class="section">
    <div class="container">
      <NewsletterForm />
    </div>
  </section>
</BaseLayout>
