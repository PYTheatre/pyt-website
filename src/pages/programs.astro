---
/*
  PROGRAMS PAGE  ( /programs )

  Renders all programs (Classes, Camps, Stories on Stage, Studio
  Intensives) as filterable cards. Filtering is done in the browser
  with a tiny bit of vanilla JavaScript — no React/Vue needed.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import PageHero from "../components/PageHero.astro";
import { getCollection } from "astro:content";
import pageContent from "../content/settings/programs-page.json";
import SupportLinks from "../components/SupportLinks.astro";

// Load all programs, alphabetical by name.
const programs = (await getCollection("programs")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);

// Build unique filter options from the actual data, so when staff
// add new programs the filters update automatically.
const programTypes = [...new Set(programs.map((p) => p.data.program_type))];
const seasons = [...new Set(programs.map((p) => p.data.season))];

// Contact card shown as the third box in the programmes grid
// (2026-08-23). Heading and intro are CMS-editable and optional, with
// sensible fallbacks so the card is never blank or headless.
const contactHeading =
  ((pageContent as any).contact_heading || "").trim() || "Questions?";
const contactIntro =
  ((pageContent as any).contact_intro || "").trim() ||
  "Including cancellation and transfer requests.";
---

<BaseLayout
  title="Classes & Camps — Peninsula Youth Theatre"
  description="Year-round classes, summer camps, Stories on Stage, and Studio Intensives for ages 4–18."
>
  <PageHero
    title={pageContent.title}
    lede={pageContent.lede}
  >
    <SupportLinks slot="actions" sponsor scholarship context="programs" row />
  </PageHero>

  {(pageContent as any).summer_intro && (
    <section class="section summer-block-section">
      <div class="container">
        <div class="summer-block">
          <h2 class="summer-heading">{(pageContent as any).summer_heading}</h2>
          <p class="summer-intro">{(pageContent as any).summer_intro}</p>

          {(pageContent as any).summer_register_url && (
            <a
              href={(pageContent as any).summer_register_url}
              class="btn btn-primary"
              target="_blank"
              rel="noopener"
            >
              {(pageContent as any).summer_register_label || "Register here"}
            </a>
          )}

          <dl class="summer-facts">
            {(pageContent as any).summer_hours && (
              <div class="summer-fact">
                <dt>Hours</dt>
                <dd>{(pageContent as any).summer_hours}</dd>
              </div>
            )}
            {(pageContent as any).summer_locations && (
              <div class="summer-fact">
                <dt>Locations</dt>
                <dd>
                  {(pageContent as any).summer_locations.split("\n").map((line: string) => (
                    <span class="summer-line">{line}</span>
                  ))}
                </dd>
              </div>
            )}
            {(pageContent as any).summer_pricing && (
              <div class="summer-fact">
                <dt>Pricing</dt>
                <dd>
                  {(pageContent as any).summer_pricing.split("\n").map((line: string) => (
                    <span class="summer-line">{line}</span>
                  ))}
                </dd>
              </div>
            )}
          </dl>

          {(pageContent as any).summer_scholarships_note && (
            <p class="summer-note">{(pageContent as any).summer_scholarships_note}</p>
          )}

          {(pageContent as any).summer_cancellation_body && (
            <details class="summer-cancellation">
              <summary>{(pageContent as any).summer_cancellation_heading || "Cancellation & transfer policy"}</summary>
              {(pageContent as any).summer_cancellation_body.split("\n\n").map((para: string) => (
                <p>{para}</p>
              ))}
              {/* Cancellation requests used to publish an email address
                  here (2026-08-20). They now go through the contact form
                  at the foot of this page. */}
              <p>Cancellation requests: please use the contact form below.</p>
            </details>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="section programs-section">
    <div class="container">
      {/* The Type / Season filter dropdowns and the "Showing all N
          programs" counter were removed 2026-08-23 (PM request). With
          only a couple of programs listed they were more furniture
          than help. The cards still carry their data-type and
          data-season attributes, so if filtering is ever wanted back
          the markup it needs is still here. */}

      <!-- Program cards -->
      <ul class="program-list" id="program-list">
        {programs.map((program) => (
          <li
            class="program-card"
            data-type={program.data.program_type}
            data-season={program.data.season}
          >
            <h2>{program.data.name}</h2>

            <ul class="program-tags">
              <li>{program.data.program_type}</li>
              <li>{program.data.age_range}</li>
              <li>{program.data.season}</li>
              {program.data.scholarships_available && (
                <li class="tag-scholarships">Scholarships available</li>
              )}
            </ul>

            <p class="program-description">{program.data.description}</p>

            {(program.data.schedule || program.data.tuition) && (
              <dl class="program-meta">
                {program.data.schedule && (
                  <div>
                    <dt>Schedule</dt>
                    <dd>{program.data.schedule}</dd>
                  </div>
                )}
                {program.data.tuition && (
                  <div>
                    <dt>Tuition</dt>
                    <dd>{program.data.tuition}</dd>
                  </div>
                )}
              </dl>
            )}

            <div class="program-cta">
              {program.data.registration_url ? (
                <a
                  href={program.data.registration_url}
                  class="btn btn-primary"
                  target="_blank"
                  rel="noopener"
                >
                  Register on Active.com
                </a>
              ) : (
                <span class="btn btn-outline btn-disabled" aria-disabled="true">
                  Registration coming soon
                </span>
              )}
            </div>
          </li>
        ))}

        {/* CONTACT CARD (2026-08-23). Deliberately the last <li> of the
            SAME <ul> as the programme cards, not a separate block
            beside it — that's what makes it land in the same grid
            column, at the same width, with its top edge aligned to the
            other cards. A sibling element outside the list could only
            ever be lined up by hand and would drift the moment a
            programme is added or the breakpoint changes.

            It carries no data-type / data-season attributes, so if the
            filters are ever restored this card must be excluded from
            them (it should never be filtered away). */}
        <li class="program-card program-card-contact">
          <h2>{contactHeading}</h2>
          {contactIntro && <p class="program-description">{contactIntro}</p>}
          <div class="program-contact-form">
            <ContactForm
              route="education"
              source="Classes &amp; Camps page"
              submitLabel="Send message"
            />
          </div>
        </li>
      </ul>

    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Summer Camps block ---- */
  .summer-block-section {
    padding-top: 0;
  }

  .summer-block {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-lg);
    background: var(--paper);
  }

  .summer-heading {
    font-size: 1.5rem;
    margin: 0 0 var(--space-sm);
  }

  .summer-intro {
    font-size: 1rem;
    line-height: 1.7;
    max-width: 65ch;
    margin: 0 0 var(--space-md);
  }

  .summer-block .btn {
    margin-bottom: var(--space-lg);
  }

  .summer-facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin: 0 0 var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--line);
  }

  .summer-fact dt {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.3rem;
  }

  .summer-fact dd {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .summer-line {
    display: block;
  }

  .summer-note {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin: 0 0 var(--space-md);
  }

  .summer-cancellation {
    border-top: 1px solid var(--line);
    padding-top: var(--space-md);
  }

  .summer-cancellation summary {
    font-weight: 600;
    cursor: pointer;
    font-size: 0.95rem;
  }

  .summer-cancellation p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: var(--space-sm) 0 0;
  }

  .summer-cancellation a {
    color: var(--accent-deep);
    text-decoration: underline;
  }

  @media (min-width: 720px) {
    .summer-facts {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
  }

  /* ---- Program cards ---- */
  .program-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .program-card {
    padding: var(--space-md);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    display: flex;
    flex-direction: column;
  }

  .program-card.hidden {
    display: none;
  }

  /* Contact card. Same box as the programme cards — the border,
     padding and radius all come from .program-card above, so the three
     boxes match by construction rather than by duplicated numbers.
     Only the tinted background distinguishes it, marking it as an
     action rather than a programme. */
  .program-card-contact {
    background: var(--paper-warm);
  }

  /* Pushes the form to the BOTTOM of the card, so it lines up with the
     Register buttons in the cards beside it (.program-cta uses
     margin-top:auto for the same reason) rather than floating
     mid-card when the neighbouring cards are taller. */
  .program-contact-form {
    margin-top: auto;
    padding-top: var(--space-sm);
  }

  /* The form's own inputs sit inside a narrow card, so let them use
     the full width rather than the wider default measure they get on
     a full-width section. :global() is needed because this markup
     comes from ContactForm.astro and doesn't carry this file's
     scoping attribute. */
  .program-contact-form :global(input),
  .program-contact-form :global(textarea),
  .program-contact-form :global(select) {
    width: 100%;
    max-width: 100%;
  }

  .program-contact-form :global(form) {
    max-width: 100%;
  }

  /* ContactForm renders itself inside its own bordered white card.
     Nested inside THIS card that reads as a box-in-a-box, so its
     chrome is stripped here and the form sits directly on the tinted
     background. Scoped to this page only — the same component is used
     full-width elsewhere and should keep its card there. */
  .program-contact-form :global(.contact-form-card) {
    padding: 0;
    border: none;
    background: transparent;
    box-shadow: none;
  }


  .program-card h2 {
    font-size: 1.3rem;
    margin-bottom: var(--space-sm);
  }

  .program-tags {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-sm);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .program-tags li {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-soft);
    background: var(--paper-warm);
    border: 1px solid var(--line);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
  }

  .program-tags li.tag-scholarships {
    color: var(--accent-deep);
    border-color: var(--accent-soft);
    background: var(--accent-soft);
  }

  .program-description {
    font-size: 0.95rem;
    margin-bottom: var(--space-sm);
    flex-grow: 1;
  }

  .program-meta {
    margin: 0 0 var(--space-md);
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--line);
  }

  .program-meta div {
    margin-bottom: 0.5rem;
  }

  .program-meta dt {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.2rem;
  }

  .program-meta dd {
    font-size: 0.92rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .program-cta {
    margin-top: auto;
  }

  .program-cta .btn {
    width: 100%;
    text-align: center;
    justify-content: center;
  }

  .btn-disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }


  .staff-tip {
    margin-top: var(--space-xl);
    padding: var(--space-md);
    background: var(--paper-warm);
    border-radius: var(--radius);
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .staff-tip a {
    color: var(--accent-deep);
    text-decoration: underline;
  }

  /* Wider screens: 2 then 3 columns */
  @media (min-width: 720px) {
    .program-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .program-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
