---
/*
  WAYS TO SUPPORT PAGE  ( /ways-to-support )
  (formerly /donate — renamed 2026-06-03; URL is now /ways-to-support)
 
  Reads three CMS-managed files:
   - donation-campaign.json (progress numbers — also used on home)
   - donor-tiers.json (the tier cards)
   - donate-page.json (intro copy + hosted Soapbox donation link)
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import campaign from "../content/settings/donation-campaign.json";
import tiers from "../content/settings/donor-tiers.json";
import donatePage from "../content/settings/donate-page.json";
import corporate from "../content/settings/corporate-giving.json";
import recognition from "../content/settings/donor-recognition.json";
import giftFunds from "../content/settings/gift-funds.json";

// "What your gift funds" — list under Donor Benefits. Empty-safe: if the
// live data has no items yet (or the record is absent), the whole section
// simply doesn't render. Each row's Donate button uses the same general
// Soapbox link as the rest of the page.
const giftFundItems = (giftFunds?.items ?? []).filter(
  (it) => it && (it.amount || it.description)
);
 
const goal = campaign.goal_amount;
const raised = campaign.raised_amount;
const donorCount = campaign.donor_count;
const campaignLabel = campaign.campaign_label;
const pct = Math.round((raised / goal) * 100);
// Clamp the visible fill so an over-goal campaign can't overflow the tube.
const fillPct = Math.min(100, Math.max(0, pct));

// --- Thermometer redesign (2026-08-20) — same treatment as the home
// page (star badge + interval ticks, approved via thermometer_redesign_v4.png),
// computed from THIS page's own smaller thermo/tube sizes (see
// .thermo/.thermo-tube below) — this page has always used a different
// size than the homepage's version.
const THERMO_H = 331;   // whole graphic, incl. the star's headroom above the tube
const TUBE_TOP = 81;    // tube's own top edge, leaving room for the star above it
const TUBE_H = 210;
const TUBE_W = 32;

// Scale runs from the tube's bottom to where its rounded cap begins —
// not the cap's mathematical peak, where the edge curves inward and a
// tick would visually float off the tube's side.
const USABLE_H = TUBE_H - TUBE_W / 2;
const TUBE_BOTTOM = TUBE_TOP + TUBE_H;
const TICK_BASE = THERMO_H - TUBE_BOTTOM;

const tickFractions = [0.25, 0.5, 0.75, 1];
const thermoTicks = tickFractions.map((f) => ({
  amount: Math.round(goal * f),
  bottomPx: TICK_BASE + f * USABLE_H,
}));

// Fill in PIXELS on the same scale the ticks use — as a percentage of
// the tube's full height it measured against a taller scale than the
// ticks did, so the teal rose above its own matching tick mark.
const fillPx = (fillPct / 100) * USABLE_H;

function hexagramPoints(size: number): string {
  const cx = size / 2, cy = size / 2;
  const rOuter = size / 2;
  const rInner = rOuter / Math.sqrt(3);
  const pts: string[] = [];
  for (let i = 0; i < 12; i++) {
    const r = i % 2 === 0 ? rOuter : rInner;
    const angle = (Math.PI / 180) * (-90 + i * 30);
    pts.push(`${(cx + r * Math.cos(angle)).toFixed(2)},${(cy + r * Math.sin(angle)).toFixed(2)}`);
  }
  return pts.join(" ");
}
const goalStarPoints = hexagramPoints(200);
 
const soapboxDonateUrl =
  donatePage.soapbox_donate_url || "https://pyt.secure.nonprofitsoapbox.com/donate";
 
/*
  SPONSORSHIP — now routes to the hosted Soapbox donation page (NOT Shopify).
  Decided 2026-06-15: sponsorship stays tax-deductible, so both "Sponsor a
  Show" and "Sponsor a Season" buttons point at the general Soapbox donation
  page (same one the Donate button uses). The flexible Soapbox form lets the
  giver enter their own amount and recognition name, so one page serves
  individuals + both sponsorship types. (Reverses the earlier Shopify plan,
  which would not have been tax-deductible.)
  The per-show "Sponsor This Show" buttons now route to the same Soapbox
  page directly (done 2026-06-23). shows/index.astro has no sponsor button.
*/
const sponsorDonateUrl =
  donatePage.soapbox_donate_url || "https://pyt.secure.nonprofitsoapbox.com/donate";
 
// Sponsorship panel text — CMS-editable (Support PYT record), with
// fallbacks so the panel reads correctly before staff fill the fields.
// Eyebrow is fully opt-in: shows only when the field has text (no fallback),
// so clearing it in the CMS removes it.
const sponsorEyebrow = donatePage.sponsor_eyebrow || "";
const sponsorHeading =
  donatePage.sponsor_heading || "Sponsor a show or a season.";
const sponsorShowTitle = donatePage.sponsor_show_title || "Sponsor a Show";
const sponsorShowDescription =
  donatePage.sponsor_show_description ||
  "Back a single Center Stage Musicals production and receive recognition tied to that show — program advertising, lobby signage, and on-stage thank-yous.";
const sponsorSeasonTitle = donatePage.sponsor_season_title || "Sponsor a Season";
const sponsorSeasonDescription =
  donatePage.sponsor_season_description ||
  "Support the full season of productions and education programs, with recognition across the whole year of PYT performances.";
// Optional price labels for each sponsor card — shown only when set
// (replaces the old hardcoded "Show-level / Season-level" labels).
const sponsorShowPrice = donatePage.sponsor_show_price || "";
const sponsorSeasonPrice = donatePage.sponsor_season_price || "";
 
/*
  CORPORATE GIVING — also routes to Soapbox (tax-deductible).
  The dedicated corporate Soapbox page does not exist yet, so
  corporate_donate_url is empty for now. While empty, the tier buttons
  render as a non-clickable "Coming soon" pill. Once the PM creates the
  Soapbox corporate page and fills the link in the CMS, the buttons go live.
*/
const corporateDonateUrl = corporate.corporate_donate_url || "";
const corporateLinkLive = corporateDonateUrl.trim().length > 0;
// Optional contact email shown under the corporate intro as a mailto link.
const corporateEmail = (corporate as any).contact_email || "";
 
// Recognition: only show groups that actually have at least one name,
// so empty tiers don't render as bare headings.
const recognitionGroups = (recognition.groups || []).filter(
  (g) => Array.isArray(g.names) && g.names.filter((n) => n && n.trim()).length > 0
);
 
// Giving-levels section headings — CMS-editable (Support PYT record).
// Heading keeps a sensible fallback. The eyebrow is fully OPT-IN: it shows
// only when the field has text. Missing or blank → no eyebrow. (No fallback,
// so clearing it in the CMS genuinely removes it.)
const tiersEyebrow = donatePage.tiers_eyebrow || "";
const tiersHeading = donatePage.tiers_heading || "Every gift, every level.";
---
 
<BaseLayout
  title="Ways to Support — Peninsula Youth Theatre"
  description="Support the next generation of Bay Area performers. Your gift to Peninsula Youth Theatre funds scholarships, productions, and school touring."
>
  <!-- Light hero: campaign progress as a thermometer + Donate button -->
  <section class="section campaign-hero" id="individual">
    <div class="container">
      <p class="eyebrow">{campaignLabel}</p>
      <h1>{donatePage.intro_heading}</h1>
      <p class="campaign-intro">{donatePage.intro_body}</p>
 
      <div class="thermo-row">
        <!-- Thermometer -->
        <div class="thermo" role="img"
             aria-label={`$${raised.toLocaleString()} raised of $${goal.toLocaleString()} goal, ${pct}% complete`}>
          <div class="thermo-tube">
            <div class="thermo-fill" style={`height: ${fillPx}px`}></div>
          </div>
          <div class="thermo-bulb"></div>
          <div class="thermo-ticks" aria-hidden="true">
            {thermoTicks.map((t) => (
              <div class="thermo-tick" style={`bottom: ${t.bottomPx}px`}>
                <span class="thermo-tick-dash"></span>
                <span class="thermo-tick-label">${t.amount.toLocaleString()}</span>
              </div>
            ))}
          </div>
          <div class="thermo-goal-badge" aria-hidden="true">
            <svg viewBox="0 0 200 200" class="thermo-star">
              <polygon points={goalStarPoints} />
            </svg>
            <span class="thermo-goal-badge-text">Goal</span>
          </div>
        </div>
 
        <!-- Numbers + Donate button — same "just donors + %" treatment
             as the home page (2026-08-20): the big raised figure and
             "raised of $X goal" grey line are gone. This page's own
             pink Donate button and side-by-side layout are unchanged —
             only the thermometer graphic and the stat line were part
             of the approved redesign. -->
        <div class="thermo-stats">
          <p class="thermo-meta">
            <strong>{donorCount}</strong> donors &middot; <strong>{pct}%</strong> of goal
          </p>
          <a
            href={soapboxDonateUrl}
            class="btn btn-primary thermo-donate"
            target="_blank"
            rel="noopener"
          >
            Donate
          </a>
        </div>
      </div>
    </div>
  </section>
 
  <!-- Donor tiers -->
  <section class="section tiers-section">
    <div class="container">
      {tiersEyebrow && <p class="eyebrow">{tiersEyebrow}</p>}
      <h2 class="section-head">{tiersHeading}</h2>
 
      <ul class="tier-list">
        {tiers.tiers.map((tier) => (
          <li class="tier-card">
            <p class="tier-range">{tier.range}</p>
            <h3>{tier.name}</h3>
            <p class="tier-description">{tier.description}</p>
            <a href={soapboxDonateUrl} class="btn btn-primary sponsor-btn" target="_blank" rel="noopener">
              Join
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ WHAT YOUR GIFT FUNDS ============ -->
  <!--
    Sits directly under Donor Benefits. No visible heading (by design).
    A plain list of "amount — what it pays for" rows, each with a Donate
    button to the general Soapbox page. Renders ONLY when the CMS list has
    items, so the live empty state shows nothing rather than a bare section.
  -->
  {giftFundItems.length > 0 && (
    <section class="section gift-funds-section">
      <div class="container">
        <ul class="gift-funds-list">
          {giftFundItems.map((item) => (
            <li class="gift-funds-row">
              <div class="gift-funds-text">
                <span class="gift-funds-amount">{item.amount}</span>
                {item.description && (
                  <span class="gift-funds-desc"> {item.description}</span>
                )}
              </div>
              <a href={soapboxDonateUrl} class="btn btn-primary gift-funds-btn" target="_blank" rel="noopener">
                Donate
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ============ CORPORATE GIVING ============ -->
  <section class="section corporate-section" id="corporate">
    <div class="container">
      {corporate.eyebrow && <p class="eyebrow">{corporate.eyebrow}</p>}
      <h2 class="section-head">{corporate.heading}</h2>
      {corporate.intro && <p class="corporate-intro">{corporate.intro}</p>}
      {corporateEmail && (
        <p class="corporate-contact">
          To discuss corporate giving, email <a href={`mailto:${corporateEmail}`}>{corporateEmail}</a>.
        </p>
      )}
 
      <ul class="tier-list">
        {corporate.tiers.map((tier) => (
          <li class="tier-card">
            <p class="tier-range">{tier.amount}</p>
            <h3>{tier.name}</h3>
            <p class="tier-description">{tier.description}</p>
            {corporateLinkLive ? (
              <a href={corporateDonateUrl} class="btn btn-primary sponsor-btn" target="_blank" rel="noopener">
                Join
              </a>
            ) : (
              <span class="btn btn-primary sponsor-btn is-disabled" aria-disabled="true" role="link" tabindex="-1">
                Coming soon
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
 
  <!-- ============ SPONSORSHIP ============ -->
  <!--
    Sponsorship routes to the general Soapbox donation page (tax-deductible).
    The per-card "Show-level/Season-level" labels were replaced with an
    OPTIONAL price field (sponsor_show_price / sponsor_season_price) that
    only renders when set — for when price levels are decided.
  -->
  <section class="section sponsor-section" id="sponsor">
    <div class="container">
      {sponsorEyebrow && <p class="eyebrow">{sponsorEyebrow}</p>}
      <h2 class="section-head">{sponsorHeading}</h2>
 
      <ul class="tier-list sponsor-list">
        <li class="tier-card">
          {sponsorShowPrice && <p class="tier-range">{sponsorShowPrice}</p>}
          <h3>{sponsorShowTitle}</h3>
          <p class="tier-description">{sponsorShowDescription}</p>
          <a href={sponsorDonateUrl} class="btn btn-primary sponsor-btn" target="_blank" rel="noopener">
            {sponsorShowTitle}
          </a>
        </li>
 
        <li class="tier-card">
          {sponsorSeasonPrice && <p class="tier-range">{sponsorSeasonPrice}</p>}
          <h3>{sponsorSeasonTitle}</h3>
          <p class="tier-description">{sponsorSeasonDescription}</p>
          <a href={sponsorDonateUrl} class="btn btn-primary sponsor-btn" target="_blank" rel="noopener">
            {sponsorSeasonTitle}
          </a>
        </li>
      </ul>
    </div>
  </section>
 
  <!-- ============ DONOR & SPONSOR RECOGNITION ============ -->
  {recognitionGroups.length > 0 && (
    <section class="section recognition-section" id="recognition">
      <div class="container">
        <p class="eyebrow">{recognition.eyebrow}</p>
        <h2 class="section-head">{recognition.heading}</h2>
        {recognition.intro && <p class="recognition-intro">{recognition.intro}</p>}
 
        <div class="recognition-groups">
          {recognitionGroups.map((group) => (
            <div class="recognition-group">
              <h3 class="recognition-tier">{group.tier_name}</h3>
              <ul class="recognition-names">
                {group.names
                  .filter((n) => n && n.trim())
                  .map((name) => (
                    <li>{name}</li>
                  ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
 
  <!-- 501(c)(3) / EIN note — applies to ALL giving on this page, so it
       sits at the very bottom rather than under the donor tiers. -->
  <section class="section ein-section">
    <div class="container">
      <p class="ein-note">
        Peninsula Youth Theatre is a 501(c)(3) nonprofit. All gifts are tax-deductible to
        the extent allowed by law. EIN 77-0335126.
      </p>
    </div>
  </section>
</BaseLayout>
 
<style>
  /* ---- Light campaign hero with thermometer ---- */
  .campaign-hero {
    background: var(--paper);
  }
 
  .campaign-hero h1 {
    margin-block: 0.6rem var(--space-md);
  }
 
  .campaign-intro {
    color: var(--ink-soft);
    max-width: 60ch;
    font-size: 1.08rem;
    margin-bottom: var(--space-lg);
  }
 
  .section-head {
    margin-block: 0.4rem var(--space-lg);
  }
 
  /* Thermometer + stats laid out side by side (stacks on phones) */
  .thermo-row {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
    margin-top: var(--space-md);
  }
 
  /* Box is the STAR's width, with every piece inside centered on that
     same centerline — so the tube, bulb, star and the stats beside them
     all line up instead of the tube sitting far left inside a box sized
     for the tick labels. Tick labels overhang to the right instead. */
  .thermo {
    position: relative;
    width: 90px;
    height: 331px;
    flex-shrink: 0;
  }
 
  .thermo-tube {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 81px;
    width: 32px;
    height: 210px;
    border: 3px solid var(--accent);
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    overflow: hidden;
  }
 
  .thermo-fill {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--campaign-fill);
    border-radius: 0 0 var(--radius-pill) var(--radius-pill);
    transition: height 0.4s ease;
  }
 
  /* Shares the tube's centerline (was left:12px, which sat the bulb's
     centerline right of the tube's). */
  .thermo-bulb {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--accent);
  }

  /* Interval ticks — own layer (not inside .thermo-tube, which needs
     overflow:hidden for the fill), stopping at the tube's straight
     sides rather than the mathematical top of its rounded cap, wide
     enough to clear the star badge so the top tick doesn't collide
     with it (same reasoning as the home page's version). */
  .thermo-ticks {
    position: absolute;
    left: 50%;
    width: 22px;
    top: 0;
    height: 100%;
  }

  .thermo-tick {
    position: absolute;
    left: 100%;
    transform: translateY(50%);
    display: flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
  }

  .thermo-tick-dash {
    display: inline-block;
    width: 10px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
  }

  .thermo-tick-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--ink);
  }

  /* GOAL star badge — sits on top of the tube's rounded cap (later in
     the DOM = painted on top with default stacking). */
  /* Raised so only its bottom tip overlaps the tube, matching the
     approved mockup's proportion. */
  .thermo-goal-badge {
    position: absolute;
    top: 5px;
    left: 50%;
    transform: translateX(-50%);
    width: 90px;
    height: 90px;
  }

  .thermo-star {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .thermo-star polygon {
    fill: var(--highlight);
    stroke: var(--campaign-fill);
    stroke-width: 4;
    stroke-linejoin: round;
  }

  .thermo-goal-badge-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -55%);
    font-family: var(--font-heading);
    font-size: 0.68rem;
    color: var(--accent);
    text-transform: uppercase;
  }
 
  .thermo-stats {
    flex: 1;
    min-width: 220px;
  }
 
  /* Now the only stat line here (2026-08-20) — the big raised figure
     and the muted "raised of $X goal" line were both removed, matching
     the home page's treatment: hero-lede-style font/weight/color
     instead of the muted gray other captions use. */
  .thermo-meta {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0;
  }
 
  .thermo-meta strong {
    color: var(--accent);
  }
 
  .thermo-donate {
    margin-top: var(--space-md);
    font-size: 1.1rem;
    padding: 0.85rem 2.4rem;
  }
 
  /* ---- Donor tiers ---- */
  .tiers-section {
    background: var(--paper-warm);
    border-top: 1px solid var(--line);
  }

  /* ---- What your gift funds (list under Donor Benefits) ---- */
  .gift-funds-section {
    background: var(--paper-warm);
  }

  .gift-funds-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .gift-funds-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: var(--space-md);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .gift-funds-text {
    flex: 1 1 16rem;
    line-height: 1.4;
  }

  .gift-funds-amount {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--accent);
    font-size: 1.15rem;
  }

  .gift-funds-desc {
    color: var(--ink-soft);
  }

  .gift-funds-btn {
    flex-shrink: 0;
  }
 
  .tier-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }
 
  .tier-card {
    padding: var(--space-md);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
  }

  /* Push the button to the bottom so cards with longer/shorter text
     still line their buttons up evenly. */
  .tier-card .sponsor-btn {
    margin-top: auto;
    align-self: flex-start;
  }

  /* Keep a little breathing room above the button even when text is short. */
  .tier-card .tier-description {
    margin-bottom: var(--space-md);
  }

  .corporate-contact {
    color: var(--ink-soft);
    font-size: 1rem;
    margin-bottom: var(--space-lg);
  }

  .corporate-contact a {
    color: var(--accent);
    font-weight: 600;
  }
 
  .tier-range {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }
 
  .tier-card h3 {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
  }
 
  .tier-description {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
 
  .ein-section {
    border-top: 1px solid var(--line);
  }
 
  .ein-note {
    font-size: 0.85rem;
    color: var(--ink-muted);
    text-align: center;
    margin: 0;
  }
 
  @media (min-width: 720px) {
    .tier-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
 
  @media (min-width: 1024px) {
    .tier-list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
 
  /* ---- Sponsorship section (Shopify) ---- */
  .sponsor-section {
    background: var(--paper);
    border-top: 1px solid var(--line);
  }
 
  /* Only two sponsorship cards — cap at 2 columns even on wide screens */
  .sponsor-list {
    max-width: 760px;
  }
 
  /* Disabled "Coming soon" sponsor button */
  .sponsor-btn.is-disabled {
    background: var(--line);
    color: var(--ink-muted);
    cursor: not-allowed;
    pointer-events: none;
    display: inline-block;
  }
 
  @media (min-width: 1024px) {
    .sponsor-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
 
  /* ---- Phone: stack thermometer above the stats ---- */
  @media (max-width: 600px) {
    .thermo-row {
      gap: var(--space-lg);
    }
  }
 
  /* ---- Corporate Giving ---- */
  .corporate-section {
    background: var(--paper);
    border-top: 1px solid var(--line);
  }
 
  .corporate-intro {
    color: var(--ink-soft);
    max-width: 60ch;
    font-size: 1.05rem;
    margin-bottom: var(--space-lg);
  }
 
  /* ---- Donor & sponsor recognition ---- */
  .recognition-section {
    background: var(--paper-warm);
    border-top: 1px solid var(--line);
  }
 
  .recognition-intro {
    color: var(--ink-soft);
    max-width: 60ch;
    font-size: 1.05rem;
    margin-bottom: var(--space-lg);
  }
 
  .recognition-groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }
 
  .recognition-tier {
    font-size: 1.15rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
  }
 
  .recognition-names {
    list-style: none;
    padding: 0;
    margin: 0;
  }
 
  .recognition-names li {
    font-size: 1rem;
    color: var(--ink);
    padding: 0.2rem 0;
  }
 
  @media (min-width: 720px) {
    .recognition-groups {
      grid-template-columns: repeat(2, 1fr);
    }
  }
 
  @media (min-width: 1024px) {
    .recognition-groups {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
