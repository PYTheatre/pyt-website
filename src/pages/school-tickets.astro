---
/*
  SCHOOL TICKETS PAGE ( /school-tickets ) — NEW, PLACEHOLDER (2026-08-18)

  Built as a simple placeholder so the "Educators" nav item has
  somewhere real to link to. Every word, and the whole list of
  shows, is editable in the CMS at
  /admin → Site Settings → School Tickets Page — nothing on this
  page requires a code change to fill in.

  Each listing is just a title + description + a link (e.g. to a
  booking form or a school-rate ticket page) — add as many as
  needed. The page shows a friendly empty state until the first one
  is added.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import PageHero from "../components/PageHero.astro";
import page from "../content/settings/school-tickets-page.json";

const listings = page.listings || [];
---

<BaseLayout
  title={`${page.title} — Peninsula Youth Theatre`}
  description="Discounted school-trip tickets to PYT shows."
>
  <PageHero
    eyebrow={page.eyebrow}
    title={page.title}
    lede={page.intro}
  />

  <section class="section">
    <div class="container">
      {listings.length > 0 ? (
        <ul class="listing-list">
          {listings.map((show: any) => (
            <li class="listing-card">
              <h3>{show.title}</h3>
              {show.dates && <p class="listing-when">{show.dates}</p>}
              {show.description && <p class="listing-description">{show.description}</p>}
              {show.link_url && (
                <a
                  href={show.link_url}
                  class="btn btn-primary"
                  target={show.link_url.startsWith("http") ? "_blank" : null}
                  rel={show.link_url.startsWith("http") ? "noopener" : null}
                >
                  {show.link_label || "Book tickets"}
                </a>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <>
          <p class="empty-state">{page.empty_state_text}</p>
          {/* Replaced a published contact address (2026-08-20). A ternary
              branch can only return ONE element, so these two are wrapped
              in a fragment. */}
          <ContactForm route="education" source="School Tickets page" subject="School tickets enquiry" submitLabel="Send enquiry" />
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .listing-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .listing-card {
    padding: var(--space-md);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
  }

  .listing-card h3 {
    font-size: 1.25rem;
    margin: 0 0 0.3rem;
  }

  .listing-when {
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin: 0 0 var(--space-sm);
  }

  .listing-description {
    font-size: 0.98rem;
    line-height: 1.6;
    margin: 0 0 var(--space-md);
    flex-grow: 1;
  }

  .listing-card .btn {
    align-self: flex-start;
  }

  .empty-state {
    padding: var(--space-lg);
    background: var(--paper-warm);
    border-radius: var(--radius);
    text-align: center;
    color: var(--ink-muted);
  }

  .empty-state a {
    color: var(--accent-deep);
    text-decoration: underline;
  }

  @media (min-width: 720px) {
    .listing-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
