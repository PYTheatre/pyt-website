---
/*
  HOME PAGE.
 
  Content comes from two CMS-managed sources:
   - src/content/settings/home-page.json — all the editable copy
     (hero, optional hero banner photo, discovery cards, impact
     stats, section headings, etc.)
   - donation-campaign.json — the campaign progress numbers.
 
  Layout/structure lives here in code (not editable via CMS, by
  design — so the page can't be visually broken). All words, links,
  images, and numbers are editable through the CMS.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
import home from "../content/settings/home-page.json";
import campaign from "../content/settings/donation-campaign.json";

// --- Section heading case (2026-08-19) ---
// Every remaining homepage section heading is editable, with a
// per-heading choice of "as typed" or "UPPERCASE". Each falls back to
// a sensible default if the CMS field is blank, so the page never
// renders with an empty heading.
const discovery_heading_case = (home as any).discovery_heading_case || "as-typed";
const impact_heading_case = (home as any).impact_heading_case || "as-typed";
const donate_heading_case = (home as any).donate_heading_case || "as-typed";

// --- Donation campaign numbers ---
const goal = campaign.goal_amount;
const raised = campaign.raised_amount;
const donorCount = campaign.donor_count;
const campaignLabel = campaign.campaign_label;
const pct = Math.round((raised / goal) * 100);
// Thermometer fill height, capped 0–100 so it never overflows the tube.
const fillPct = Math.min(100, Math.max(0, pct));
 
// Donation-teaser heading. CMS-editable (home.donate_heading). If the
// field is empty, fall back to the original goal-based wording so the
// line never renders blank.
const donateHeading = home.donate_heading?.trim() || `Help us reach $${goal.toLocaleString()}.`;
 
// --- Hero heading with optional italic word ---
// The CMS lets staff pick one word in the heading to italicize
// (the accent style). If that word appears in the heading, we
// split around it; otherwise the heading renders plain.
const heading = home.hero_heading;
const italicWord = home.hero_heading_italic_word?.trim();
let headingBefore = heading;
let headingItalic = "";
let headingAfter = "";
if (italicWord && heading.includes(italicWord)) {
  const idx = heading.indexOf(italicWord);
  headingBefore = heading.slice(0, idx);
  headingItalic = italicWord;
  headingAfter = heading.slice(idx + italicWord.length);
}

// --- Force the headline onto two lines, with the word right before
// the accent word joining it on the second line (PM preference: e.g.
// "YOUTH THEATER" / "FOR EVERYONE!" rather than "YOUTH THEATER FOR" /
// "EVERYONE!"). Only kicks in when there's an accent word AND at
// least two words before it; otherwise the heading just wraps
// naturally with no forced break.
let headingLine1 = "";
let headingLine2Lead = "";
if (headingItalic) {
  const trimmed = headingBefore.trimEnd();
  const lastSpaceIdx = trimmed.lastIndexOf(" ");
  if (lastSpaceIdx > 0) {
    headingLine1 = trimmed.slice(0, lastSpaceIdx);
    headingLine2Lead = trimmed.slice(lastSpaceIdx + 1);
  }
}
 
// --- Optional hero banner image (legacy, not currently rendered) ---
const heroImage = (home as any).hero_image || "";

// --- Hero photo strip ---
// A row of clickable photo cards under the intro text, replacing the
// old single wide banner. Each card needs a title and a link; the
// photo is optional (falls back to a colored placeholder showing the
// title, cycling through the brand colors so cards without a photo
// still look intentional rather than broken). Empty-safe: hidden
// entirely if the list is empty or every entry is missing a title/url.
const placeholderColors = ["accent", "brand-blue", "brand-green", "accent-deep", "brand-blue", "brand-green"];
const photoStrip = ((home as any).photo_strip || [])
  .filter((c: any) => c?.title?.trim() && c?.url?.trim())
  .map((c: any, i: number) => ({
    title: c.title,
    url: c.url,
    image: c.image || "",
    colorClass: placeholderColors[i % placeholderColors.length],
  }));

// The carousel is rendered as three back-to-back copies of the same
// cards so it can loop continuously in either direction (see script
// below) — swiping/clicking past either end silently jumps back into
// the middle copy rather than running out of cards.
const loopedPhotoStrip = photoStrip.length > 0 ? [...photoStrip, ...photoStrip, ...photoStrip] : [];
---
 
<BaseLayout title="Peninsula Youth Theatre — Outstanding youth theatre">
  <!-- ============ HERO (intro text) ============ -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-logo-wrap">
          <Logo size="hero" />
        </div>
        <h1 class="hero-heading">
          {headingItalic && headingLine2Lead ? (
            <>
              {headingLine1}<br />
              {headingLine2Lead}{" "}
              <span class="accent-word">
                {headingItalic}
              </span>
              {headingAfter}
            </>
          ) : (
            <>
              {headingBefore}{headingItalic && (
                <span class="accent-word">{headingItalic}</span>
              )}{headingAfter}
            </>
          )}
        </h1>
        <p class="hero-lede">{home.hero_lede}</p>
      </div>
    </div>
 
    <!-- Photo strip / carousel: scrollable row of cards linking to key
         pages. Hidden entirely when there are no valid cards. Cards
         render in CMS order (no shuffle), rendered as three back-to-back
         copies (loopedPhotoStrip) so the carousel loops continuously in
         both directions — see script below. The card nearest the center
         of the viewport becomes the large "hero" image (photo only —
         the caption stays normal size so it's never cut off). Several
         ways to change which card is the hero: swiping, the arrow
         buttons, hovering a non-hero card with a mouse (desktop only —
         real hover devices), or clicking a non-hero card. CLICKING is
         gated (PM preference, 2026-08-19): a click on any card that
         ISN'T currently the hero re-centers it instead of following its
         link; only clicking the card that's already the hero navigates
         through. Always opens centered on the card titled exactly
         "Center Stage Musicals" — matched by that card's title text, so
         keep that title spelled that way if it's ever edited. Both
         arrow buttons and edge fades stay visible at all times on
         desktop (there's no "end" to reach) — on mobile people just
         swipe. -->
    {photoStrip.length > 0 && (
      <div class="container">
        <div class="photo-strip-wrap" id="photo-strip-wrap">
          <button type="button" class="photo-strip-arrow photo-strip-arrow-prev" id="photo-strip-prev" aria-label="Scroll left">‹</button>
          <div class="photo-strip-fade photo-strip-fade-left" aria-hidden="true"></div>

          <div class="photo-strip" id="photo-strip">
            {loopedPhotoStrip.map((card) => (
              <a href={card.url} class="photo-strip-card">
                <div class="photo-strip-photo">
                  {card.image ? (
                    <img src={card.image} alt="" loading="eager" />
                  ) : (
                    <div class={`photo-strip-placeholder c-${card.colorClass}`}></div>
                  )}
                </div>
                <span class="photo-strip-title">{card.title}</span>
              </a>
            ))}
          </div>

          <div class="photo-strip-fade photo-strip-fade-right" aria-hidden="true"></div>
          <button type="button" class="photo-strip-arrow photo-strip-arrow-next" id="photo-strip-next" aria-label="Scroll right">›</button>
        </div>
      </div>
    )}
  </section>

  <script>
    // Looping, centered photo carousel. Cards render as three
    // back-to-back copies of the same set (see loopedPhotoStrip above);
    // whenever the centered card drifts into the first or third copy,
    // we silently jump the scroll position by exactly one set-width in
    // the opposite direction (no animation, same visual frame) so it's
    // always sitting in the middle copy with room to keep scrolling —
    // that's what makes it feel continuous instead of running out.
    //
    // Scale is applied to the PHOTO only, not the whole card, with
    // transform-origin anchored to the photo's bottom edge — so the
    // hero photo grows upward, away from its caption underneath, and
    // the caption itself never resizes or gets crowded/clipped. Uses
    // offsetLeft/offsetWidth/offsetHeight (layout box) for all position
    // math rather than getBoundingClientRect, since those are
    // unaffected by the CSS transform — reading a transformed element's
    // bounding rect would feed its own scaled size back into the next
    // frame's calculation.
    const strip = document.getElementById("photo-strip") as HTMLElement | null;
    const wrap = document.getElementById("photo-strip-wrap");
    const prevBtn = document.getElementById("photo-strip-prev");
    const nextBtn = document.getElementById("photo-strip-next");

    if (strip && wrap) {
      const cards = Array.from(strip.querySelectorAll(".photo-strip-card")) as HTMLElement[];
      const SET_SIZE = cards.length / 3;
      let currentIndex = 0;
      let correcting = false;

      // Custom eased scroll-to, replacing native scrollIntoView's
      // smooth behavior (PM feedback, 2026-08-19: hovering used to
      // feel "too fast and out of control" because every mouseover
      // fired the browser's own default-speed smooth-scroll, and
      // rapid retargeting mid-animation looked jerky). This version is
      // fully self-timed and interruptible: retargeting mid-animation
      // just eases toward the new target from wherever the strip
      // currently is, instead of restarting abruptly.
      let scrollAnimFrame: number | null = null;
      const animateScrollTo = (target: HTMLElement, duration = 550) => {
        if (scrollAnimFrame) cancelAnimationFrame(scrollAnimFrame);
        const startX = strip.scrollLeft;
        const endX = target.offsetLeft + target.offsetWidth / 2 - strip.clientWidth / 2;
        const distance = endX - startX;
        const startTime = performance.now();
        const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
        const step = (now: number) => {
          const elapsed = now - startTime;
          const t = Math.min(1, elapsed / duration);
          strip.scrollLeft = startX + distance * easeInOutCubic(t);
          scrollAnimFrame = t < 1 ? requestAnimationFrame(step) : null;
        };
        scrollAnimFrame = requestAnimationFrame(step);
      };

      // Pad both ends of the track so any card can still reach true
      // center — recalculated on resize since card width differs by
      // breakpoint.
      const updateHorizontalPadding = () => {
        if (!cards.length) return;
        const pad = Math.max(0, (strip.clientWidth - cards[0].offsetWidth) / 2);
        strip.style.paddingLeft = `${pad}px`;
        strip.style.paddingRight = `${pad}px`;
      };

      // All cards are now the SAME size (PM request, 2026-08-19) — the
      // earlier "hero photo scales up" version is gone entirely. The
      // only thing that distinguishes the centered "hero" card from
      // the rest now is opacity, applied to the whole card element
      // (which covers both the photo AND its caption together, since
      // CSS opacity affects an element's full subtree) — not a
      // gradual falloff by distance, just hero = fully opaque,
      // everything else = evenly faded.
      const FADE_OPACITY = "0.4";

      const updateScale = () => {
        if (!cards.length) return;
        const centerX = strip.clientWidth / 2 + strip.scrollLeft;
        let closestDist = Infinity;
        cards.forEach((card, i) => {
          const cardCenter = card.offsetLeft + card.offsetWidth / 2;
          const dist = Math.abs(cardCenter - centerX);
          if (dist < closestDist) {
            closestDist = dist;
            currentIndex = i;
          }
        });
        cards.forEach((card, i) => {
          const isHero = i === currentIndex;
          card.style.opacity = isHero ? "1" : FADE_OPACITY;
          card.style.zIndex = isHero ? "2" : "1";
        });

        // Loop correction: if the centered card has drifted out of the
        // middle copy, jump back into it by exactly one set-width —
        // instant, same visual position — so there's always more to
        // scroll to in either direction.
        if (!correcting && SET_SIZE > 0) {
          if (currentIndex < SET_SIZE) {
            correcting = true;
            const setWidth = cards[currentIndex + SET_SIZE].offsetLeft - cards[currentIndex].offsetLeft;
            strip.scrollLeft += setWidth;
            currentIndex += SET_SIZE;
            requestAnimationFrame(() => { correcting = false; });
          } else if (currentIndex >= SET_SIZE * 2) {
            correcting = true;
            const setWidth = cards[currentIndex].offsetLeft - cards[currentIndex - SET_SIZE].offsetLeft;
            strip.scrollLeft -= setWidth;
            currentIndex -= SET_SIZE;
            requestAnimationFrame(() => { correcting = false; });
          }
        }
      };

      updateHorizontalPadding();

      // Always open centered on "Center Stage Musicals" rather than a
      // random card (PM preference) — and specifically the copy in the
      // MIDDLE set, so there's a full set of cards to scroll to on
      // either side right from the start. Falls back to the first card
      // in the middle set if that title is ever missing or renamed.
      const middleSetCards = cards.slice(SET_SIZE, SET_SIZE * 2);
      const startCard =
        middleSetCards.find(
          (c) =>
            (c.querySelector(".photo-strip-title")?.textContent || "")
              .trim()
              .toLowerCase() === "center stage musicals"
        ) || middleSetCards[0];
      startCard?.scrollIntoView({ inline: "center", block: "nearest" });
      updateScale();

      let scaleQueued = false;
      const queueScale = () => {
        if (scaleQueued) return;
        scaleQueued = true;
        requestAnimationFrame(() => {
          updateScale();
          scaleQueued = false;
        });
      };
      strip.addEventListener("scroll", queueScale, { passive: true });

      window.addEventListener("resize", () => {
        updateHorizontalPadding();
        cards[currentIndex]?.scrollIntoView({ inline: "center", block: "nearest" });
        updateScale();
      });

      // Arrow buttons: step to the next/previous card and re-center it.
      // No edge-hiding logic anymore — the carousel loops continuously,
      // so both arrows (and both edge fades) stay visible at all times
      // on desktop; on mobile people just swipe, same as before.
      if (prevBtn && nextBtn) {
        prevBtn.addEventListener("click", () => {
          const target = cards[currentIndex - 1];
          if (target) animateScrollTo(target, 500);
        });
        nextBtn.addEventListener("click", () => {
          const target = cards[currentIndex + 1];
          if (target) animateScrollTo(target, 500);
        });
      }

      // Hovering a non-hero card (mouse users only — real hover
      // devices) re-centers it, making it the hero. Delegated on the
      // strip so it works for every card without per-card listeners.
      // Two things make this feel slow/controlled rather than the
      // "too fast, out of control" behavior from before (PM feedback,
      // 2026-08-19): (1) a short dwell delay — the mouse has to rest
      // on a card for a moment before it's treated as a deliberate
      // hover, so quickly passing the cursor across several cards
      // doesn't re-trigger a scroll for every single one; (2) the
      // scroll itself now runs over a longer, fixed duration via
      // animateScrollTo rather than the browser's own (fast, and not
      // fully controllable) native smooth-scroll.
      const supportsHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      if (supportsHover) {
        let hoverTimer: number | null = null;
        let pendingCard: HTMLElement | null = null;
        const clearPendingHover = () => {
          if (hoverTimer !== null) {
            clearTimeout(hoverTimer);
            hoverTimer = null;
          }
          pendingCard = null;
        };
        strip.addEventListener("mouseover", (e) => {
          const card = (e.target as HTMLElement)?.closest(".photo-strip-card") as HTMLElement | null;
          if (!card) return;
          const idx = cards.indexOf(card);
          if (idx === -1 || idx === currentIndex || card === pendingCard) return;
          clearPendingHover();
          pendingCard = card;
          hoverTimer = window.setTimeout(() => {
            animateScrollTo(card, 700);
            pendingCard = null;
            hoverTimer = null;
          }, 180);
        });
        strip.addEventListener("mouseleave", clearPendingHover);
      }

      // Clicking a non-hero card re-centers it instead of following its
      // link (PM preference, 2026-08-19) — only the card that's ALREADY
      // the hero navigates through when clicked. Delegated on the strip
      // so it covers every card, including the two extra loop copies.
      strip.addEventListener("click", (e) => {
        const card = (e.target as HTMLElement)?.closest(".photo-strip-card") as HTMLElement | null;
        if (!card) return;
        const idx = cards.indexOf(card);
        if (idx !== -1 && idx !== currentIndex) {
          e.preventDefault();
          animateScrollTo(card, 500);
        }
      });
    }
  </script>
 
  <!-- ============ DISCOVERY CARDS (square photo grid) ============ -->
  <!-- "Find your role" — this now sits directly after the hero. The
       old "Upcoming Shows"/"What's Next" section that used to be here
       was removed entirely (code + CMS fields) per PM request,
       2026-08-19. -->
  <section class="section discovery-section">
    <div class="container">
      <h2 class={`section-head ${discovery_heading_case === "uppercase" ? "case-upper" : ""}`}>{home.discovery_heading}</h2>

      <div class="card-grid">
        {home.discovery_cards.map((card: any, i: number) => (
          <a href={card.url} class="card">
            {card.image ? (
              <img src={card.image} alt="" class="card-photo" loading="lazy" />
            ) : (
              <div class={`card-photo card-photo-placeholder c-${placeholderColors[i % placeholderColors.length]}`}></div>
            )}
            <span class="card-overlay">
              <span class="card-title">{card.title}</span>
              {card.subtitle && <span class="card-subtitle">{card.subtitle}</span>}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
 
  <!-- ============ IMPACT STATS ============ -->
  <section class="section impact">
    <div class="container">
      <h2 class={`section-head ${impact_heading_case === "uppercase" ? "case-upper" : ""}`}>{home.impact_heading}</h2>
 
      <div class="stat-grid">
        {home.stats.map((stat, i) => {
          /* Impact numbers are coloured by POSITION using the three logo
             colours, cycling if there are ever more than three:
             1st = blue, 2nd = green, 3rd = pink. Now also boxed in that
             same colour (PM request, 2026-08-19), on the new dark
             section background. */
          const figureColors = ["var(--brand-blue)", "var(--brand-green)", "var(--accent)"];
          const figureColor = figureColors[i % figureColors.length];
          return (
            <div class="stat" style={`border-color: ${figureColor}`}>
              <p class="stat-figure" style={`color: ${figureColor}`}>{stat.figure}</p>
              <p class="stat-label">{stat.label}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>
 
  <!-- ============ DONATION TEASER ============ -->
  <section class="section donate-teaser">
    <div class="container">
      <h2 class={`section-head ${donate_heading_case === "uppercase" ? "case-upper" : ""}`}>{donateHeading}</h2>
      <p class="donate-lede">{home.donate_lede}</p>
 
      <div class="thermo-row">
        <!-- Thermometer -->
        <div class="thermo" role="img"
             aria-label={`$${raised.toLocaleString()} raised of $${goal.toLocaleString()} goal, ${pct}% complete`}>
          <p class="thermo-goal-label">${goal.toLocaleString()}</p>
          <div class="thermo-tube">
            <div class="thermo-fill" style={`height: ${fillPct}%`}></div>
          </div>
          <div class="thermo-bulb"></div>
        </div>

        <!-- Numbers -->
        <div class="thermo-stats">
          <p class="thermo-raised">${raised.toLocaleString()}</p>
          <p class="thermo-goal">raised of ${goal.toLocaleString()} goal</p>
          <p class="thermo-meta">
            <strong>{donorCount}</strong> donors &middot; <strong>{pct}%</strong> of goal
          </p>
        </div>
      </div>
 
      <div class="donate-teaser-btn-wrap">
        <a href="https://pyt.secure.nonprofitsoapbox.com/donate" class="btn donate-teaser-btn" target="_blank" rel="noopener">{home.donate_button_label}</a>
      </div>
    </div>
  </section>
</BaseLayout>
 
<style>
  /* ---- Hero ---- */
  .hero {
    padding-top: var(--space-xl);
    /* Bottom padding kept small on purpose: the section right after
       (Discovery cards / "Find your role") already has its own
       generous top padding via the shared .section class. Making
       both edges large stacked into an oddly big gap. */
    padding-bottom: var(--space-md);
  }
 
  .hero-heading {
    /* Enlarged from the previous size (PM feedback) — scoped to the
       homepage only, other pages' h1 sizes are unaffected. */
    font-size: clamp(2.2rem, 7vw, 3.8rem);
    margin: 0;
    position: relative;
    grid-column: 1;
    grid-row: 2;
    /* PM tried a few playful font options and picked Baloo 2, caps —
       scoped to just this homepage headline (via font-family here,
       not the shared --font-heading token), so every other heading
       on the site stays on Archivo Black.
       Baloo 2's own font metrics reserve a lot of extra vertical
       space (for lowercase ascenders/descenders this all-caps
       headline never uses), which made the default line spacing
       look oddly loose. line-height is set tight and explicit here
       to compensate — this value was tuned by measuring the font's
       actual rendered letter height directly (not just picked by
       eye), but different headline text/length could still need a
       revisit. */
    font-family: "Baloo 2", var(--font-heading), sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.82;
  }

  /* Logo + headline + intro text, laid out as a small grid so the
     lede lines up under the HEADLINE (not the logo), and the logo's
     own height (set in Logo.astro) matches the headline text block —
     giving a clean top/bottom alignment between logo and headline
     without the logo dwarfing anything. Stacked (logo, then headline,
     then lede, all full width) on phones; side by side once there's
     enough width for it to breathe. */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 0.6rem;
  }

  .hero-logo-wrap {
    grid-column: 1;
    grid-row: 1;
  }

  .hero-lede {
    grid-column: 1;
    grid-row: 3;
  }

  @media (min-width: 720px) {
    .hero-grid {
      grid-template-columns: auto 1fr;
      column-gap: var(--space-lg);
      align-items: center;
    }

    .hero-logo-wrap {
      grid-row: 1;
    }

    .hero-heading {
      grid-column: 2;
      grid-row: 1;
    }

    .hero-lede {
      grid-column: 2;
      grid-row: 2;
    }
  }

  .accent-word {
    position: relative;
  }

  .hero-lede {
    /* Brought up to match the impact of the new bolder look — bigger,
       heavier, and full-strength ink color instead of the muted gray
       paragraphs normally use. Line-height/letter-spacing tightened
       from the site's normal body defaults (1.6 leading, no tracking)
       since at this size+weight the default reads loose — condensed
       to feel more like a headline-adjacent block than body copy. */
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 60ch;
    margin-bottom: var(--space-md);
  }
 
  /* Wide hero banner photo (legacy, not currently rendered — kept in
     case hero_image is reused later) */
  .hero-banner-img {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border-radius: 0;
    display: block;
    margin-top: var(--space-lg);
    margin-bottom: 0;
    box-shadow: var(--shadow-soft);
    max-height: 520px;
  }

  /* ---- Hero photo strip ---- */
  .photo-strip-wrap {
    position: relative;
    margin-top: var(--space-lg);
  }

  .photo-strip {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    overflow-x: auto;
    /* "mandatory" (not "proximity") so the strip always settles on a
       centered card. */
    scroll-snap-type: x mandatory;
    padding: 14px 0 0.6rem;
    -webkit-overflow-scrolling: touch;
    /* Hide the native scrollbar — replaced by the arrow buttons and
       edge fades below. Swiping/dragging still works exactly the
       same either way. */
    scrollbar-width: none;
  }

  .photo-strip::-webkit-scrollbar {
    display: none;
  }

  .photo-strip-fade {
    display: none; /* shown on wider screens only, see media query below */
    position: absolute;
    top: 0;
    bottom: 0.6rem;
    width: 48px;
    pointer-events: none;
    z-index: 1;
  }

  .photo-strip-fade-left {
    left: 0;
    background: linear-gradient(to right, var(--paper), transparent);
  }

  .photo-strip-fade-right {
    right: 0;
    background: linear-gradient(to left, var(--paper), transparent);
  }

  .photo-strip-arrow {
    display: none; /* shown on wider screens only, see media query below */
    position: absolute;
    top: 45%;
    transform: translateY(-50%);
    z-index: 2;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-soft);
  }

  .photo-strip-arrow-prev {
    left: -6px;
  }

  .photo-strip-arrow-next {
    right: -6px;
  }

