---
/*
  HOME PAGE.
 
  Content comes from two CMS-managed sources:
   - src/content/settings/home-page.json — all the editable copy
     (hero, optional hero banner photo, discovery cards, impact
     stats, section headings, etc.)
   - donation-campaign.json — the campaign progress numbers.
 
  Layout/structure lives here in code (not editable via CMS, by
  design — so the page can't be visually broken). All words, links,
  images, and numbers are editable through the CMS.
*/
import { marked } from "marked";
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
import PromoBanner from "../components/PromoBanner.astro";
import home from "../content/settings/home-page.json";
import campaign from "../content/settings/donation-campaign.json";

// --- Section heading case (2026-08-19) ---
// Every remaining homepage section heading is editable, with a
// per-heading choice of "as typed" or "UPPERCASE". Each falls back to
// a sensible default if the CMS field is blank, so the page never
// renders with an empty heading.
const discovery_heading_case = (home as any).discovery_heading_case || "as-typed";
const impact_heading_case = (home as any).impact_heading_case || "as-typed";
const donate_heading_case = (home as any).donate_heading_case || "as-typed";

// --- Values section (2026-08-20) ---
// Heading, intro and the list of phrases are all CMS-editable. Blank
// entries are filtered out so an empty row left in the CMS list can't
// render an empty line.
const valuesHeading = (home as any).values_heading?.trim() || "";
const valuesIntro = (home as any).values_intro?.trim() || "";
const valuesList: string[] = ((home as any).values_list || [])
  .map((v: any) => (typeof v === "string" ? v : v?.phrase || ""))
  .map((s: string) => s.trim())
  .filter(Boolean);
const values_heading_case = (home as any).values_heading_case || "as-typed";

// --- Hero headline case (2026-09-21) ---
// Same "As typed / UPPERCASE" switch as the section headings above.
// Defaults to "as-typed" so the headline shows exactly as written in
// the CMS. Before this, the headline was forced to capitals in CSS
// with no way to turn it off.
const hero_heading_case = (home as any).hero_heading_case || "as-typed";

// --- Donation campaign numbers ---
const goal = campaign.goal_amount;
const raised = campaign.raised_amount;
const donorCount = campaign.donor_count;
const campaignLabel = campaign.campaign_label;
const pct = Math.round((raised / goal) * 100);
// Thermometer fill height, capped 0–100 so it never overflows the tube.
const fillPct = Math.min(100, Math.max(0, pct));

// --- Thermometer: "200k for 2026!" graphic (2026-09-22) ---
// Redrawn from the PM's reference picture ("pyt-carousel-thermometer.png"):
// a big multicoloured title, a horizontal bar with a bulb on the left,
// $50k / $100k / $150k ticks, and a star-shaped GOAL badge at the end.
// It is ONE inline SVG, so the whole drawing scales as a single piece
// from a phone to a desktop and nothing can drift out of line.
//
// SVG coordinates (viewBox 0 0 1000 222): the scale runs from x=55
// ($0) to x=795 (the goal). The fill and the ticks both use toX(), so
// they share one scale by construction.
const THERMO_X0 = 55;
const THERMO_X1 = 795;
const toX = (fraction: number) => THERMO_X0 + (THERMO_X1 - THERMO_X0) * fraction;
const fillX = toX(fillPct / 100);
const tickFractions = [0.25, 0.5, 0.75];
const thermoTicks = tickFractions.map((f) => ({
  // Abbreviated ($50k, not $50,000) so they fit under the bar on phones.
  label: `$${Math.round((goal * f) / 1000)}k`,
  x: toX(f),
}));
// No tick at 100%: the GOAL star marks that end.

// Star badge: a six-point star, 12 corners alternating between an outer
// and inner radius, centred at (900, 111).
const starPoints = Array.from({ length: 12 }, (_, i) => {
  const r = i % 2 === 0 ? 100 : 57.7;
  const a = (Math.PI / 6) * i - Math.PI / 2;
  return `${(900 + r * Math.cos(a)).toFixed(1)},${(111 + r * Math.sin(a)).toFixed(1)}`;
}).join(" ");

// Title, e.g. "200k for 2026!" — built from the campaign settings, so it
// updates itself when the goal or campaign changes in the CMS
// (Support & Fundraising -> Donation Campaign). The year is taken from
// the campaign label ("2026 Annual Campaign"), or this year if the label
// has none. The "200k" part is coloured letter by letter in the four
// logo colours, like the reference picture.
const campaignYear = (campaignLabel || "").match(/\b(20\d\d)\b/)?.[1] || String(new Date().getFullYear());
const goalShort = goal >= 1000 ? `${Math.round(goal / 1000)}k` : `$${goal}`;
const titleColours = ["var(--thermo-c1)", "var(--thermo-c2)", "var(--thermo-c3)", "var(--thermo-c4)"];
const goalChars = [...goalShort].map((ch, i) => ({ ch, colour: titleColours[i % titleColours.length] }));
 
// Donation-teaser heading. CMS-editable (home.donate_heading). BLANK
// NOW MEANS NO HEADING (2026-09-23, PM request: "remove the title from
// the donation section"). It used to fall back to "Help us reach $X.",
// which made the heading impossible to remove from the CMS. The
// section's <h2> is skipped entirely when the field is empty, so no
// empty gap is left behind.
const donateHeading = home.donate_heading?.trim() || "";

// Alignment of the text above the campaign graphic (heading + lede):
// CMS select, "center" (default, how it's always been) or "left"
// (2026-09-23, PM request). Only the text moves; the graphic and the
// Donate button stay centred under it.
const donate_text_align = (home as any).donate_text_align === "left" ? "left" : "center";
 
// --- Hero heading with optional italic word ---
// The CMS lets staff pick one word in the heading to italicize
// (the accent style). If that word appears in the heading, we
// split around it; otherwise the heading renders plain.
// BLANK = NO HEADLINE (2026-09-22, PM request). Clearing "Hero — main
// headline" in the CMS now hides the headline completely: the page shows
// the logo and the intro paragraph with no empty space where the heading
// was. A hidden heading is still given to screen readers and search
// engines (see .sr-only below), because a page with no heading at all is
// both an accessibility fault and bad for search results.
const heading = (home.hero_heading || "").trim();
const hasHeading = heading.length > 0;
// BLANK = NO INTRO PARAGRAPH (2026-09-22, PM request — same pattern as
// the headline above). Clearing "Hero — intro paragraph" in the CMS now
// hides it completely, with no empty gap left behind.
const heroLede = (home.hero_lede || "").trim();
const hasHeroLede = heroLede.length > 0;
const italicWord = home.hero_heading_italic_word?.trim();
let headingBefore = heading;
let headingItalic = "";
let headingAfter = "";
if (italicWord && heading.includes(italicWord)) {
  const idx = heading.indexOf(italicWord);
  headingBefore = heading.slice(0, idx);
  headingItalic = italicWord;
  headingAfter = heading.slice(idx + italicWord.length);
}

// --- Force the headline onto two lines, with the word right before
// the accent word joining it on the second line (PM preference: e.g.
// "YOUTH THEATER" / "FOR EVERYONE!" rather than "YOUTH THEATER FOR" /
// "EVERYONE!"). Only kicks in when there's an accent word AND at
// least two words before it; otherwise the heading just wraps
// naturally with no forced break.
let headingLine1 = "";
let headingLine2Lead = "";
if (headingItalic) {
  const trimmed = headingBefore.trimEnd();
  const lastSpaceIdx = trimmed.lastIndexOf(" ");
  if (lastSpaceIdx > 0) {
    headingLine1 = trimmed.slice(0, lastSpaceIdx);
    headingLine2Lead = trimmed.slice(lastSpaceIdx + 1);
  }
}
 
// --- Optional hero banner image (legacy, not currently rendered) ---
const heroImage = (home as any).hero_image || "";

// --- Hero photo strip ---
// A row of clickable photo cards under the intro text, replacing the
// old single wide banner. Each card needs a title and a link; the
// photo is optional (falls back to a colored placeholder showing the
// title, cycling through the brand colors so cards without a photo
// still look intentional rather than broken). Empty-safe: hidden
// entirely if the list is empty or every entry is missing a title/url.
const placeholderColors = ["accent", "brand-blue", "brand-green", "accent-deep", "brand-blue", "brand-green"];
// Caption text is INLINE MARKDOWN (2026-09-23, PM request): the CMS
// field is a markdown box with only the Bold button, so a single word
// inside a caption can be bold while the rest stays normal. Rendered
// with parseInline so no <p> wrapper sneaks into the <span>. Plain
// text still comes through exactly as typed.
const inlineMd = (v: string): string => marked.parseInline(String(v).trim(), { gfm: true }) as string;
const stripText = (v: string): string => String(v).replace(/[*_`]/g, "").trim();

const photoStrip = ((home as any).photo_strip || [])
  .filter((c: any) => stripText(c?.title || "") && c?.url?.trim())
  .map((c: any, i: number) => ({
    title: inlineMd(c.title),
    url: c.url,
    image: c.image || "",
    colorClass: placeholderColors[i % placeholderColors.length],
  }));

// The carousel is rendered as three back-to-back copies of the same
// cards so it can loop continuously in either direction (see script
// below) — swiping/clicking past either end silently jumps back into
// the middle copy rather than running out of cards.
const loopedPhotoStrip = photoStrip.length > 0 ? [...photoStrip, ...photoStrip, ...photoStrip] : [];
---
 
<BaseLayout title="Peninsula Youth Theatre — Outstanding youth theatre">
  <!-- ============ HERO (intro text) ============ -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-logo-wrap">
          <Logo size="hero" />
        </div>
        {hasHeading ? (
          <h1 class={`hero-heading ${hero_heading_case === "uppercase" ? "hero-heading--upper" : ""}`}>
            {headingItalic && headingLine2Lead ? (
              <>
                {headingLine1}<br />
                {headingLine2Lead}{" "}
                <span class="accent-word">
                  {headingItalic}
                </span>
                {headingAfter}
              </>
            ) : (
              <>
                {headingBefore}{headingItalic && (
                  <span class="accent-word">{headingItalic}</span>
                )}{headingAfter}
              </>
            )}
          </h1>
        ) : (
          <h1 class="sr-only">Peninsula Youth Theatre</h1>
        )}
        {hasHeroLede && <p class="hero-lede">{heroLede}</p>}
      </div>
    </div>

    {/* Optional promo banner ("news tape"). Deliberately OUTSIDE the
        .container above so it runs edge to edge, and placed here —
        after the hero text, before the photo strip — because that is
        where the PM approved it (2026-09-16, "Placement 3").
        Renders nothing at all unless it is switched on in the CMS
        under Home Page -> Promo Banner, so leaving it here is free. */}
    <PromoBanner />
 
    <!-- Photo strip / carousel: scrollable row of cards linking to key
         pages. Hidden entirely when there are no valid cards. Cards
         render in CMS order (no shuffle), rendered as three back-to-back
         copies (loopedPhotoStrip) so the carousel loops continuously in
         both directions — see script below. The card nearest the center
         of the viewport becomes the large "hero" image (photo only —
         the caption stays normal size so it's never cut off). Several
         ways to change which card is the hero: swiping, the arrow
         buttons, hovering a non-hero card with a mouse (desktop only —
         real hover devices), or clicking a non-hero card. CLICKING is
         gated (PM preference, 2026-08-19): a click on any card that
         ISN'T currently the hero re-centers it instead of following its
         link; only clicking the card that's already the hero navigates
         through. Always opens centered on the card titled exactly
         "Center Stage Musicals" — matched by that card's title text, so
         keep that title spelled that way if it's ever edited. Both
         arrow buttons and edge fades stay visible at all times on
         desktop (there's no "end" to reach) — on mobile people just
         swipe. -->
    {photoStrip.length > 0 && (
      <div class="container">
        <div class="photo-strip-wrap" id="photo-strip-wrap">
          <button type="button" class="photo-strip-arrow photo-strip-arrow-prev" id="photo-strip-prev" aria-label="Previous photo">‹</button>

          <div class="photo-strip" id="photo-strip">
            {loopedPhotoStrip.map((card) => (
              <a href={card.url} class="photo-strip-card">
                <div class="photo-strip-photo">
                  {card.image ? (
                    <img src={card.image} alt="" loading="eager" />
                  ) : (
                    <div class={`photo-strip-placeholder c-${card.colorClass}`}></div>
                  )}
                </div>
                <span class="photo-strip-title" set:html={card.title} />
              </a>
            ))}
          </div>

          <button type="button" class="photo-strip-arrow photo-strip-arrow-next" id="photo-strip-next" aria-label="Next photo">›</button>
        </div>
      </div>
    )}
  </section>

  <script>
    // Looping, centered photo carousel. Cards render as three
    // back-to-back copies of the same set (see loopedPhotoStrip above);
    // whenever the centered card drifts into the first or third copy,
    // we silently jump the scroll position by exactly one set-width in
    // the opposite direction (no animation, same visual frame) so it's
    // always sitting in the middle copy with room to keep scrolling —
    // that's what makes it feel continuous instead of running out.
    //
    // Scale is applied to the PHOTO only, not the whole card, with
    // transform-origin anchored to the photo's bottom edge — so the
    // hero photo grows upward, away from its caption underneath, and
    // the caption itself never resizes or gets crowded/clipped. Uses
    // offsetLeft/offsetWidth/offsetHeight (layout box) for all position
    // math rather than getBoundingClientRect, since those are
    // unaffected by the CSS transform — reading a transformed element's
    // bounding rect would feed its own scaled size back into the next
    // frame's calculation.
    const strip = document.getElementById("photo-strip") as HTMLElement | null;
    const wrap = document.getElementById("photo-strip-wrap");
    const prevBtn = document.getElementById("photo-strip-prev");
    const nextBtn = document.getElementById("photo-strip-next");

    if (strip && wrap) {
      const cards = Array.from(strip.querySelectorAll(".photo-strip-card")) as HTMLElement[];
      const SET_SIZE = cards.length / 3;
      let currentIndex = 0;
      let correcting = false;

      // Custom eased scroll-to, replacing native scrollIntoView's
      // smooth behavior (PM feedback, 2026-08-19: hovering used to
      // feel "too fast and out of control" because every mouseover
      // fired the browser's own default-speed smooth-scroll, and
      // rapid retargeting mid-animation looked jerky). This version is
      // fully self-timed and interruptible: retargeting mid-animation
      // just eases toward the new target from wherever the strip
      // currently is, instead of restarting abruptly.
      let scrollAnimFrame: number | null = null;
      const animateScrollTo = (target: HTMLElement, duration = 550) => {
        if (scrollAnimFrame) cancelAnimationFrame(scrollAnimFrame);
        const startX = strip.scrollLeft;
        const endX = target.offsetLeft + target.offsetWidth / 2 - strip.clientWidth / 2;
        const distance = endX - startX;
        const startTime = performance.now();
        const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
        const step = (now: number) => {
          const elapsed = now - startTime;
          const t = Math.min(1, elapsed / duration);
          strip.scrollLeft = startX + distance * easeInOutCubic(t);
          scrollAnimFrame = t < 1 ? requestAnimationFrame(step) : null;
        };
        scrollAnimFrame = requestAnimationFrame(step);
      };

      // Pad both ends of the track so any card can still reach true
      // center — recalculated on resize since card width differs by
      // breakpoint.
      const updateHorizontalPadding = () => {
        if (!cards.length) return;
        const pad = Math.max(0, (strip.clientWidth - cards[0].offsetWidth) / 2);
        strip.style.paddingLeft = `${pad}px`;
        strip.style.paddingRight = `${pad}px`;
      };

      // All cards are now the SAME size (PM request, 2026-08-19) — the
      // earlier "hero photo scales up" version is gone entirely. The
      // only thing that distinguishes the centered "hero" card from
      // the rest now is opacity, applied to the whole card element
      // (which covers both the photo AND its caption together, since
      // CSS opacity affects an element's full subtree) — not a
      // gradual falloff by distance, just hero = fully opaque,
      // everything else = evenly faded.
      //
      // FULL-WIDTH SLIDES (2026-09-21, PM-approved mockup
      // "MOCKUP-carousel-1-options", option A): each card is now the full
      // width of the strip, so the neighbours sit just outside the visible
      // area and are only seen mid-slide. Dimming them no longer does
      // anything useful and made a photo slide in washed-out, so the fade
      // is now "1" (off). The is-featured class below still matters: it is
      // what shows the centred photo in full colour (duotone scheme) —
      // an incoming photo slides in duotone and blooms into colour.
      const FADE_OPACITY = "1";

      const updateScale = () => {
        if (!cards.length) return;
        const centerX = strip.clientWidth / 2 + strip.scrollLeft;
        let closestDist = Infinity;
        cards.forEach((card, i) => {
          const cardCenter = card.offsetLeft + card.offsetWidth / 2;
          const dist = Math.abs(cardCenter - centerX);
          if (dist < closestDist) {
            closestDist = dist;
            currentIndex = i;
          }
        });
        cards.forEach((card, i) => {
          const isHero = i === currentIndex;
          card.style.opacity = isHero ? "1" : FADE_OPACITY;
          // Duotone photos (2026-09-21): the featured card's photo shows
          // in FULL COLOUR; the rest stay duotone. The styling lives in
          // global.css ("DUOTONE PHOTOS") and keys off this class.
          card.classList.toggle("is-featured", isHero);
          card.style.zIndex = isHero ? "2" : "1";
        });

        // Loop correction: if the centered card has drifted out of the
        // middle copy, jump back into it by exactly one set-width —
        // instant, same visual position — so there's always more to
        // scroll to in either direction.
        if (!correcting && SET_SIZE > 0) {
          if (currentIndex < SET_SIZE) {
            correcting = true;
            const setWidth = cards[currentIndex + SET_SIZE].offsetLeft - cards[currentIndex].offsetLeft;
            strip.scrollLeft += setWidth;
            currentIndex += SET_SIZE;
            requestAnimationFrame(() => { correcting = false; });
          } else if (currentIndex >= SET_SIZE * 2) {
            correcting = true;
            const setWidth = cards[currentIndex].offsetLeft - cards[currentIndex - SET_SIZE].offsetLeft;
            strip.scrollLeft -= setWidth;
            currentIndex -= SET_SIZE;
            requestAnimationFrame(() => { correcting = false; });
          }
        }
      };

      // Center a card by setting the strip's own scrollLeft directly,
      // rather than scrollIntoView. scrollIntoView scrolls EVERY
      // scrollable ancestor as needed — including the page itself — so
      // on a phone it could yank the whole page vertically. Combined
      // with the resize handler below (which mobile browsers fire every
      // time the address bar shows/hides during a normal scroll), that
      // was causing the page to visibly jump around while scrolling.
      // Setting scrollLeft only ever moves the strip horizontally.
      const centerCardInstantly = (card: HTMLElement | undefined | null) => {
        if (!card) return;
        strip.scrollLeft = card.offsetLeft + card.offsetWidth / 2 - strip.clientWidth / 2;
      };

      updateHorizontalPadding();

      // Always open centered on "Center Stage Musicals" rather than a
      // random card (PM preference) — and specifically the copy in the
      // MIDDLE set, so there's a full set of cards to scroll to on
      // either side right from the start. Falls back to the first card
      // in the middle set if that title is ever missing or renamed.
      const middleSetCards = cards.slice(SET_SIZE, SET_SIZE * 2);
      const startCard =
        middleSetCards.find(
          (c) =>
            (c.querySelector(".photo-strip-title")?.textContent || "")
              .trim()
              .toLowerCase() === "center stage musicals"
        ) || middleSetCards[0];
      centerCardInstantly(startCard);
      updateScale();

      let scaleQueued = false;
      const queueScale = () => {
        if (scaleQueued) return;
        scaleQueued = true;
        requestAnimationFrame(() => {
          updateScale();
          scaleQueued = false;
        });
      };
      strip.addEventListener("scroll", queueScale, { passive: true });

      // Only react to WIDTH changes. Mobile browsers fire `resize`
      // constantly during normal page scrolling as the address bar
      // collapses/expands — that's a height-only change that doesn't
      // affect this layout at all, but re-centering on every one of
      // them is what made the carousel feel like it was glitching and
      // fighting the user mid-scroll.
      let lastWidth = window.innerWidth;
      window.addEventListener("resize", () => {
        if (window.innerWidth === lastWidth) return;
        lastWidth = window.innerWidth;
        updateHorizontalPadding();
        centerCardInstantly(cards[currentIndex]);
        updateScale();
      });

      // Arrow buttons: step to the next/previous card and re-center it.
      // No edge-hiding logic — the carousel loops continuously, so both
      // arrows (and both edge fades) stay visible at all times. Shown on
      // phones as well as desktop as of 2026-08-20, so there's a visible
      // cue that more photos exist rather than relying on swipe discovery.
      if (prevBtn && nextBtn) {
        prevBtn.addEventListener("click", () => {
          const target = cards[currentIndex - 1];
          if (target) animateScrollTo(target, 500);
        });
        nextBtn.addEventListener("click", () => {
          const target = cards[currentIndex + 1];
          if (target) animateScrollTo(target, 500);
        });
      }

      // Hovering a non-hero card (mouse users only — real hover
      // devices) re-centers it, making it the hero. Delegated on the
      // strip so it works for every card without per-card listeners.
      // Two things make this feel slow/controlled rather than the
      // "too fast, out of control" behavior from before (PM feedback,
      // 2026-08-19): (1) a short dwell delay — the mouse has to rest
      // on a card for a moment before it's treated as a deliberate
      // hover, so quickly passing the cursor across several cards
      // doesn't re-trigger a scroll for every single one; (2) the
      // scroll itself now runs over a longer, fixed duration via
      // animateScrollTo rather than the browser's own (fast, and not
      // fully controllable) native smooth-scroll.
      const supportsHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      if (supportsHover) {
        let hoverTimer: number | null = null;
        let pendingCard: HTMLElement | null = null;
        const clearPendingHover = () => {
          if (hoverTimer !== null) {
            clearTimeout(hoverTimer);
            hoverTimer = null;
          }
          pendingCard = null;
        };
        strip.addEventListener("mouseover", (e) => {
          const card = (e.target as HTMLElement)?.closest(".photo-strip-card") as HTMLElement | null;
          if (!card) return;
          const idx = cards.indexOf(card);
          if (idx === -1 || idx === currentIndex || card === pendingCard) return;
          clearPendingHover();
          pendingCard = card;
          hoverTimer = window.setTimeout(() => {
            animateScrollTo(card, 700);
            pendingCard = null;
            hoverTimer = null;
          }, 180);
        });
        strip.addEventListener("mouseleave", clearPendingHover);
      }

      // Clicking a non-hero card re-centers it instead of following its
      // link (PM preference, 2026-08-19) — only the card that's ALREADY
      // the hero navigates through when clicked. Delegated on the strip
      // so it covers every card, including the two extra loop copies.
      strip.addEventListener("click", (e) => {
        const card = (e.target as HTMLElement)?.closest(".photo-strip-card") as HTMLElement | null;
        if (!card) return;
        const idx = cards.indexOf(card);
        if (idx !== -1 && idx !== currentIndex) {
          e.preventDefault();
          animateScrollTo(card, 500);
        }
      });
    }
  </script>
 
  <!-- ============ DISCOVERY CARDS (square photo grid) ============ -->
  <!-- "Find your role" — this now sits directly after the hero. The
       old "Upcoming Shows"/"What's Next" section that used to be here
       was removed entirely (code + CMS fields) per PM request,
       2026-08-19. -->
  <section class="section discovery-section">
    <div class="container">
      <div class="discovery-header-row">
        <h2 class={`section-head ${discovery_heading_case === "uppercase" ? "case-upper" : ""}`}>{home.discovery_heading}</h2>
        <!-- Calendar link (2026-08-19) — sits next to this heading,
             matching the green ring-tab styling of the Calendar nav
             button (see Header.astro's .calendar-btn) so the two read
             as the same feature wherever you spot them. -->
        <a href="/calendar" class="calendar-link-btn">Calendar</a>
      </div>

      <div class="card-grid">
        {home.discovery_cards.map((card: any, i: number) => (
          <a href={card.url} class="card">
            {card.image ? (
              <img src={card.image} alt="" class="card-photo" loading="lazy" />
            ) : (
              <div class={`card-photo card-photo-placeholder c-${placeholderColors[i % placeholderColors.length]}`}></div>
            )}
            <span class="card-overlay">
              <span class="card-title">{card.title}</span>
              {card.subtitle && <span class="card-subtitle">{card.subtitle}</span>}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
 
  <!-- ============ IMPACT STATS ============ -->
  {(home.impact_heading?.trim() || (home.stats || []).length > 0) && (
  <section class="section impact">
    <div class="container">
      {home.impact_heading?.trim() && (
        <h2 class={`section-head ${impact_heading_case === "uppercase" ? "case-upper" : ""}`}>{home.impact_heading}</h2>
      )}
 
      {/* Hide the grid entirely when there are no stats, rather than
          leaving an empty grid under the heading. */}
      {(home.stats || []).filter((s) => s?.figure?.trim() || s?.label?.trim()).length > 0 && (
      <div class="stat-grid">
        {(home.stats || []).filter((s) => s?.figure?.trim() || s?.label?.trim()).map((stat, i) => {
          /* DUOTONE (2026-09-21): every stat box is the same PALE TEAL
             with deep-teal type, sitting on the deep-teal band. Until then
             each box cycled through blue / green / pink / gold; that
             multicolour look is exactly what the duotone scheme removes.
             The colour now lives in the .stat CSS rule, not here. */
          return (
            <div class="stat">
              <p class="stat-figure">{stat.figure}</p>
              <p class="stat-label">{stat.label}</p>
            </div>
          );
        })}
      </div>
      )}
    </div>
  </section>
  )}
 
  <!-- ============ VALUES ============ -->
  <!-- Added 2026-08-20, sits between "PYT in numbers" and the donation
       section. Heading, intro and the value phrases themselves are all
       CMS-editable; the whole section hides if the heading and phrases
       are both empty, so it can be switched off without leaving a gap. -->
  {(valuesHeading || valuesList.length > 0) && (
    <section class="section values">
      <div class="container">
        {valuesHeading && (
          <h2 class={`section-head ${values_heading_case === "uppercase" ? "case-upper" : ""}`}>{valuesHeading}</h2>
        )}
        {valuesIntro && <p class="values-intro">{valuesIntro}</p>}

        {valuesList.length > 0 && (
          <ul class="values-list">
            {valuesList.map((phrase, i) => {
              /* Coloured by POSITION in pastel tints of the three logo
                 colours, cycling if there are ever more than three —
                 same approach as the impact figures above, so a fourth
                 value doesn't need a code change or a colour field in
                 the CMS. */
              const pastels = ["var(--values-pink)", "var(--values-blue)", "var(--values-green)"];
              return (
                <li class="values-item" style={`color: ${pastels[i % pastels.length]}`}>{phrase}</li>
              );
            })}
          </ul>
        )}
      </div>
    </section>
  )}

  <!-- ============ DONATION TEASER ============ -->
  <section class={`section donate-teaser donate-text-${donate_text_align}`}>
    <div class="container">
      {donateHeading && (
        <h2 class={`section-head ${donate_heading_case === "uppercase" ? "case-upper" : ""}`}>{donateHeading}</h2>
      )}
      <p class="donate-lede">{home.donate_lede}</p>
 
      <!-- Campaign graphic (2026-09-22). The title is real text; the
           drawing below it is one SVG with a role="img" label, so screen
           readers hear the actual figures ($ raised, goal, %, donors)
           even though they're no longer printed as a line of text. -->
      <p class="thermo-title">
        {goalChars.map((c) => <span style={`color: ${c.colour}`}>{c.ch}</span>)}
        {" "}for {campaignYear}!
      </p>

      <svg class="thermo" viewBox="0 0 1000 222" role="img"
           aria-label={`$${raised.toLocaleString()} raised of $${goal.toLocaleString()} goal, ${pct}% complete, from ${donorCount} donors`}>
        <defs>
          <clipPath id="thermo-inner">
            <rect x="59" y="76" width="732" height="70" rx="35" />
          </clipPath>
        </defs>
        <!-- tube: white inside, magenta outline -->
        <rect x="54.5" y="71.5" width="741" height="79" rx="39.5" fill="#ffffff" stroke="var(--thermo-outline)" stroke-width="9" />
        <!-- fill, clipped to the tube's rounded inside -->
        <rect x="0" y="76" width={fillX} height="70" fill="var(--thermo-fill)" clip-path="url(#thermo-inner)" />
        <!-- bulb -->
        <circle cx="56" cy="111" r="56" fill="var(--thermo-fill)" />
        <!-- ticks -->
        {thermoTicks.map((t) => (
          <g aria-hidden="true">
            <line x1={t.x} y1="155" x2={t.x} y2="170" stroke="var(--thermo-tick)" stroke-width="3" />
            <text x={t.x} y="200" text-anchor="middle" class="thermo-tick-label">{t.label}</text>
          </g>
        ))}
        <!-- GOAL star -->
        <polygon points={starPoints} fill="var(--thermo-star)" stroke="var(--thermo-fill)" stroke-width="10" stroke-linejoin="miter" />
        <text x="900" y="124" text-anchor="middle" class="thermo-goal-text" aria-hidden="true">GOAL</text>
      </svg>

      <div class="donate-teaser-btn-wrap">
        <a href="https://pyt.secure.nonprofitsoapbox.com/donate" class="btn donate-teaser-btn" target="_blank" rel="noopener">{home.donate_button_label}</a>
      </div>
    </div>
  </section>
</BaseLayout>
 
<style>
  /* Values band (2026-08-21). Its ground is --paper-warm, which is the
     TEAL WASH since the duotone scheme (2026-09-21; lilac before).

     ⚠️ THE THREE WORD COLOURS ARE A DELIBERATE EXCEPTION TO DUOTONE.
     The PM asked for "BE KIND / BE PREPARED / BE BRAVE" to keep their
     pink / blue / green when everything else went to two colours. Don't
     "fix" them to teal.

     They are DEEPENED brand colours, not pastels: pastels on a pale
     ground measure ~1.5-2.2 contrast, under the 3.0 minimum for large
     display text. On the teal wash they measure pink 6.1, blue 4.0,
     green 4.2 (all pass). Do NOT move this band onto the stronger pale
     teal (--surface-brand): the blue falls to 3.05 there and merges
     visually into the teal behind it. */
  .values {
    --values-pink: #a82169;
    --values-blue: #2f7fa3;
    --values-green: #4a8038;
    /* Same token as every other panel on the site, so the Values band
       and the panels elsewhere can never drift apart. */
    background: var(--paper-warm);
  }

  /* ---- Hero ---- */
  .hero {
    /* Matches the top padding of every other band on the page. This is
       bumped to --space-2xl at >=720px in the media query below,
       because .section does exactly the same switch — before that,
       .hero sat 2rem tighter under the nav than any other section. */
    padding-top: var(--space-xl);
    /* ZERO on purpose (2026-08-22). The gap below the carousel is now
       supplied ENTIRELY by the following .section's own padding-top,
       which is exactly how the Discovery -> Impact gap already works.

       History, because this has been "fixed" once already and the old
       comment here was wrong: the value used to be --space-xl (4rem).
       On mobile that was right — .section's padding is also --space-xl
       there, so 4 + 4 = 8rem and the gap matched. But .section switches
       to --space-2xl (6rem) at >=720px and .hero did not, so on DESKTOP
       the gap came out at 4 + 6 = 10rem (~187px measured) against 6rem
       (96px) everywhere else — visibly the largest gap on the page.
       Setting this to 0 evens it at BOTH breakpoints in one value, so
       there is no need for a second responsive rule here. If you ever
       reintroduce padding on this edge, check it at >=720px too. */
    padding-bottom: 0;
  }
 
  .hero-heading {
    /* SIZE (2026-09-16). Was clamp(2.2rem, 7vw, 3.8rem) when this
       headline was set in Baloo 2. Archivo Black is a much wider face
       — measured at +28.3% for the current headline string — so the
       old maximum no longer fits on one line at desktop.
       3.4rem is the chosen maximum. It leaves ~72px of spare width in
       the 1060px hero column (~52px at the 1120px breakpoint).
       DO NOT raise this to 3.6rem: it also fits, but with 2.1px to
       spare, which is the same knife-edge that caused the nav-wrap
       bug. Any CMS edit to the headline would tip it over.
       The 2.0rem minimum (was 2.2rem) keeps the rendered capital
       height at 22.4px on a 320px phone against 22.5px before, i.e.
       optically identical, while letting 360px and 390px phones hold
       the headline to two lines. */
    font-size: clamp(2.0rem, 6.2vw, 3.4rem);
    margin: 0;
    position: relative;
    grid-column: 1;
    grid-row: 2;
    /* FONT (2026-09-16). Reverted to the shared --font-heading token
       (Archivo Black) at the PM's request, so this headline matches
       every other heading on the site. It was previously Baloo 2,
       hard-coded here rather than via the token; using the token now
       means this headline follows any future site-wide heading change
       automatically.

       WEIGHT IS 400, NOT 700, AND THAT IS DELIBERATE. Archivo Black
       ships a single weight. Asking for 700 does not make it bolder —
       the browser fakes it, smearing the letterforms (measured:
       identical width, 2px taller, visibly muddier). The face is
       already very heavy; 400 is its real weight.

       LINE-HEIGHT. The old 0.82 was tuned to Baloo 2, which reserves
       unusual amounts of vertical space in its own metrics. Archivo
       Black does not, so 0.82 would be too tight. 0.88 was calculated
       from the two fonts' actual rendered cap heights (Baloo 2 0.64em,
       Archivo Black 0.70em) to preserve the same visual gap between
       wrapped lines rather than being picked by eye.

       ⚠️ If you re-measure any of this, see §3.1 of the handover:
       Archivo Black loads from Google Fonts and will NOT be present in
       a sandboxed headless browser. document.fonts.check() returns
       true for the fallback and will lie to you. */
    font-family: var(--font-heading);
    font-weight: 400;
    /* CASE + LINE-HEIGHT (2026-09-21). No text-transform here any
       more: the headline shows AS TYPED unless "UPPERCASE" is chosen
       in the CMS (Home Page -> Hero — headline capitalization), which
       adds .hero-heading--upper below.

       Line-height has to differ between the two, and was measured
       with the real font (Archivo Black, per 100px of type):
         capitals          reach 70 above the baseline, ~1 below
         lowercase         tallest ascender 74 above, deepest
                           descender (g j p q y) 21 below
       So in mixed case a tail on one line and a tall letter on the
       next need 95/100 of the font size between baselines.
         0.88 -> they OVERLAP by 7  (fine for capitals only)
         0.95 -> they touch
         1.05 -> 10 clear  <- used for as-typed
       ⚠️ DO NOT "tidy" these into one value. 0.88 for everything
       makes lowercase tails crash into the line below; 1.05 for
       everything makes an all-caps headline look gappy. */
    line-height: 1.05;
  }

  .hero-heading--upper {
    text-transform: uppercase;
    /* Capitals only — no descenders — so the tighter value calculated
       on 2026-09-16 (cap heights of Baloo 2 vs Archivo Black) still
       applies. See the note above. */
    line-height: 0.88;
  }

  /* Logo + headline + intro text, laid out as a small grid so the
     lede lines up under the HEADLINE (not the logo), and the logo's
     own height (set in Logo.astro) matches the headline text block —
     giving a clean top/bottom alignment between logo and headline
     without the logo dwarfing anything. Stacked (logo, then headline,
     then lede, all full width) on phones; side by side once there's
     enough width for it to breathe. */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    /* MOBILE spacing (2026-08-23). Was 0.6rem, which read as cramped on
       a phone for the same reason it did on desktop: .hero-heading has
       line-height 0.82, so its box is SHORTER than the letters inside
       it and the ink overflows top and bottom. A gap set here is
       box-to-box, so it buys noticeably less optical space than the
       number suggests — 1.4rem lands at roughly 0.7rem of visible air.
       The >=720px rule below raises this again for desktop. */
    row-gap: 1.4rem;
  }

  .hero-logo-wrap {
    grid-column: 1;
    grid-row: 1;
    /* The logo -> headline step wants to be larger than the
       headline -> lede step, and row-gap is a single value for the
       whole grid, so the difference is added here. Raised again at
       >=720px. */
    margin-bottom: 0.7rem;
  }

  .hero-lede {
    grid-column: 1;
    grid-row: 3;
  }

  @media (min-width: 720px) {
    /* Hero top padding tracks .section, which also switches to
       --space-2xl at this breakpoint. See the note on .hero above. */
    .hero {
      padding-top: var(--space-2xl);
    }

    /* CENTRED HERO (PM choice, 2026-08-22 — "Option B").
       This used to be a two-column `auto 1fr` grid with the logo beside
       the headline. It is now a single centred column at every width:
       logo, then headline, then lede, all centred over the carousel
       below. The stacking order is already correct in the base (mobile)
       rules, so this only needs to STOP the old two-column switch and
       add the centring — the grid-row assignments are inherited.

       Note the row-gap: the headline's line-height is 0.82, so its box
       is SHORTER than the letters it contains and the ink overflows top
       and bottom. That is why the old 0.6rem gap read as the lede being
       jammed into the headline's descenders. Anything set here is
       box-to-box, so it buys less optical space than the number
       suggests — 1.9rem lands at roughly 1.1rem of visible air. */
    /* LEFT-ALIGNED ON DESKTOP TOO (2026-09-22, PM request): the logo,
       headline and intro paragraph all sit on the page's left edge, the
       way they already did on phones. This replaces justify-items:
       center / text-align: center. */
    .hero-grid {
      grid-template-columns: 1fr;
      justify-items: start;
      text-align: left;
      row-gap: 1.9rem;
    }

    /* Extra space under the logo only. The logo -> headline step wants
       to be bigger than the headline -> lede step, and row-gap is a
       single value for the whole grid, so the difference is added here
       rather than by splitting the grid up. */
    .hero-logo-wrap {
      margin-bottom: 1.1rem;
    }

    .hero-lede {
      /* 75ch was chosen when this block was CENTRED and needed to look
         wide enough against the carousel. Left-aligned (2026-09-22) it
         reads better at the site's ordinary reading measure, which is
         also what the phone layout uses. */
      max-width: 60ch;
    }
  }

  .accent-word {
    position: relative;
  }

  .hero-lede {
    /* Bigger than an ordinary paragraph and in full-strength ink, but
       NORMAL WEIGHT (2026-09-22, PM request: body copy on this page is
       no longer semi-bold). Line-height and letter-spacing stay tighter
       than the site default, which suits the larger size. */
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 60ch;
    margin-bottom: var(--space-md);
  }
 
  /* Wide hero banner photo (legacy, not currently rendered — kept in
     case hero_image is reused later) */
  .hero-banner-img {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border-radius: 0;
    display: block;
    margin-top: var(--space-lg);
    margin-bottom: 0;
    box-shadow: var(--shadow-soft);
    max-height: 520px;
  }

  /* ---- Hero photo strip ---- */
  .photo-strip-wrap {
    position: relative;
    margin-top: var(--space-lg);
    /* ONE THIRD SMALLER (2026-09-22, PM-approved mockup
       "MOCKUP-carousel-smaller-desktop", option A): the photo was the full
       content width (1060 x 707px on a laptop) and ran well below the fold.
       Capping the whole carousel at 720px and centring it under the centred
       headline makes the photo 720 x 480px, with the whole picture still
       shown (same 3:2 shape, nothing extra cropped). Phones are narrower
       than 720px, so they are unchanged. Change the size HERE only — the
       slides, arrows and script all follow this width automatically. */
    max-width: 720px;
    margin-inline: auto;
  }

  .photo-strip {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    overflow-x: auto;
    /* "mandatory" (not "proximity") so the strip always settles on a
       centered card. */
    scroll-snap-type: x mandatory;
    padding: 14px 0 0.6rem;
    -webkit-overflow-scrolling: touch;
    /* Hide the native scrollbar — replaced by the arrow buttons and
       edge fades below. Swiping/dragging still works exactly the
       same either way. */
    scrollbar-width: none;
  }

  .photo-strip::-webkit-scrollbar {
    display: none;
  }

  .photo-strip-arrow {
    /* Visible at every width as of 2026-08-20 (was desktop-only, with
       the mobile rule added separately — which left a dead zone between
       641px and 719px where neither rule applied and the arrows silently
       vanished). Making "shown" the default and only varying the SIZE
       per breakpoint removes that gap entirely. */
    display: flex;
    position: absolute;
    /* Centred on the PHOTOS, not on the whole strip (2026-08-23).
       Percentages here were measured against .photo-strip-wrap, which
       is taller than the images because it also contains the strip's
       own top padding and the caption underneath — so 45% (and 33% on
       wide screens) sat visibly above or below the true middle of the
       picture, and the two breakpoints disagreed with each other.

       Instead of guessing a percentage: pin the button between the top
       of the photos and the top of the captions, then let `margin-block:
       auto` centre it in exactly that band. The offsets are the strip's
       own padding and the caption block, written as the same values
       those rules use, so if the caption size changes this follows it.
         top    = .photo-strip padding-top
         bottom = .photo-strip padding-bottom
                + .photo-strip-title margin-top
                + one line of .photo-strip-title (0.95rem x 1.25)
       This needs no knowledge of the card width, so it holds at every
       breakpoint and needs no per-breakpoint override. */
    top: 14px;
    bottom: calc(0.6rem + 0.6rem + (0.95rem * 1.25));
    margin-block: auto;
    /* z-index 3, ABOVE the featured card (which the script lifts to 2).
       At 2 the prev arrow — earlier in the page than the strip — was
       drawn UNDER the photo wherever they overlapped, which hid it on
       phones and, at full width, on every screen size. (2026-09-21) */
    z-index: 3;
    /* Sized up with the full-width photo (was 34px) so it doesn't look
       lost against a picture over 1000px wide. */
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-soft);
  }

  /* Inset over the photo's edges — there is no margin to sit in any
     more, since the photo runs the full width of the strip. */
  .photo-strip-arrow-prev {
    left: 16px;
  }

  .photo-strip-arrow-next {
    right: 16px;
  }

  /* (The white edge fades that used to sit over the peeking neighbour
     photos were removed 2026-09-21 — at full width nothing peeks in.) */

  .photo-strip-card {
    /* FULL WIDTH (2026-09-21, PM/team request): one photo fills the whole
       strip, arrows either side, no glimpse of the neighbours. Was a
       fixed 500px with the next photos peeking in. The script's
       updateHorizontalPadding() now always computes 0 padding, because
       (strip width - card width) / 2 = 0 — which is what keeps a 100%
       card from measuring itself against a padded strip. */
    flex: 0 0 100%;
    display: block;
    scroll-snap-align: center;
    transition: opacity 0.25s ease;
  }

  .photo-strip-photo {
    /* 3:2 (was 4:3), chosen 2026-09-21: it matches most of the carousel's
       photos, so at full width almost nothing is cropped. 1060 x 707px
       on a laptop. 16:9 was mocked as the shorter alternative and not
       chosen — it clipped heads on the Center Stage photo.
       PHOTOS NEED TO BE AT LEAST ~2000px WIDE to stay sharp at this size
       on Retina screens. */
    aspect-ratio: 3 / 2;
    border-radius: 0;
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .photo-strip-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .photo-strip-placeholder {
    width: 100%;
    height: 100%;
  }

  .photo-strip-placeholder.c-accent { background: var(--accent); }
  .photo-strip-placeholder.c-accent-deep { background: var(--accent-deep); }
  .photo-strip-placeholder.c-brand-blue { background: var(--brand-blue); }
  .photo-strip-placeholder.c-brand-green { background: var(--brand-green); }

  .photo-strip-title {
    display: block;
    margin-top: 0.6rem;
    /* BODY FONT, NOT THE HEADING FONT (2026-09-23). Archivo Black only
