---
/*
  HOME PAGE.
 
  Content comes from two CMS-managed sources:
   - src/content/settings/home-page.json — all the editable copy
     (hero, optional hero banner photo, discovery cards, impact
     stats, section headings, etc.)
   - donation-campaign.json — the campaign progress numbers.
 
  Layout/structure lives here in code (not editable via CMS, by
  design — so the page can't be visually broken). All words, links,
  images, and numbers are editable through the CMS.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
import home from "../content/settings/home-page.json";
import campaign from "../content/settings/donation-campaign.json";

// --- Section heading case (2026-08-19) ---
// Every remaining homepage section heading is editable, with a
// per-heading choice of "as typed" or "UPPERCASE". Each falls back to
// a sensible default if the CMS field is blank, so the page never
// renders with an empty heading.
const discovery_heading_case = (home as any).discovery_heading_case || "as-typed";
const impact_heading_case = (home as any).impact_heading_case || "as-typed";
const donate_heading_case = (home as any).donate_heading_case || "as-typed";

// --- Values section (2026-08-20) ---
// Heading, intro and the list of phrases are all CMS-editable. Blank
// entries are filtered out so an empty row left in the CMS list can't
// render an empty line.
const valuesHeading = (home as any).values_heading?.trim() || "";
const valuesIntro = (home as any).values_intro?.trim() || "";
const valuesList: string[] = ((home as any).values_list || [])
  .map((v: any) => (typeof v === "string" ? v : v?.phrase || ""))
  .map((s: string) => s.trim())
  .filter(Boolean);
const values_heading_case = (home as any).values_heading_case || "as-typed";

// --- Donation campaign numbers ---
const goal = campaign.goal_amount;
const raised = campaign.raised_amount;
const donorCount = campaign.donor_count;
const campaignLabel = campaign.campaign_label;
const pct = Math.round((raised / goal) * 100);
// Thermometer fill height, capped 0–100 so it never overflows the tube.
const fillPct = Math.min(100, Math.max(0, pct));

// --- Thermometer: HORIZONTAL (2026-08-20) ---
// Rewritten from a vertical tube to a horizontal bar, approved via a
// static mockup first (thermo_horizontal_v2.png). The vertical version
// left large empty margins either side of a narrow column and, on
// phones, wasted most of the screen width while pushing the Donate
// button far down. A bar spans the full text column and reads
// left-to-right like the copy above it.
//
// The scale is a straightforward percentage of the bar's width, so
// unlike the vertical version there's no rounded-cap geometry to work
// around — the fill and the tick marks share one percentage scale by
// construction and can't drift apart.
const tickFractions = [0.25, 0.5, 0.75];
const thermoTicks = tickFractions.map((f) => ({
  // Abbreviated ($50k, not $50,000) — spelled out, these collide on a
  // phone-width bar.
  label: `$${Math.round((goal * f) / 1000)}k`,
  leftPct: f * 100,
}));
// No tick at 100%: it lands on the bar's rounded end where there's no
// clean place for it, and the GOAL badge already marks that end.
 
// Donation-teaser heading. CMS-editable (home.donate_heading). If the
// field is empty, fall back to the original goal-based wording so the
// line never renders blank.
const donateHeading = home.donate_heading?.trim() || `Help us reach $${goal.toLocaleString()}.`;
 
// --- Hero heading with optional italic word ---
// The CMS lets staff pick one word in the heading to italicize
// (the accent style). If that word appears in the heading, we
// split around it; otherwise the heading renders plain.
const heading = home.hero_heading;
const italicWord = home.hero_heading_italic_word?.trim();
let headingBefore = heading;
let headingItalic = "";
let headingAfter = "";
if (italicWord && heading.includes(italicWord)) {
  const idx = heading.indexOf(italicWord);
  headingBefore = heading.slice(0, idx);
  headingItalic = italicWord;
  headingAfter = heading.slice(idx + italicWord.length);
}

// --- Force the headline onto two lines, with the word right before
// the accent word joining it on the second line (PM preference: e.g.
// "YOUTH THEATER" / "FOR EVERYONE!" rather than "YOUTH THEATER FOR" /
// "EVERYONE!"). Only kicks in when there's an accent word AND at
// least two words before it; otherwise the heading just wraps
// naturally with no forced break.
let headingLine1 = "";
let headingLine2Lead = "";
if (headingItalic) {
  const trimmed = headingBefore.trimEnd();
  const lastSpaceIdx = trimmed.lastIndexOf(" ");
  if (lastSpaceIdx > 0) {
    headingLine1 = trimmed.slice(0, lastSpaceIdx);
    headingLine2Lead = trimmed.slice(lastSpaceIdx + 1);
  }
}
 
// --- Optional hero banner image (legacy, not currently rendered) ---
const heroImage = (home as any).hero_image || "";

// --- Hero photo strip ---
// A row of clickable photo cards under the intro text, replacing the
// old single wide banner. Each card needs a title and a link; the
// photo is optional (falls back to a colored placeholder showing the
// title, cycling through the brand colors so cards without a photo
// still look intentional rather than broken). Empty-safe: hidden
// entirely if the list is empty or every entry is missing a title/url.
const placeholderColors = ["accent", "brand-blue", "brand-green", "accent-deep", "brand-blue", "brand-green"];
const photoStrip = ((home as any).photo_strip || [])
  .filter((c: any) => c?.title?.trim() && c?.url?.trim())
  .map((c: any, i: number) => ({
    title: c.title,
    url: c.url,
    image: c.image || "",
    colorClass: placeholderColors[i % placeholderColors.length],
  }));

// The carousel is rendered as three back-to-back copies of the same
// cards so it can loop continuously in either direction (see script
// below) — swiping/clicking past either end silently jumps back into
// the middle copy rather than running out of cards.
const loopedPhotoStrip = photoStrip.length > 0 ? [...photoStrip, ...photoStrip, ...photoStrip] : [];
---
 
<BaseLayout title="Peninsula Youth Theatre — Outstanding youth theatre">
  <!-- ============ HERO (intro text) ============ -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-logo-wrap">
          <Logo size="hero" />
        </div>
        <h1 class="hero-heading">
          {headingItalic && headingLine2Lead ? (
            <>
              {headingLine1}<br />
              {headingLine2Lead}{" "}
              <span class="accent-word">
                {headingItalic}
              </span>
              {headingAfter}
            </>
          ) : (
            <>
              {headingBefore}{headingItalic && (
                <span class="accent-word">{headingItalic}</span>
              )}{headingAfter}
            </>
          )}
        </h1>
        <p class="hero-lede">{home.hero_lede}</p>
      </div>
    </div>
 
    <!-- Photo strip / carousel: scrollable row of cards linking to key
         pages. Hidden entirely when there are no valid cards. Cards
         render in CMS order (no shuffle), rendered as three back-to-back
         copies (loopedPhotoStrip) so the carousel loops continuously in
         both directions — see script below. The card nearest the center
         of the viewport becomes the large "hero" image (photo only —
         the caption stays normal size so it's never cut off). Several
         ways to change which card is the hero: swiping, the arrow
         buttons, hovering a non-hero card with a mouse (desktop only —
         real hover devices), or clicking a non-hero card. CLICKING is
         gated (PM preference, 2026-08-19): a click on any card that
         ISN'T currently the hero re-centers it instead of following its
         link; only clicking the card that's already the hero navigates
         through. Always opens centered on the card titled exactly
         "Center Stage Musicals" — matched by that card's title text, so
         keep that title spelled that way if it's ever edited. Both
         arrow buttons and edge fades stay visible at all times on
         desktop (there's no "end" to reach) — on mobile people just
         swipe. -->
    {photoStrip.length > 0 && (
      <div class="container">
        <div class="photo-strip-wrap" id="photo-strip-wrap">
          <button type="button" class="photo-strip-arrow photo-strip-arrow-prev" id="photo-strip-prev" aria-label="Scroll left">‹</button>
          <div class="photo-strip-fade photo-strip-fade-left" aria-hidden="true"></div>

          <div class="photo-strip" id="photo-strip">
            {loopedPhotoStrip.map((card) => (
              <a href={card.url} class="photo-strip-card">
                <div class="photo-strip-photo">
                  {card.image ? (
                    <img src={card.image} alt="" loading="eager" />
                  ) : (
                    <div class={`photo-strip-placeholder c-${card.colorClass}`}></div>
                  )}
                </div>
                <span class="photo-strip-title">{card.title}</span>
              </a>
            ))}
          </div>

          <div class="photo-strip-fade photo-strip-fade-right" aria-hidden="true"></div>
          <button type="button" class="photo-strip-arrow photo-strip-arrow-next" id="photo-strip-next" aria-label="Scroll right">›</button>
        </div>
      </div>
    )}
  </section>

  <script>
    // Looping, centered photo carousel. Cards render as three
    // back-to-back copies of the same set (see loopedPhotoStrip above);
    // whenever the centered card drifts into the first or third copy,
    // we silently jump the scroll position by exactly one set-width in
    // the opposite direction (no animation, same visual frame) so it's
    // always sitting in the middle copy with room to keep scrolling —
    // that's what makes it feel continuous instead of running out.
    //
    // Scale is applied to the PHOTO only, not the whole card, with
    // transform-origin anchored to the photo's bottom edge — so the
    // hero photo grows upward, away from its caption underneath, and
    // the caption itself never resizes or gets crowded/clipped. Uses
    // offsetLeft/offsetWidth/offsetHeight (layout box) for all position
    // math rather than getBoundingClientRect, since those are
    // unaffected by the CSS transform — reading a transformed element's
    // bounding rect would feed its own scaled size back into the next
    // frame's calculation.
    const strip = document.getElementById("photo-strip") as HTMLElement | null;
    const wrap = document.getElementById("photo-strip-wrap");
    const prevBtn = document.getElementById("photo-strip-prev");
    const nextBtn = document.getElementById("photo-strip-next");

    if (strip && wrap) {
      const cards = Array.from(strip.querySelectorAll(".photo-strip-card")) as HTMLElement[];
      const SET_SIZE = cards.length / 3;
      let currentIndex = 0;
      let correcting = false;

      // Custom eased scroll-to, replacing native scrollIntoView's
      // smooth behavior (PM feedback, 2026-08-19: hovering used to
      // feel "too fast and out of control" because every mouseover
      // fired the browser's own default-speed smooth-scroll, and
      // rapid retargeting mid-animation looked jerky). This version is
      // fully self-timed and interruptible: retargeting mid-animation
      // just eases toward the new target from wherever the strip
      // currently is, instead of restarting abruptly.
      let scrollAnimFrame: number | null = null;
      const animateScrollTo = (target: HTMLElement, duration = 550) => {
        if (scrollAnimFrame) cancelAnimationFrame(scrollAnimFrame);
        const startX = strip.scrollLeft;
        const endX = target.offsetLeft + target.offsetWidth / 2 - strip.clientWidth / 2;
        const distance = endX - startX;
        const startTime = performance.now();
        const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
        const step = (now: number) => {
          const elapsed = now - startTime;
          const t = Math.min(1, elapsed / duration);
          strip.scrollLeft = startX + distance * easeInOutCubic(t);
          scrollAnimFrame = t < 1 ? requestAnimationFrame(step) : null;
        };
        scrollAnimFrame = requestAnimationFrame(step);
      };

      // Pad both ends of the track so any card can still reach true
      // center — recalculated on resize since card width differs by
      // breakpoint.
      const updateHorizontalPadding = () => {
        if (!cards.length) return;
        const pad = Math.max(0, (strip.clientWidth - cards[0].offsetWidth) / 2);
        strip.style.paddingLeft = `${pad}px`;
        strip.style.paddingRight = `${pad}px`;
      };

      // All cards are now the SAME size (PM request, 2026-08-19) — the
      // earlier "hero photo scales up" version is gone entirely. The
      // only thing that distinguishes the centered "hero" card from
      // the rest now is opacity, applied to the whole card element
      // (which covers both the photo AND its caption together, since
      // CSS opacity affects an element's full subtree) — not a
      // gradual falloff by distance, just hero = fully opaque,
      // everything else = evenly faded.
      const FADE_OPACITY = "0.4";

      const updateScale = () => {
        if (!cards.length) return;
        const centerX = strip.clientWidth / 2 + strip.scrollLeft;
        let closestDist = Infinity;
        cards.forEach((card, i) => {
          const cardCenter = card.offsetLeft + card.offsetWidth / 2;
          const dist = Math.abs(cardCenter - centerX);
          if (dist < closestDist) {
            closestDist = dist;
            currentIndex = i;
          }
        });
        cards.forEach((card, i) => {
          const isHero = i === currentIndex;
          card.style.opacity = isHero ? "1" : FADE_OPACITY;
          card.style.zIndex = isHero ? "2" : "1";
        });

        // Loop correction: if the centered card has drifted out of the
        // middle copy, jump back into it by exactly one set-width —
        // instant, same visual position — so there's always more to
        // scroll to in either direction.
        if (!correcting && SET_SIZE > 0) {
          if (currentIndex < SET_SIZE) {
            correcting = true;
            const setWidth = cards[currentIndex + SET_SIZE].offsetLeft - cards[currentIndex].offsetLeft;
            strip.scrollLeft += setWidth;
            currentIndex += SET_SIZE;
            requestAnimationFrame(() => { correcting = false; });
          } else if (currentIndex >= SET_SIZE * 2) {
            correcting = true;
            const setWidth = cards[currentIndex].offsetLeft - cards[currentIndex - SET_SIZE].offsetLeft;
            strip.scrollLeft -= setWidth;
            currentIndex -= SET_SIZE;
            requestAnimationFrame(() => { correcting = false; });
          }
        }
      };

      // Center a card by setting the strip's own scrollLeft directly,
      // rather than scrollIntoView. scrollIntoView scrolls EVERY
      // scrollable ancestor as needed — including the page itself — so
      // on a phone it could yank the whole page vertically. Combined
      // with the resize handler below (which mobile browsers fire every
      // time the address bar shows/hides during a normal scroll), that
      // was causing the page to visibly jump around while scrolling.
      // Setting scrollLeft only ever moves the strip horizontally.
      const centerCardInstantly = (card: HTMLElement | undefined | null) => {
        if (!card) return;
        strip.scrollLeft = card.offsetLeft + card.offsetWidth / 2 - strip.clientWidth / 2;
      };

      updateHorizontalPadding();

      // Always open centered on "Center Stage Musicals" rather than a
      // random card (PM preference) — and specifically the copy in the
      // MIDDLE set, so there's a full set of cards to scroll to on
      // either side right from the start. Falls back to the first card
      // in the middle set if that title is ever missing or renamed.
      const middleSetCards = cards.slice(SET_SIZE, SET_SIZE * 2);
      const startCard =
        middleSetCards.find(
          (c) =>
            (c.querySelector(".photo-strip-title")?.textContent || "")
              .trim()
              .toLowerCase() === "center stage musicals"
        ) || middleSetCards[0];
      centerCardInstantly(startCard);
      updateScale();

      let scaleQueued = false;
      const queueScale = () => {
        if (scaleQueued) return;
        scaleQueued = true;
        requestAnimationFrame(() => {
          updateScale();
          scaleQueued = false;
        });
      };
      strip.addEventListener("scroll", queueScale, { passive: true });

      // Only react to WIDTH changes. Mobile browsers fire `resize`
      // constantly during normal page scrolling as the address bar
      // collapses/expands — that's a height-only change that doesn't
      // affect this layout at all, but re-centering on every one of
      // them is what made the carousel feel like it was glitching and
      // fighting the user mid-scroll.
      let lastWidth = window.innerWidth;
      window.addEventListener("resize", () => {
        if (window.innerWidth === lastWidth) return;
        lastWidth = window.innerWidth;
        updateHorizontalPadding();
        centerCardInstantly(cards[currentIndex]);
        updateScale();
      });

      // Arrow buttons: step to the next/previous card and re-center it.
      // No edge-hiding logic — the carousel loops continuously, so both
      // arrows (and both edge fades) stay visible at all times. Shown on
      // phones as well as desktop as of 2026-08-20, so there's a visible
      // cue that more photos exist rather than relying on swipe discovery.
      if (prevBtn && nextBtn) {
        prevBtn.addEventListener("click", () => {
          const target = cards[currentIndex - 1];
          if (target) animateScrollTo(target, 500);
        });
        nextBtn.addEventListener("click", () => {
          const target = cards[currentIndex + 1];
          if (target) animateScrollTo(target, 500);
        });
      }

      // Hovering a non-hero card (mouse users only — real hover
      // devices) re-centers it, making it the hero. Delegated on the
      // strip so it works for every card without per-card listeners.
      // Two things make this feel slow/controlled rather than the
      // "too fast, out of control" behavior from before (PM feedback,
      // 2026-08-19): (1) a short dwell delay — the mouse has to rest
      // on a card for a moment before it's treated as a deliberate
      // hover, so quickly passing the cursor across several cards
      // doesn't re-trigger a scroll for every single one; (2) the
      // scroll itself now runs over a longer, fixed duration via
      // animateScrollTo rather than the browser's own (fast, and not
      // fully controllable) native smooth-scroll.
      const supportsHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      if (supportsHover) {
        let hoverTimer: number | null = null;
        let pendingCard: HTMLElement | null = null;
        const clearPendingHover = () => {
          if (hoverTimer !== null) {
            clearTimeout(hoverTimer);
            hoverTimer = null;
          }
          pendingCard = null;
        };
        strip.addEventListener("mouseover", (e) => {
          const card = (e.target as HTMLElement)?.closest(".photo-strip-card") as HTMLElement | null;
          if (!card) return;
          const idx = cards.indexOf(card);
          if (idx === -1 || idx === currentIndex || card === pendingCard) return;
          clearPendingHover();
          pendingCard = card;
          hoverTimer = window.setTimeout(() => {
            animateScrollTo(card, 700);
            pendingCard = null;
            hoverTimer = null;
          }, 180);
        });
        strip.addEventListener("mouseleave", clearPendingHover);
      }

      // Clicking a non-hero card re-centers it instead of following its
      // link (PM preference, 2026-08-19) — only the card that's ALREADY
      // the hero navigates through when clicked. Delegated on the strip
      // so it covers every card, including the two extra loop copies.
      strip.addEventListener("click", (e) => {
        const card = (e.target as HTMLElement)?.closest(".photo-strip-card") as HTMLElement | null;
        if (!card) return;
        const idx = cards.indexOf(card);
        if (idx !== -1 && idx !== currentIndex) {
          e.preventDefault();
          animateScrollTo(card, 500);
        }
      });
    }
  </script>
 
  <!-- ============ DISCOVERY CARDS (square photo grid) ============ -->
  <!-- "Find your role" — this now sits directly after the hero. The
       old "Upcoming Shows"/"What's Next" section that used to be here
       was removed entirely (code + CMS fields) per PM request,
       2026-08-19. -->
  <section class="section discovery-section">
    <div class="container">
      <div class="discovery-header-row">
        <h2 class={`section-head ${discovery_heading_case === "uppercase" ? "case-upper" : ""}`}>{home.discovery_heading}</h2>
        <!-- Calendar link (2026-08-19) — sits next to this heading,
             matching the green ring-tab styling of the Calendar nav
             button (see Header.astro's .calendar-btn) so the two read
             as the same feature wherever you spot them. -->
        <a href="/calendar" class="calendar-link-btn">Calendar</a>
      </div>

      <div class="card-grid">
        {home.discovery_cards.map((card: any, i: number) => (
          <a href={card.url} class="card">
            {card.image ? (
              <img src={card.image} alt="" class="card-photo" loading="lazy" />
            ) : (
              <div class={`card-photo card-photo-placeholder c-${placeholderColors[i % placeholderColors.length]}`}></div>
            )}
            <span class="card-overlay">
              <span class="card-title">{card.title}</span>
              {card.subtitle && <span class="card-subtitle">{card.subtitle}</span>}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
 
  <!-- ============ IMPACT STATS ============ -->
  {(home.impact_heading?.trim() || (home.stats || []).length > 0) && (
  <section class="section impact">
    <div class="container">
      {home.impact_heading?.trim() && (
        <h2 class={`section-head ${impact_heading_case === "uppercase" ? "case-upper" : ""}`}>{home.impact_heading}</h2>
      )}
 
      {/* Hide the grid entirely when there are no stats, rather than
          leaving an empty grid under the heading. */}
      {(home.stats || []).filter((s) => s?.figure?.trim() || s?.label?.trim()).length > 0 && (
      <div class="stat-grid">
        {(home.stats || []).filter((s) => s?.figure?.trim() || s?.label?.trim()).map((stat, i) => {
          /* Each stat sits in a SOLID box in one of the brand colours,
             cycling by position (2026-08-21, replaces the outlined box).
             Full-strength brand colours rather than pastels, so the type
             inside stays light — a pale box would need dark type instead.
             A fourth colour was added so the four current stats don't
             repeat blue immediately; beyond four it cycles. */
          const boxColors = [
            "var(--brand-blue)",
            "var(--brand-green)",
            "var(--accent)",
            "var(--stat-gold)",
          ];
          const boxColor = boxColors[i % boxColors.length];
          return (
            <div class="stat" style={`background: ${boxColor}`}>
              <p class="stat-figure">{stat.figure}</p>
              <p class="stat-label">{stat.label}</p>
            </div>
          );
        })}
      </div>
      )}
    </div>
  </section>
  )}
 
  <!-- ============ VALUES ============ -->
  <!-- Added 2026-08-20, sits between "PYT in numbers" and the donation
       section. Heading, intro and the value phrases themselves are all
       CMS-editable; the whole section hides if the heading and phrases
       are both empty, so it can be switched off without leaving a gap. -->
  {(valuesHeading || valuesList.length > 0) && (
    <section class="section values">
      <div class="container">
        {valuesHeading && (
          <h2 class={`section-head ${values_heading_case === "uppercase" ? "case-upper" : ""}`}>{valuesHeading}</h2>
        )}
        {valuesIntro && <p class="values-intro">{valuesIntro}</p>}

        {valuesList.length > 0 && (
          <ul class="values-list">
            {valuesList.map((phrase, i) => {
              /* Coloured by POSITION in pastel tints of the three logo
                 colours, cycling if there are ever more than three —
                 same approach as the impact figures above, so a fourth
                 value doesn't need a code change or a colour field in
                 the CMS. */
              const pastels = ["var(--values-pink)", "var(--values-blue)", "var(--values-green)"];
              return (
                <li class="values-item" style={`color: ${pastels[i % pastels.length]}`}>{phrase}</li>
              );
            })}
          </ul>
        )}
      </div>
    </section>
  )}

  <!-- ============ DONATION TEASER ============ -->
  <section class="section donate-teaser">
    <div class="container">
      <h2 class={`section-head ${donate_heading_case === "uppercase" ? "case-upper" : ""}`}>{donateHeading}</h2>
      <p class="donate-lede">{home.donate_lede}</p>
 
      <!-- Horizontal campaign bar (2026-08-20). One role="img" wrapper
           carries the whole thing for screen readers, so the decorative
           ticks and GOAL badge below are aria-hidden rather than being
           read out as stray text. -->
      <div class="thermo" role="img"
           aria-label={`$${raised.toLocaleString()} raised of $${goal.toLocaleString()} goal, ${pct}% complete, from ${donorCount} donors`}>
        <p class="thermo-goal-flag" aria-hidden="true">Goal</p>

        <div class="thermo-track-row">
          <span class="thermo-bulb" aria-hidden="true"></span>
          <div class="thermo-track">
            <div class="thermo-fill" style={`width: ${fillPct}%`}></div>
          </div>
        </div>

        <div class="thermo-ticks" aria-hidden="true">
          {thermoTicks.map((t) => (
            <span class="thermo-tick" style={`left: ${t.leftPct}%`}>
              <span class="thermo-tick-mark"></span>
              <span class="thermo-tick-label">{t.label}</span>
            </span>
          ))}
        </div>
      </div>

      <p class="thermo-meta">
        <strong>${raised.toLocaleString()}</strong> raised
        <span class="thermo-sep" aria-hidden="true">&middot;</span>
        <strong>{donorCount}</strong> donors
        <span class="thermo-sep" aria-hidden="true">&middot;</span>
        <strong>{pct}%</strong> of goal
      </p>

      <div class="donate-teaser-btn-wrap">
        <a href="https://pyt.secure.nonprofitsoapbox.com/donate" class="btn donate-teaser-btn" target="_blank" rel="noopener">{home.donate_button_label}</a>
      </div>
    </div>
  </section>
</BaseLayout>
 
<style>
  /* Pastel tints of the three PYT logo colours, used by the Values
     section. Kept local to this page because nothing else uses them. */
  .impact {
    /* Fourth box colour, so four stats don't repeat blue side by side.
       A deepened gold rather than the bright --highlight yellow, which
       is reserved for the Donate button and is too light to carry white
       type. */
    --stat-gold: #c9971a;
  }

  /* Values band (2026-08-21). Pale lilac ground, chosen because it's the
     nav-pill colour and so already part of the palette rather than a new
     one — and because it separates this section from the plain-white
     thermometer section directly below it.

     The word colours are DEEPENED brand colours, not the pastels first
     tried: pastels on any pale ground measure ~1.5-2.2 contrast, well
     under the 3.0 minimum for large display text, and visibly washed
     out. These sit around 3.8. The pastel range moved up to the stat
     boxes, where the dark band behind them supports it. */
  .values {
    --values-pink: #a82169;
    --values-blue: #2f7fa3;
    --values-green: #4a8038;
    /* Same token as every other panel on the site, so the Values band
       and the panels elsewhere can never drift apart. */
    background: var(--paper-warm);
  }

  /* ---- Hero ---- */
  .hero {
    /* Matches the top padding of every other band on the page. This is
       bumped to --space-2xl at >=720px in the media query below,
       because .section does exactly the same switch — before that,
       .hero sat 2rem tighter under the nav than any other section. */
    padding-top: var(--space-xl);
    /* ZERO on purpose (2026-08-22). The gap below the carousel is now
       supplied ENTIRELY by the following .section's own padding-top,
       which is exactly how the Discovery -> Impact gap already works.

       History, because this has been "fixed" once already and the old
       comment here was wrong: the value used to be --space-xl (4rem).
       On mobile that was right — .section's padding is also --space-xl
       there, so 4 + 4 = 8rem and the gap matched. But .section switches
       to --space-2xl (6rem) at >=720px and .hero did not, so on DESKTOP
       the gap came out at 4 + 6 = 10rem (~187px measured) against 6rem
       (96px) everywhere else — visibly the largest gap on the page.
       Setting this to 0 evens it at BOTH breakpoints in one value, so
       there is no need for a second responsive rule here. If you ever
       reintroduce padding on this edge, check it at >=720px too. */
    padding-bottom: 0;
  }
 
  .hero-heading {
    /* Enlarged from the previous size (PM feedback) — scoped to the
       homepage only, other pages' h1 sizes are unaffected. */
    font-size: clamp(2.2rem, 7vw, 3.8rem);
    margin: 0;
    position: relative;
    grid-column: 1;
    grid-row: 2;
    /* PM tried a few playful font options and picked Baloo 2, caps —
       scoped to just this homepage headline (via font-family here,
       not the shared --font-heading token), so every other heading
       on the site stays on Archivo Black.
       Baloo 2's own font metrics reserve a lot of extra vertical
       space (for lowercase ascenders/descenders this all-caps
       headline never uses), which made the default line spacing
       look oddly loose. line-height is set tight and explicit here
       to compensate — this value was tuned by measuring the font's
       actual rendered letter height directly (not just picked by
       eye), but different headline text/length could still need a
       revisit. */
    font-family: "Baloo 2", var(--font-heading), sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.82;
  }

  /* Logo + headline + intro text, laid out as a small grid so the
     lede lines up under the HEADLINE (not the logo), and the logo's
     own height (set in Logo.astro) matches the headline text block —
     giving a clean top/bottom alignment between logo and headline
     without the logo dwarfing anything. Stacked (logo, then headline,
     then lede, all full width) on phones; side by side once there's
     enough width for it to breathe. */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 0.6rem;
  }

  .hero-logo-wrap {
    grid-column: 1;
    grid-row: 1;
  }

  .hero-lede {
    grid-column: 1;
    grid-row: 3;
  }

  @media (min-width: 720px) {
    /* Hero top padding tracks .section, which also switches to
       --space-2xl at this breakpoint. See the note on .hero above. */
    .hero {
      padding-top: var(--space-2xl);
    }

    /* CENTRED HERO (PM choice, 2026-08-22 — "Option B").
       This used to be a two-column `auto 1fr` grid with the logo beside
       the headline. It is now a single centred column at every width:
       logo, then headline, then lede, all centred over the carousel
       below. The stacking order is already correct in the base (mobile)
       rules, so this only needs to STOP the old two-column switch and
       add the centring — the grid-row assignments are inherited.

       Note the row-gap: the headline's line-height is 0.82, so its box
       is SHORTER than the letters it contains and the ink overflows top
       and bottom. That is why the old 0.6rem gap read as the lede being
       jammed into the headline's descenders. Anything set here is
       box-to-box, so it buys less optical space than the number
       suggests — 1.9rem lands at roughly 1.1rem of visible air. */
    .hero-grid {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      row-gap: 1.9rem;
    }

    /* Extra space under the logo only. The logo -> headline step wants
       to be bigger than the headline -> lede step, and row-gap is a
       single value for the whole grid, so the difference is added here
       rather than by splitting the grid up. */
    .hero-logo-wrap {
      margin-bottom: 1.1rem;
    }

    .hero-lede {
      /* Wider than the 60ch used when this sat in a narrow right-hand
         column — a centred block that stops at 60ch looks pinched
         against the full-width carousel under it. 75ch is the top of
         the comfortable measure range; don't push it further. */
      max-width: 75ch;
    }
  }

  .accent-word {
    position: relative;
  }

  .hero-lede {
    /* Brought up to match the impact of the new bolder look — bigger,
       heavier, and full-strength ink color instead of the muted gray
       paragraphs normally use. Line-height/letter-spacing tightened
       from the site's normal body defaults (1.6 leading, no tracking)
       since at this size+weight the default reads loose — condensed
       to feel more like a headline-adjacent block than body copy. */
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 60ch;
    margin-bottom: var(--space-md);
  }
 
  /* Wide hero banner photo (legacy, not currently rendered — kept in
     case hero_image is reused later) */
  .hero-banner-img {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border-radius: 0;
    display: block;
    margin-top: var(--space-lg);
    margin-bottom: 0;
    box-shadow: var(--shadow-soft);
    max-height: 520px;
  }

  /* ---- Hero photo strip ---- */
  .photo-strip-wrap {
    position: relative;
    margin-top: var(--space-lg);
  }

  .photo-strip {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    overflow-x: auto;
    /* "mandatory" (not "proximity") so the strip always settles on a
       centered card. */
    scroll-snap-type: x mandatory;
    padding: 14px 0 0.6rem;
    -webkit-overflow-scrolling: touch;
    /* Hide the native scrollbar — replaced by the arrow buttons and
       edge fades below. Swiping/dragging still works exactly the
       same either way. */
    scrollbar-width: none;
  }

  .photo-strip::-webkit-scrollbar {
    display: none;
  }

  .photo-strip-fade {
    display: none; /* shown on wider screens only, see media query below */
    position: absolute;
    top: 0;
    bottom: 0.6rem;
    width: 48px;
    pointer-events: none;
    z-index: 1;
  }

  .photo-strip-fade-left {
    left: 0;
    background: linear-gradient(to right, var(--paper), transparent);
  }

  .photo-strip-fade-right {
    right: 0;
    background: linear-gradient(to left, var(--paper), transparent);
  }

  .photo-strip-arrow {
    /* Visible at every width as of 2026-08-20 (was desktop-only, with
       the mobile rule added separately — which left a dead zone between
       641px and 719px where neither rule applied and the arrows silently
       vanished). Making "shown" the default and only varying the SIZE
       per breakpoint removes that gap entirely. */
    display: flex;
    position: absolute;
    top: 45%;
    transform: translateY(-50%);
    z-index: 2;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-soft);
  }

  .photo-strip-arrow-prev {
    left: -6px;
  }

  .photo-strip-arrow-next {
    right: -6px;
  }

  /* Edge fades are wide-screen only — on a phone the card fills nearly
     the whole container, so a fade over its edges just dims the photo
     rather than suggesting "more to scroll". The arrows (visible at all
     widths, see above) carry that cue on mobile instead. */
  @media (min-width: 720px) {
    .photo-strip-fade {
      display: flex;
    }
  }

  .photo-strip-card {
    /* All cards are now this SAME size (PM request, 2026-08-19) — the
       old scale-up-the-center-card effect is gone. This size is
       roughly the old hero size (220px base * 1.7x scale ≈ 374px)
       increased again by about a third, so today's "hero" size is
       what every card looks like now; only opacity (see script)
       distinguishes the centered one. Not all cards fit on one
       screen at this size — that's expected, swipe/arrows reveal
       the rest. */
    flex: 0 0 500px;
    display: block;
    scroll-snap-align: center;
    transition: opacity 0.25s ease;
  }

  .photo-strip-photo {
    aspect-ratio: 4 / 3;
    border-radius: 0;
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .photo-strip-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .photo-strip-placeholder {
    width: 100%;
    height: 100%;
  }

  .photo-strip-placeholder.c-accent { background: var(--accent); }
  .photo-strip-placeholder.c-accent-deep { background: var(--accent-deep); }
  .photo-strip-placeholder.c-brand-blue { background: var(--brand-blue); }
  .photo-strip-placeholder.c-brand-green { background: var(--brand-green); }

  .photo-strip-title {
    display: block;
    margin-top: 0.6rem;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 0.95rem;
    line-height: 1.25;
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .photo-strip-card {
      /* Was a fixed 380px, which was WIDER than the container's inner
         width on a typical phone (390px viewport − 2×1.5rem padding =
         342px). The card sat centered, so it hung ~19px off each edge
         — and since the title is left-aligned inside the card, its
         first characters were pushed off-screen ("CENTER STAGE
         MUSICALS" rendered as "NTER STAGE MUSICALS"). Capping at 100%
         of the available width fixes the clipped title at every phone
         size rather than trading one hardcoded width for another. */
      flex-basis: min(380px, 100%);
    }

    /* Arrows on phones (2026-08-20, PM request): bigger tap targets and
       pulled in tight to the photo's edges. Vertically centered on the
       PHOTO (33%), not the card — the card's height includes the caption
       underneath, so centering on it would sit them visibly low. */
    .photo-strip-arrow {
      width: 38px;
      height: 38px;
      font-size: 1.4rem;
      top: 33%;
    }

    .photo-strip-arrow-prev {
      left: 2px;
    }

    .photo-strip-arrow-next {
      right: 2px;
    }
  }
 
  /* ---- Section heading ---- */
  .section-head {
    margin-block: 0.4rem var(--space-lg);
    max-width: 20ch;
  }

  /* Caps toggle for section headings (NEW, 2026-08-19) — the PM can
     now choose "as typed" (default) or UPPERCASE per heading in the
     CMS. Applied by adding this class conditionally, not by forcing
     text-transform on .section-head itself, so existing headings
     that were typed in caps by hand (e.g. content already written in
     capitals) aren't affected either way. */
  .case-upper {
    text-transform: uppercase;
  }
 
  /* ---- Discovery cards (square photo grid, redesigned 2026-08-19) ---- */
  /* Header row holding the section heading + the Calendar link
     (2026-08-19) — wraps on narrow screens rather than squeezing the
     button, since the heading's length varies (it's CMS-editable). */
  .discovery-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-bottom: var(--space-lg);
  }

  .discovery-header-row .section-head {
    margin-bottom: 0;
  }

  /* Same visual language as the nav's Calendar button (green, two
     small "ring" tabs on top) — duplicated here rather than shared
     with Header.astro since Astro scopes component styles per file;
     kept deliberately identical in both places so it reads as one
     feature. */
  .calendar-link-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    background: var(--brand-green);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-btn);
    margin-top: 8px;
    flex-shrink: 0;
  }

  .calendar-link-btn:hover {
    filter: brightness(1.08);
  }

  .calendar-link-btn::before,
  .calendar-link-btn::after {
    content: "";
    position: absolute;
    top: -6px;
    width: 5px;
    height: 11px;
    background: #fff;
    border-radius: 2px;
  }

  .calendar-link-btn::before {
    left: 22%;
  }

  .calendar-link-btn::after {
    right: 22%;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
 
  .card {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    transition: transform 0.18s ease;
  }
 
  .card:hover {
    transform: translateY(-2px);
  }
 
  .card-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
 
  .card-photo-placeholder.c-accent { background: var(--accent); }
  .card-photo-placeholder.c-accent-deep { background: var(--accent-deep); }
  .card-photo-placeholder.c-brand-blue { background: var(--brand-blue); }
  .card-photo-placeholder.c-brand-green { background: var(--brand-green); }
 
  /* Title overlaid on the photo, bottom-anchored, dark gradient scrim
     behind it for legibility on any photo. Big, bold, Baloo 2, white —
     PM request, to match the homepage's other playful touches. */
  .card-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.6rem 0.9rem 0.85rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0));
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
 
  .card-title {
    font-family: "Baloo 2", var(--font-heading), sans-serif;
    font-weight: 700;
    color: #fff;
    font-size: clamp(1.1rem, 3.4vw, 1.6rem);
    line-height: 1.1;
  }
 
  .card-subtitle {
    font-family: "Baloo 2", var(--font-heading), sans-serif;
    font-weight: 700;
    color: #fff;
    opacity: 0.9;
    font-size: clamp(0.8rem, 2vw, 0.95rem);
    line-height: 1.2;
  }
 
  /* ---- Impact stats ---- */
  /* Black background matching the nav bar (PM request, 2026-08-19) —
     was the site's warm off-white paper color before. Heading and
     label text switch to light colors here since they're now on a
     dark surface; the figures themselves already carry their own
     brand color (blue/green/pink) which reads fine on black. */
  .impact {
    background: var(--nav-bg-dark);
    border-block: none;
  }

  .impact .section-head {
    color: var(--nav-text);
  }
 
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
  }
 
  /* Solid colour boxes (2026-08-21). Figure and label are both centred,
     the figure sitting above the label. A min-height keeps all four boxes
     equal even though the labels differ a lot in length — without it the
     shortest ("Audience members") made a visibly stubbier box. */
  .stat {
    background: var(--accent);
    padding: 1.4rem 1rem;
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 132px;
  }

  .stat-figure {
    font-family: var(--font-heading);
    font-size: 2.1rem;
    font-weight: 400;
    /* Light type on a saturated box. */
    color: #fff;
    line-height: 1;
    margin: 0;
  }
 
  .stat-label {
    font-size: 0.85rem;
    /* Slightly softened white rather than the muted grey used before:
       that grey was tuned for the dark band behind, and on a saturated
       box it dropped below a comfortable contrast. */
    color: rgba(255, 255, 255, 0.92);
    margin: 0.55rem 0 0;
    line-height: 1.35;
  }
 
  /* ---- Donation teaser ---- */
  .donate-lede {
    /* Matched to the hero intro paragraph's exact treatment (PM
       request, 2026-08-19) — same size, weight, line-height, and
       letter-spacing as "At Peninsula Youth Theatre..." up top,
       instead of the site's default lighter/smaller paragraph style. */
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 60ch;
    margin-bottom: var(--space-lg);
  }
 
  /* ---- Campaign progress thermometer ---- */
  /* Bigger and centered (PM request, 2026-08-19) — was a smaller
     thermometer sitting beside the numbers; now both sit stacked and
     centered together, matching the bolder scale of the rest of the
     homepage. This copy is scoped to the homepage only via Astro's
     component-level CSS — the Support PYT page keeps its own smaller
     version, untouched. */
  /* ---- Values ---- */
  /* Heading centred to match the list below it (2026-08-22). The
     shared .section-head carries `max-width: 20ch`, so text-align alone
     would centre the TEXT inside a box still pinned to the left edge —
     the margin-inline: auto is what actually centres the box. */
  .values .section-head {
    margin-inline: auto;
    text-align: center;
  }

  .values-intro {
    font-size: 1.08rem;
    color: var(--ink-soft);
    max-width: 62ch;
    /* Was `0 0 var(--space-lg)`; the auto sides centre the block now
       that the heading and phrases either side of it are centred.
       Currently empty in the CMS, so this only matters if the PM fills
       the Values intro field in later. */
    margin: 0 auto var(--space-lg);
    text-align: center;
  }

  .values-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    /* CENTRED (PM choice, 2026-08-22). This replaces a staggered
       layout where each phrase stepped across by an `em`-based
       margin-left (1.6em / 0.8em, repeating every three to match the
       colour rotation). The stagger and centring are mutually
       exclusive — indented centred lines just read as a mistake — so
       the indents were removed rather than kept and overridden. If the
       stagger is ever wanted back, it needs left alignment back too.
       The phone-width rule that used to flatten the indents went with
       them; centring needs no such exception. */
    align-items: center;
    text-align: center;
  }

  .values-item {
    /* Baloo 2 is already loaded site-wide (see the font import in
       global.css) and is the same playful face used in the hero, so
       this needs no new font request.

       NOTE ON THE SLANT: Baloo 2 ships no italic cut at all. `font-style:
       italic` therefore produces a browser-SYNTHESISED oblique — the
       upright letterforms sheared over — not a designed italic. That is
       the intended look here (it's what the approved mockup shows), but
       it's worth knowing it isn't a real italic if the rendering ever
       looks slightly off in a particular browser. */
    font-family: "Baloo 2", var(--font-heading), sans-serif;
    font-style: italic;
    font-weight: 700;
    text-transform: uppercase;
    /* Enlarged again 2026-08-22 (PM request) — was clamp(2.4rem, 8vw,
       5rem), before that capped at 3.4rem. Scales with the viewport so
       it shrinks on a phone instead of wrapping mid-phrase. The cap is
       the number to watch: at 6.4rem the longest phrase ("BE PREPARED")
       is comfortable inside the 1140px container, but a longer phrase
       added in the CMS could wrap. Check any new phrase at ~1400px
       viewport width before shipping it. */
    font-size: clamp(2.8rem, 9.5vw, 6.4rem);
    /* Baloo 2 reserves a lot of vertical space in its own metrics, so a
       tight line-height keeps the three phrases as a close-set block
       rather than a loose, drifting list. Tightened from 1.12 alongside
       the size increase — leading that read as close-set at 5rem reads
       as loose at 6.4rem. */
    line-height: 1.05;
    letter-spacing: 0.01em;
  }

  /* ---- Campaign progress bar (horizontal, 2026-08-20) ---- */
  /* Replaces the vertical tube. Sized in percentages off the container
     width rather than fixed pixels, so it fills whatever column it
     sits in and needs no separate mobile geometry. */
  .thermo {
    position: relative;
    margin-bottom: var(--space-md);
    /* Matches the Ways to Support page (2026-08-21). Width is the ONLY
       change: the bar previously stretched the full container while the
       copy above it did not, and that mismatch is what made it look
       oversized. Position, height, colours and the button are untouched. */
    max-width: 620px;
  }

  /* "Goal" sits above the right-hand end of the bar. */
  .thermo-goal-flag {
    margin: 0 0 0.35rem;
    text-align: right;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* Bulb + track share a row so they sit on one centreline. */
  .thermo-track-row {
    display: flex;
    align-items: center;
  }

  .thermo-bulb {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--campaign-fill);
    border: 3px solid var(--accent);
    /* Overlaps the track's rounded left end so the two read as one
       object rather than a circle sitting next to a bar. */
    margin-right: -10px;
    position: relative;
    z-index: 1;
  }

  .thermo-track {
    flex: 1;
    height: 22px;
    border: 3px solid var(--accent);
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    /* Clips the fill's square right edge to the rounded end. */
    overflow: hidden;
  }

  .thermo-fill {
    height: 100%;
    background: var(--campaign-fill);
    border-radius: var(--radius-pill) 0 0 var(--radius-pill);
    transition: width 0.5s ease;
  }

  /* Ticks are absolutely positioned as a percentage across the track,
     so they line up with the fill by construction — the two can't drift
     apart the way they did when the vertical version measured them on
     different scales. */
  .thermo-ticks {
    position: relative;
    /* Matches .thermo-bulb's width minus its negative margin, so 0% on
       this layer is the same point as 0% on the track above. */
    margin-left: 24px;
    height: 34px;
  }

  .thermo-tick {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .thermo-tick-mark {
    width: 2px;
    height: 9px;
    background: var(--accent);
    border-radius: 1px;
  }

  .thermo-tick-label {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  /* One line, one font — body font throughout, with just the numbers
     picked out in pink. Deliberately NOT the heading font: mixing the
