    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--ink);
  }

  .photo-strip-title :global(strong) {
    font-weight: 700;
  }

  @media (max-width: 640px) {
