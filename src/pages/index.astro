  @media (min-width: 720px) {
    :root {
      --home-pad: 6rem;
    }
  }
  .section {
    padding-block: var(--home-pad);
  }
  .hero :global(.promo-banner) {
    margin-top: var(--home-pad);
  }
  .photo-strip-wrap {
    margin-top: var(--home-pad);
  }

