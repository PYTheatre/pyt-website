---
/*
  AUDITION PAGE  ( /audition )

  A single front door for anyone looking to audition with PYT. It pulls
  together three audition routes that otherwise live in different places:

    1. Mainstage shows that currently have OPEN auditions — listed with
       their Active.com sign-up links. This reuses the exact same
       "is this audition still open?" logic as the Shows list page
       (/shows), so a show drops off this page automatically once its
       audition end date passes. No manual upkeep needed.
    2. Stories on Stage — a separate season cast from one annual audition,
       so it doesn't carry per-show audition dates. It gets its own panel
       pointing to /stories-on-stage.
    3. A casting-philosophy panel pointing to the Casting page (/casting).

  Plus a CMS-editable FAQ section at the bottom.

  CONTENT: all copy is editable via the "Audition Page" CMS record
  (src/content/settings/audition-page.json). Every field has a sensible
  fallback so the page renders correctly BEFORE staff touch it — including
  the empty-FAQ case (the FAQ section hides itself when the list is empty).
  The show LIST itself is not CMS content here; it is read live from the
  shows collection, the same source the Shows page uses.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { renderMarkdown } from "../lib/markdown";
import { productionTypeLabel } from "../lib/showLabels";
import { getCollection } from "astro:content";
import page from "../content/settings/audition-page.json";

// Load all shows, sort by start date (earliest first), same as /shows.
const shows = (await getCollection("shows")).sort(
  (a, b) => a.data.start_date.getTime() - b.data.start_date.getTime()
);

const now = new Date();

// Keep only shows whose auditions are still open AND have a sign-up link.
// A show is listed here if it has an UPCOMING audition date — whether or
// not a registration link exists yet. Shows without a date, or whose
// audition date has already passed, drop off automatically. The button
// below is smart: real sign-up link if present, "Registration coming
// soon" if the date is set but no link yet.
const openAuditions = shows.filter((show) => {
  const auditionEnd = show.data.audition_end ?? show.data.audition_date;
  if (!auditionEnd) return false; // no date = nothing to show
  return auditionEnd.getTime() >= now.getTime();
});

// --- Content fallbacks (page renders fully even with an empty CMS record) ---
// Hero eyebrow removed 2026-08-20: the field was blank in the CMS and the
// redesign drops it, but the old `?? "Get involved"` fallback meant
// deleting the field would have made that text REAPPEAR rather than go
// away. No eyebrow is passed to PageHero at all now.
const title = page.title?.trim() || "Auditions";
// The intro is a CMS Markdown field (2026-08-20) so staff can put links
// inside it — most importantly the link to the casting philosophy page,
// which replaced the separate callout box that used to sit at the
// bottom of this page. Rendered to HTML here and passed to PageHero as
// `ledeHtml`; links are styled pink there.
const intro =
  page.intro?.trim() ||
  "We'd love to see you audition. Below are the shows currently casting, plus how auditions work for Stories on Stage. New to PYT? Everyone is welcome — no experience required.";
const introHtml = renderMarkdown(intro);

const noOpenMessage =
  page.no_open_message?.trim() ||
  "There are no Center Stage Musicals auditions open right now. Check back soon, or explore Stories on Stage below.";

const sosHeading = page.sos_heading?.trim() || "Stories on Stage";
const sosBlurb =
  page.sos_blurb?.trim() ||
  "Our Stories on Stage season is cast from a single annual audition. Productions are short, often touring to local schools. Visit the Stories on Stage page for this year's audition details.";
const sosButtonLabel = page.sos_button_label?.trim() || "Auditions";

// --- Card button + link wording (2026-08-21) ---
// These were hardcoded in the markup, which is why they couldn't be
// found in the CMS — and why the Stories on Stage button was the only
// one anyone could change, leaving it SHOUTING while the others weren't.
const signUpLabel = page.signup_button_label?.trim() || "Sign up";
const comingSoonLabel = page.coming_soon_label?.trim() || "Coming soon";
const aboutShowLabel = page.about_show_link_label?.trim() || "About this show";

// Capitalization is a presentation choice, applied with CSS rather than
// by changing the stored text — so switching back to "As typed" restores
// exactly what was written, with nothing lost.
const buttonCase = page.button_case === "uppercase" ? "case-upper" : "";

// Coloured type tag, reusing the All Shows colours so the two pages
// agree. Keyed off the STORED production_type value, not the displayed
// label, so re-wording the label can't break the colour.
function typeTagClass(value: string | undefined): string {
  const v = (value || "").trim();
  if (v === "Studio Production") return "label-studio";
  if (v === "Musical") return "label-musical";
  return "label-other";
}

// NOTE (2026-08-20): the casting-philosophy callout box was removed
// entirely. The link to /casting now lives inside the intro paragraph
// above, written by staff in the CMS. Nothing here reads casting_* any
// more — those CMS fields were retired with it.

// Description line for a show's audition card. Uses the show's own
// CMS-written blurb when there is one; otherwise assembles a readable
// sentence from the data the show already has, so a card is never bare
// and the blurb field stays genuinely optional.
function auditionBlurb(data: any): string {
  const written = (data.audition_blurb || "").trim();
  if (written) return written;
  const bits: string[] = [];
  // NOTE (2026-08-21): the show TYPE is no longer folded into this
  // sentence — it's shown as a coloured tag above the title instead,
  // matching the All Shows page. Leaving it here too would say the same
  // thing twice.

  // Prefer the staff-written date text; fall back to formatting the real
  // audition date the show already has. Without this second step a show
  // with a date but no display text produced a one-fragment blurb like
  // "Center Stage Musical." — technically fine, but it read as an
  // unfinished sentence on the card.
  const displayDate = data.audition_display?.trim();
  const realDate = data.audition_start ?? data.audition_end ?? data.audition_date;
  if (displayDate) {
    bits.push(`Auditions: ${displayDate}`);
  } else if (realDate) {
    bits.push(
      `Auditions: ${new Date(realDate).toLocaleDateString("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
      })}`
    );
  }

  if (data.ages?.trim()) bits.push(data.ages.trim());
  // Join into sentences so it reads as prose rather than a data dump.
  return bits.length ? bits.join(". ") + "." : "";
}

const faqHeading = page.faq_heading?.trim() || "Frequently asked questions";

// FAQ list: tolerant of missing/empty. Drop any item missing a question or
// answer so one half-filled entry doesn't render a broken row.
const faqs = Array.isArray(page.faqs)
  ? page.faqs.filter((f) => f && f.question && f.answer)
  : [];
---

<BaseLayout
  title="Auditions — Peninsula Youth Theatre"
  description="Audition with Peninsula Youth Theatre. See which shows are currently casting, learn about Stories on Stage auditions, and read our casting philosophy."
>
  <PageHero title={title} ledeHtml={introHtml} />

  <!-- ===== Auditions + FAQs, side by side on wide screens =====
       Redesigned 2026-08-20. Previously these were four stacked
       full-width bands (shows, Stories on Stage, casting, FAQ), which
       made the FAQ easy to miss and gave the casting panel more visual
       weight than the auditions themselves. Now: every audition route
       (including Stories on Stage) is an identical card in one column,
       with the FAQ alongside it so both are visible without scrolling,
       and casting philosophy reduced to a slim link underneath. -->
  <section class="section auditions-main">
    <div class="container auditions-columns">

      <!-- --- Column 1: every audition route, one shared card style --- -->
      <div class="auditions-col">
        <h2 class="section-heading">{page.shows_heading?.trim() || "Upcoming auditions"}</h2>

        <ul class="audition-list">
          {openAuditions.map((show) => (
            <li class="audition-row">
              <div class="audition-card">
                {show.data.production_type && (
                  <span class={`type-label ${typeTagClass(show.data.production_type)}`}>
                    {productionTypeLabel(show.data.production_type)}
                  </span>
                )}
                <h3 class="audition-card-title">{show.data.title}</h3>
                {auditionBlurb(show.data) && (
                  <p class="audition-card-blurb">{auditionBlurb(show.data)}</p>
                )}
                <div class="audition-card-actions">
                  {show.data.audition_url ? (
                    <a
                      href={show.data.audition_url}
                      class={`btn btn-primary audition-btn ${buttonCase}`}
                      target="_blank"
                      rel="noopener"
                    >
                      {signUpLabel}
                    </a>
                  ) : (
                    <span class={`btn btn-outline btn-disabled audition-btn ${buttonCase}`} aria-disabled="true">
                      {comingSoonLabel}
                    </span>
                  )}
                  <a href={`/shows/${show.id}`} class="audition-link-cta">
                    {aboutShowLabel} →
                  </a>
                </div>
              </div>
            </li>
          ))}

          {/* Stories on Stage is an audition route too, so it's the same
              card as the shows above rather than a separate styled panel.
              Deliberately has NO coloured type tag (PM request 2026-08-21):
              its title already says "Stories on Stage", so a tag saying the
              same thing directly above it would just repeat itself. */}
          <li class="audition-row">
            <div class="audition-card">
              <h3 class="audition-card-title">{sosHeading}</h3>
              {sosBlurb && <p class="audition-card-blurb">{sosBlurb}</p>}
              <div class="audition-card-actions">
                <a href="/stories-on-stage" class={`btn btn-primary audition-btn ${buttonCase}`}>{sosButtonLabel}</a>
              </div>
            </div>
          </li>
        </ul>

        {openAuditions.length === 0 && noOpenMessage && (
          <p class="empty-state">{noOpenMessage}</p>
        )}
      </div>

      <!-- --- Column 2: FAQ, raised in priority (hidden when empty) --- -->
      {faqs.length > 0 && (
        <div class="faq-col">
          <h2 class="section-heading">{faqHeading}</h2>
          <div class="faq-list">
            {faqs.map((faq) => (
              <details class="faq-item">
                <summary>
                  <span class="faq-question">{faq.question}</span>
                  <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>


</BaseLayout>

<style>
  .btn-disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .section-heading {
    font-size: 1.5rem;
    margin-bottom: var(--space-lg);
  }

  /* ---- Two-column shell ---- */
  /* Mobile-first: one column, auditions then FAQ. The two-column split
     only kicks in when there's genuinely room for it (see the media
     query at the bottom) — forcing columns earlier squeezed both the
     card text and the FAQ questions onto too many lines. */
  .auditions-main {
    padding-bottom: var(--space-lg);
  }

  .auditions-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl) var(--space-xl);
    align-items: start;
  }

  /* ---- Audition cards (one shared style for every route) ---- */
  .audition-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .audition-row {
    margin: 0;
  }

  .audition-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    /* Generous, even padding on all four sides — the old card used a
       single --space-md all round with the button inline, which left the
       text feeling tight once the blurb ran to two or three lines. */
    padding: var(--space-lg);
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .audition-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-soft);
  }

  /* Coloured show-type tag (2026-08-21). Same shape and colours as the
     tags on the All Shows page, so the two pages describe a show the
     same way. Replaces the type being folded into the blurb sentence. */
  .type-label {
    display: inline-block;
    width: fit-content;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.18rem 0.5rem;
    border-radius: var(--radius-pill);
    margin-bottom: 0.5rem;
  }

  .label-musical {
    color: var(--accent-deep);
    background: var(--accent-soft);
  }

  .label-studio {
    color: #27500a;
    background: #eaf3de;
  }

  /* Fallback for any future production type that isn't one of the two
     above — a neutral tag rather than no tag at all. */
  .label-other {
    color: var(--ink);
    background: var(--neutral-soft);
  }

  /* Applied to the buttons when the CMS capitalization is set to
     UPPERCASE. Done in CSS, not by changing the stored text, so
     switching back to "As typed" restores exactly what was written. */
  .case-upper {
    text-transform: uppercase;
  }

  .audition-card-title {
    font-size: 1.25rem;
    line-height: 1.25;
    margin: 0 0 0.55rem;
  }

  .audition-card-blurb {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.55;
    max-width: 46ch;
  }

  /* Buttons sit UNDER the card text now (PM request: shorter buttons).
     A short button parked in a wide right-hand column looked stranded,
     and it also let the text column get narrow enough to wrap badly. */
  .audition-card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.1rem;
    margin-top: var(--space-md);
  }

  /* Short by design — sized to its label rather than stretching. */
  .audition-btn {
    padding: 0.6rem 1.4rem;
    font-size: 0.95rem;
  }

  .audition-link-cta {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .audition-link-cta:hover {
    text-decoration: underline;
  }

  .empty-state {
    margin-top: var(--space-md);
    padding: var(--space-lg);
    text-align: center;
    color: var(--ink-soft);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
  }

  /* ---- FAQ ---- */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .faq-item {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    overflow: hidden;
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 0.95rem var(--space-md);
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.35;
    list-style: none;
  }

  /* Remove the default disclosure triangle across browsers */
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-question {
    flex: 1;
  }

  /* Plus/minus icon drawn with CSS so we don't depend on an icon font */
  .faq-icon {
    position: relative;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    background: var(--accent);
    border-radius: 2px;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  .faq-icon::before {
    top: 6px;
    left: 0;
    width: 14px;
    height: 2px;
  }
  .faq-icon::after {
    top: 0;
    left: 6px;
    width: 2px;
    height: 14px;
  }
  .faq-item[open] .faq-icon::after {
    transform: rotate(90deg);
    opacity: 0;
  }

  .faq-answer {
    padding: 0 var(--space-md) var(--space-md);
  }

  .faq-answer p {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  /* ---- Wider screens: auditions and FAQ side by side ---- */
  /* 960px, not the site's usual 720px: at 720 the two columns were only
     ~330px each, which wrapped card titles awkwardly and pushed most FAQ
     questions onto two lines. Below this the single-column stack reads
     better than a cramped split. */
  @media (min-width: 960px) {
    .auditions-columns {
      /* Auditions slightly wider than the FAQ — the cards carry more
         text per row, and it keeps the button + link on one line. */
      grid-template-columns: 1.05fr 1fr;
    }
  }
</style>
