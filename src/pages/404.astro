---
/*
  404 PAGE  — added 2026-09-23 for launch.

  Cloudflare Pages serves this file (built to /404.html) for any address
  that doesn't exist, in place of its own bare error screen. Kept simple:
  a heading, one line, and the places people most often want. Marked
  noindex so search engines never list it.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — Peninsula Youth Theatre" noindex={true}>
  <section class="section">
    <div class="container not-found">
      <h1>We can't find that page</h1>
      <p>
        The address may have changed when we moved to our new website, or
        there may be a typo in the link. Try one of these:
      </p>
      <ul class="not-found-links">
        <li><a href="/">Home</a></li>
        <li><a href="/shows">Shows &amp; tickets</a></li>
        <li><a href="/programs">Classes &amp; camps</a></li>
        <li><a href="/audition">Auditions</a></li>
        <li><a href="/contact">Contact us</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 60ch;
    padding-block: var(--space-xl);
  }
  .not-found p {
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }
  .not-found-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .not-found-links a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-btn);
    color: var(--ink);
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .not-found-links a:hover,
  .not-found-links a:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
</style>
