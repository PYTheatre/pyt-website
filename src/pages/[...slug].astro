---
/*
  STAFF-CREATED PAGES  ( /<slug> )

  Renders every entry in the "pages" collection, laid out exactly like
  the Casting page: title block, optional hero photo, rich-text body,
  then an optional pull-quote and call-to-action.

  WHY A DYNAMIC ROUTE:
  Staff can add as many pages as they like from the CMS without anyone
  creating a file per page. Astro builds one real, static page per entry
  at build time, so these are as fast as the hand-built pages.

  SLUG = FILENAME. Creating "Summer Intensive" in the CMS produces
  summer-intensive.md and therefore /summer-intensive.

  DRAFTS are excluded from the build entirely, so a half-written page
  can sit in the CMS without appearing on the site or in the nav.

  CLASH SAFETY: Astro gives priority to a real file in src/pages/ over
  this catch-all, so a staff page accidentally named "about" cannot
  overwrite the hand-built About page — the hand-built one wins. The CMS
  hint warns against reusing an existing address for that reason.
*/
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeroImage from "../components/PageHeroImage.astro";
import { renderMarkdown } from "../lib/markdown";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages
    .filter((p) => !p.data.draft)
    .map((page) => ({
      params: { slug: page.id },
      props: { page },
    }));
}

const { page } = Astro.props;
const { title, intro, closing_quote, cta_label, cta_url, hero_image, hero_focus, hero_alt } = page.data;
const bodyHtml = renderMarkdown(page.body || "");
---

<BaseLayout
  title={`${title} — Peninsula Youth Theatre`}
  description={intro || `${title} at Peninsula Youth Theatre`}
>
  <section class="page-title">
    <div class="container">
      {intro && <p class="page-intro">{intro}</p>}
      <h1>{title}</h1>
    </div>
  </section>

  {/* Optional hero photo, set on the page itself (see the Photo field
      in the CMS). Falls back to the Page Hero Images list if a row
      happens to exist for this address. */}
  <PageHeroImage image={hero_image} focus={hero_focus} alt={hero_alt} />

  <section class="section page-body">
    <div class="container page-prose" set:html={bodyHtml} />
  </section>

  {closing_quote && (
    <section class="page-quote-section">
      <div class="container">
        <blockquote class="page-quote">
          <p>{closing_quote}</p>
        </blockquote>
      </div>
    </section>
  )}

  {cta_label && cta_url && (
    <section class="page-cta-section">
      <div class="container">
        <a href={cta_url} class="btn btn-primary">{cta_label}</a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Mirrors the Casting page's layout so staff-made pages sit alongside
     the hand-built ones without looking like a different website. */
  .page-title {
    /* Bottom padding matches .page-hero in PageHero.astro
       (--space-lg). It was 0, which jammed the hero photo directly
       against the heading with no gap at all — visibly different from
       every page that uses the shared PageHero component. Keep these
       two values in step: this block exists to imitate that component,
       so if its spacing changes, change this too. */
    padding-block: var(--page-top) var(--hero-gap);   /* same as PageHero — VERTICAL RHYTHM, tokens.css */
  }

  .page-title h1 {
    margin-top: 0.5rem;
  }

  .page-intro {
    font-size: 1.08rem;
    color: var(--ink-soft);
    max-width: 62ch;
    margin: 0;
  }

  /* .page-body now takes the standard .section padding (VERTICAL RHYTHM,
     tokens.css) — its own override made the page end ~120px above the
     footer instead of the standard gap. */

  /* LEFT-ALIGNED READING WIDTH (2026-09-21). The width limit is on the
     CHILDREN, not this box. This box is also a .container, and
     .container centres itself — so limiting ITS width used to push the
     whole column into the middle of the page while the title, photo and
     buttons stayed on the left edge. Now everything shares one edge. */
  .page-prose > :global(*) {
    max-width: 68ch;
  }

  /* No stray margin under the last paragraph: the section padding
     already provides the gap. */
  .page-prose > :global(:last-child) {
    margin-bottom: 0;
  }

  /* The body is injected with set:html (rendered Markdown), so its
     elements don't carry Astro's scoped attribute — they have to be
     targeted with :global inside the scoped wrapper. */
  .page-prose :global(p) {
    font-size: 1.08rem;
    line-height: 1.75;
    margin-bottom: var(--space-md);
  }

  .page-prose :global(h2) {
    font-size: 1.5rem;
    margin: var(--space-lg) 0 var(--space-sm);
  }

  .page-prose :global(h3) {
    font-size: 1.2rem;
    margin: var(--space-md) 0 var(--space-xs);
  }

  .page-prose :global(strong) {
    font-weight: 700;
  }

  .page-prose :global(em) {
    font-style: italic;
  }

  .page-prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }

  .page-prose :global(ul),
  .page-prose :global(ol) {
    margin: var(--space-md) 0;
    padding-left: 1.4rem;
  }

  .page-prose :global(li) {
    font-size: 1.08rem;
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }

  .page-prose :global(blockquote) {
    margin: var(--space-md) 0;
    padding-left: var(--space-md);
    border-left: 3px solid var(--accent);
  }

  .page-prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .page-quote-section {
    padding-block: 0 var(--section-pad);
  }

  .page-quote {
    margin: 0;
    max-width: 62ch;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    line-height: 1.4;
    color: var(--accent);
  }

  .page-quote p {
    margin: 0;
  }

  /* Was 96px of bottom padding on its own (on top of the footer's
     margin): the reason these pages ended further from the footer than
     every other page. */
  .page-cta-section {
    padding-bottom: var(--section-pad);
  }
</style>
