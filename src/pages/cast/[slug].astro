---
/*
  CAST PAGE  ( /cast/<slug> )

  Dynamic page: Astro builds one page per file in
  src/content/cast-pages/. These pages are NOT in the site nav —
  staff share the URL directly with the cast (e.g. via newsletter).

  PASSWORD GATE — IMPORTANT, READ THIS:
  This is a SOFT, client-side gate. The page content is still
  delivered to the browser; the gate only hides it visually until
  the right password is typed. Anyone who knows how to view page
  source can bypass it. This is acceptable ONLY for non-sensitive
  info (role names, general rehearsal times, production notes). Do
  NOT put children's full names, addresses, medical info, or other
  sensitive data into content that gets EMBEDDED or typed on this
  page.

  TWO DIFFERENT TREATMENTS FOR THE TWO SHEETS:
  - Rehearsal schedule: EMBEDDED from a "Publish to web" link, which
    makes it PUBLIC. So it must be ROLE-NAMES-ONLY (e.g. "Jack,
    Crutchie, Newsies") and free of any child's name in the notes.
  - Cast list (full names → roles): EMBEDDED PRIVATELY since
    2026-09-21 (PM/team request), plus a button to open it in Google.
    ⚠️ THIS IS ONLY SAFE BECAUSE THE SHEET STAYS PRIVATE IN GOOGLE
    ("Restricted", shared with specific cast-family accounts). The
    embed points at the private sheet; Google itself decides, per
    viewer, whether to show it — signed-in people it is shared with see
    the list, everyone else sees Google's "you need access" box. The
    names are never delivered into this page's source.
    NEVER "Publish to web" the cast list to make the embed "work":
    that makes a roster of named children public. As a guard, the code
    below REFUSES to embed a published link (…/d/e/…, /pubhtml) for the
    cast list and shows only the button.
    KNOWN LIMITATION: Safari (all iPhones) and Firefox block Google's
    sign-in inside another site's frame, so even correctly-shared
    families may see a sign-in box there. That is why the "Open in
    Google" button stays directly under the embed.
*/
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const pages = await getCollection("castPages");
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const data = page.data;

// Convert a Google Sheets share URL into an embeddable /preview URL.
// Used ONLY for the rehearsal schedule (role-names-only).
function toSheetEmbed(url: string | undefined): string {
  if (!url) return "";
  const trimmed = url.trim();
  if (trimmed.includes("/pubhtml") || trimmed.includes("/preview")) return trimmed;
  const m = trimmed.match(/\/spreadsheets\/d\/([a-zA-Z0-9-_]+)/);
  if (m) {
    const gidMatch = trimmed.match(/[#&?]gid=([0-9]+)/);
    const gid = gidMatch ? `?gid=${gidMatch[1]}` : "";
    return `https://docs.google.com/spreadsheets/d/${m[1]}/preview${gid}`;
  }
  return trimmed;
}

const rehearsalEmbed = toSheetEmbed(data.rehearsal_sheet_url);
// Cast list: the button always uses the link as-is (opens in a new tab).
const castListLink = (data.cast_list_sheet_url || "").trim();
// …and it is ALSO embedded, but only if it is an ordinary PRIVATE sheet
// link. A "Publish to web" link (/d/e/… or /pubhtml) means someone has
// made the roster public — never embed that (see the file header).
const castListIsPublished = /\/spreadsheets\/d\/e\/|\/pubhtml/i.test(castListLink);
const castListEmbed = castListLink && !castListIsPublished ? toSheetEmbed(castListLink) : "";

// Resource links (Google Drive folders etc.) — keep only complete entries.
const resources = (data.resources || []).filter(
  (r) => r && r.label && r.url
);

// Split optional intro/body into paragraphs at blank lines.
const introParas = (data.intro || "").split("\n\n").filter((p) => p.trim().length > 0);
const bodyParas = (data.body || "").split("\n\n").filter((p) => p.trim().length > 0);
---

<BaseLayout
  title={`${data.show_title} — Cast Page — Peninsula Youth Theatre`}
  description="Cast information for Peninsula Youth Theatre."
>
  {/* ---- PASSWORD GATE (shown first; hidden once unlocked) ---- */}
  <section class="gate" id="cast-gate">
    <div class="container gate-inner">
      <h1>{data.show_title}</h1>
      <p class="gate-lede">This page is for the cast and their families. Please enter the password shared with you.</p>

      <form class="gate-form" id="gate-form" autocomplete="off">
        <label for="gate-input" class="sr-only">Password</label>
        <input type="password" id="gate-input" placeholder="Password" />
        <button type="submit" class="btn btn-primary">View page</button>
      </form>
      <p class="gate-error" id="gate-error" hidden>That password didn't match. Please try again.</p>
    </div>
  </section>

  {/* ---- PROTECTED CONTENT (hidden until unlocked) ---- */}
  <div id="cast-content" hidden>
    <section class="section cast-head">
      <div class="container">
        <h1>{data.show_title}</h1>
        {introParas.length > 0 && (
          <div class="cast-intro">
            {introParas.map((p) => <p>{p}</p>)}
          </div>
        )}
      </div>
    </section>

    {/* Rehearsal resources come FIRST, straight after the intro
        (PM request, 2026-09-21) — they were at the bottom. */}
    {resources.length > 0 && (
      <section class="section sheet-section">
        <div class="container">
          <h2 class="section-head">Rehearsal resources</h2>
          <p class="sheet-note">Materials for the cast — opens in a new tab. You may need to be signed in to the right Google account to view some of these.</p>
          <div class="resource-buttons">
            {resources.map((r) => (
              <a href={r.url} class="btn btn-outline" target="_blank" rel="noopener">{r.label}</a>
            ))}
          </div>
        </div>
      </section>
    )}

    {castListLink && (
      <section class="section sheet-section">
        <div class="container">
          <h2 class="section-head">Cast list</h2>
          <p class="sheet-note">The cast list is private. It shows below if you're signed in to Google with an account it's been shared with. If the box asks you to sign in or stays blank, open it in Google instead.</p>
        </div>
        {castListEmbed && (
          <div class="sheet-wide">
            <div class="sheet-frame">
              <iframe src={castListEmbed} title="Cast list" loading="lazy"></iframe>
            </div>
          </div>
        )}
        <div class="container">
          <a href={castListLink} class={`btn ${castListEmbed ? "btn-outline sheet-open-btn" : "btn-primary"}`} target="_blank" rel="noopener">Open the cast list in Google →</a>
        </div>
      </section>
    )}

    {rehearsalEmbed && (
      <section class="section sheet-section">
        <div class="container">
          <h2 class="section-head">Rehearsal schedule</h2>
          <p class="sheet-note">This schedule is updated through the run — check back for the latest.</p>
        </div>
        <div class="sheet-wide">
          <div class="sheet-frame">
            <iframe src={rehearsalEmbed} title="Rehearsal schedule" loading="lazy"></iframe>
          </div>
        </div>
      </section>
    )}

    {bodyParas.length > 0 && (
      <section class="section cast-body-section">
        <div class="container cast-body">
          {bodyParas.map((p) => <p>{p}</p>)}
        </div>
      </section>
    )}
  </div>

  {/*
    The password is embedded here for the client-side check. This is
    intentionally a SOFT gate (see file header). Not real security.
  */}
  <script type="application/json" id="cast-pw" set:html={JSON.stringify({ p: data.password })}></script>

  <script is:inline>
    (function () {
      const gate = document.getElementById("cast-gate");
      const content = document.getElementById("cast-content");
      const form = document.getElementById("gate-form");
      const input = document.getElementById("gate-input");
      const errorMsg = document.getElementById("gate-error");
      const pw = JSON.parse(document.getElementById("cast-pw").textContent).p;

      // Remember unlock for this page within the browser session, so a
      // refresh doesn't force re-entry.
      const key = "cast-unlocked:" + location.pathname;

      function unlock() {
        gate.hidden = true;
        content.hidden = false;
      }

      try {
        if (sessionStorage.getItem(key) === "1") unlock();
      } catch (e) { /* sessionStorage may be unavailable; ignore */ }

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        if (input.value === pw) {
          try { sessionStorage.setItem(key, "1"); } catch (e) {}
          errorMsg.hidden = true;
          unlock();
        } else {
          errorMsg.hidden = false;
          input.value = "";
          input.focus();
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  /* ---- Password gate ---- */
  .gate {
    padding-block: var(--space-2xl);
  }

  .gate-inner {
    max-width: 460px;
  }

  .gate-inner h1 {
    margin-block: 0.5rem var(--space-md);
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }

  .gate-lede {
    margin-bottom: var(--space-lg);
    color: var(--ink-soft);
  }

  .gate-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .gate-form input {
    flex: 1;
    min-width: 200px;
    padding: 0.65rem 0.9rem;
    border: 1.5px solid var(--line);
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 1rem;
    -webkit-appearance: none;
    appearance: none;
  }

  .gate-form input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .gate-error {
    margin-top: var(--space-sm);
    color: var(--accent-deep);
    font-size: 0.92rem;
  }

  /* ---- Protected content ---- */
  .cast-head {
    padding-bottom: var(--space-md);
  }

  .cast-head h1 {
    margin-block: 0.5rem var(--space-md);
  }

  .cast-intro p {
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: var(--space-sm);
    max-width: 64ch;
  }

  .sheet-section {
    padding-block: var(--space-md) var(--space-lg);
  }

  .section-head {
    margin-bottom: var(--space-sm);
  }

  .sheet-note {
    font-size: 0.92rem;
    color: var(--ink-muted);
    margin-bottom: var(--space-md);
  }

  /* Responsive sheet frame */
  /* WIDE FRAMES (2026-09-21): the Google Sheet embeds break out of the
     text column so wide schedules don't run off the right edge. Up to
     1600px wide, centred, with the same side gutters as .container; the
     heading and note above stay in the normal column. Google decides
     the sheet's own column widths — if a sheet is still wider than
     this, the frame scrolls sideways inside itself, never the page. */
  .sheet-wide {
    width: 100%;
    max-width: 1600px;
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  @media (min-width: 720px) {
    .sheet-wide {
      padding-inline: var(--space-lg);
    }
  }

  .sheet-open-btn {
    margin-top: var(--space-sm);
  }

  .sheet-frame {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-warm);
  }

  .sheet-frame iframe {
    width: 100%;
    height: 480px;
    border: 0;
    display: block;
  }

  .resource-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .cast-body p {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: var(--space-sm);
    max-width: 64ch;
  }

  @media (min-width: 720px) {
    .sheet-frame iframe {
      height: 560px;
    }
  }
</style>
